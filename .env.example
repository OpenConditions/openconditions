# OpenConditions ingest — environment configuration
#
# Copy to `.env` and fill in. Every feed below is credential-gated: the
# scheduler skips a feed until all of its variables are set, so you only need the
# ones for the sources you want live. See docs/feed-credentials.md for how to
# obtain each key and any access conditions.

# --- Service ---------------------------------------------------------------

# PostgreSQL/PostGIS connection (REQUIRED — the service refuses to start without it)
DATABASE_URL=postgres://openconditions:openconditions@localhost:5432/openconditions

# HTTP server (optional; defaults shown)
PORT=4100
HOST=0.0.0.0

# Rate limiting (optional; defaults shown)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Operator token (optional, at least 32 characters). A request with
# `Authorization: Bearer <token>` reads in the operator scope: restricted sources
# and licences that are not public included, no rate limit. Unset = public only.
OPENCONDITIONS_OPERATOR_TOKEN=

# How long a bbox read waits for the on-demand sources it fetches, in
# milliseconds (optional; default 3000). A fetch still running then goes on and
# lands for the next read; the response reports the source as `deadline`.
OPENCONDITIONS_ON_DEMAND_DEADLINE_MS=

# Immediate reverse-proxy address ranges to trust for client IPs (optional).
# Only one proxy hop is accepted. Defaults cover local and container networks.
TRUST_PROXY_CIDRS=loopback,linklocal,uniquelocal

# OpenLR map-match resolver service URL (optional). If unset, observations that
# carry only OpenLR (no coordinates) are dropped rather than resolved.
OPENLR_RESOLVER_URL=

# Road graph coverage: one JSON array used by import, binding and profiles.
# Unset/[] imports no regions. Configure explicitly before enabling route effects.
# See docs/graph-binding.md for the schema and a Germany motorway example.
SEGMENT_REGIONS=[]

# Egress guard caps applied to every feed fetch (optional; defaults shown)
OPENCONDITIONS_MAX_FEED_BYTES=268435456
OPENCONDITIONS_FETCH_TIMEOUT_MS=60000
OPENCONDITIONS_MAX_REDIRECTS=5

# Static archive (nightly GeoParquet published-view snapshot). The build writes a
# dated `archive-<class>-YYYY-MM-DD.parquet` per record class of the
# redistributable published view and points `archive-<class>.parquet` at it (see
# docs/archive.md). Local filesystem only — object-storage/S3 upload is operator
# infra, not wired here.
# Output directory (optional; default ./data/archive).
OPENCONDITIONS_ARCHIVE_DIR=
# Nights of dated files to keep (optional; default 30; 0 keeps every night).
OPENCONDITIONS_ARCHIVE_KEEP_NIGHTS=
# Cron for the nightly build (optional; default "30 3 * * *"; set "off" to disable).
ARCHIVE_CRON=

# Layered feed delivery (optional). Feeds load at boot from baked-in defaults +
# an operator-mounted directory + an optional (default-off) remote bundle,
# merged by feed id with precedence mounted > remote > baked-in.
#
# Directory laid out like the baked catalogue (<domain>/<region>.jsonc, optional
# credentials.jsonc) whose feeds add to or override baked-in ones by id, no
# rebuild. Unset = baked-in feeds only.
OPENCONDITIONS_FEEDS_DIR=
# URL of a remote feed bundle (e.g. a published atlas/<domain>.json). Only used
# when remote-pull is enabled below.
OPENCONDITIONS_FEEDS_REMOTE_URL=
# "true" opts into remote-pull (default off). The bundle is checked like the
# baked catalogue and URL-guarded; a snapshot is kept under the state dir
# (${OPENCONDITIONS_STATE_DIR:-/data}/feeds) so the instance survives the remote
# being down.
OPENCONDITIONS_FEEDS_REMOTE_ENABLED=

# === Feed credentials — generated by `pnpm gen:credentials`; do not edit below this line ===

# Shared: au-vic-transportvic (au-vic-vicroads-flow, au-vic-transportvic-planned-events, au-vic-transportvic-unplanned-events)
# Transport Victoria Open Data Portal: https://opendata.transport.vic.gov.au/
# CC-BY-4.0 (Freeway Travel Time — NOT the CC-BY-NC Bluetooth feed); attribution "Department of Transport and Planning (Victoria)". Rate limit 5 req/min.
AU_VIC_TRANSPORTVIC_API_KEY=

# Shared: mobilithek (de-nw-verkehr-events, de-nw-duesseldorf-events, de-nw-koeln-events, de-nw-unna-events, de-nw-mobidrom-events, de-by-mobilithek-events, de-bw-mobilithek-events, de-be-mobilithek-events, de-bb-mobilithek-events, de-hb-mobilithek-events, de-hh-mobilithek-events, de-he-mobilithek-events, de-mv-mobilithek-events, de-ni-nlstbv-events, de-ni-hannover-events, de-sn-mobilithek-events, de-st-mobilithek-events, de-sh-mobilithek-events, de-th-mobilithek-events, de-hh-autobahn-flow, de-nw-autobahn-flow, de-he-autobahn-flow, de-bw-autobahn-flow, de-by-autobahn-flow, de-nw-autobahn-los-flow, de-bw-autobahn-los-flow)
# Mobilithek registration: https://mobilithek.info/registration-request
# This ONE certificate authenticates every Mobilithek feed — set it once, then add each feed's subscription id. (The NRW state network is published under 'LVZ.NRW', not 'Straßen.NRW'.)
MOBILITHEK_CERT=
MOBILITHEK_KEY=

# Shared: hr-hc (hr-hc-roadworks-events, hr-hc-events)
# Hrvatske ceste: https://www.hrvatske-ceste.hr/
# Open licence (commercial OK); access is gated on the B2B account.
HR_HC_USER=
HR_HC_PASSWORD=

# Shared: no-vegvesen (no-vegvesen-events, no-vegvesen-flow)
# Statens vegvesen — get DATEX access: https://www.vegvesen.no/en/fag/technology/open-data/a-selection-of-open-data/what-is-datex/get-access/
# NLOD-2.0 (commercial OK). One account serves the events and the traffic-speed feeds.
NO_VEGVESEN_USER=
NO_VEGVESEN_PASSWORD=

# Shared: se-trafikverket (se-trafikverket-events, se-trafikverket-flow)
# Sign up at Trafikverket: https://data.trafikverket.se/oauth2/Account/register
# CC0 — no restrictions. API endpoint: api.trafikinfo.trafikverket.se/v2/data.json (the bare host has no web page).
SE_TRAFIKVERKET_API_KEY=

# Shared: sg-lta (sg-lta-events, sg-lta-flow)
# Request LTA API access: https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
# Singapore ODL (commercial OK); attribution to the Land Transport Authority. Serves the Traffic Incidents and Traffic Speed Bands feeds.
SG_LTA_API_KEY=

# Shared: us-ny-511 (us-ny-511-events, us-ny-511-conditions)
# Create a 511NY account: https://511ny.org/my511/register
# Attribution required: "Powered by 511NY". 10 calls per 60s across the account, shared by both feeds.
US_NY_511_API_KEY=

# Shared: us-oh-ohgo (us-oh-ohgo-flow, us-oh-ohgo-construction-events, us-oh-ohgo-events)
# OHGO developer registration: https://ohgo.com/developer
# Free key. Data is U.S. government public domain. Serves the travel delays, construction and incidents feeds.
US_OH_OHGO_API_KEY=

# Shared: overpass (osm-fuel, osm-parking, osm-import, osm-maxspeed)
# Default: https://overpass-api.de
OVERPASS_URL=

# Buenos Aires road closures (cortes) (ar-ba-cortes-events)
# BA transport API registration: https://api-transporte.buenosaires.gob.ar/registro
# CC-BY-2.5-AR (commercial OK).
AR_BA_CORTES_EVENTS_CLIENT_ID=
AR_BA_CORTES_EVENTS_CLIENT_SECRET=

# ASFINAG events (Austria) (at-asfinag-events)
# ASFINAG content portal: https://contentportal.asfinag.at/
# CC-BY-4.0 for the two open event packages (some ASFINAG packages are paid).
AT_ASFINAG_EVENTS_USER=
AT_ASFINAG_EVENTS_PASSWORD=

# Live Traffic NSW (New South Wales) (au-nsw-livetraffic-events)
# Register at Transport NSW Open Data: https://opendata.transport.nsw.gov.au/data/user/register
# CC-BY-4.0; attribution "Transport for NSW".
AU_NSW_LIVETRAFFIC_EVENTS_API_KEY=

# QLDTraffic (Queensland) (au-qld-traffic-events)
# QLDTraffic: https://www.qldtraffic.qld.gov.au/
# Optional — the bundled public key is shared + rate-limited (100 req/min). Set your own to avoid 429s.
# Default: 3e83add325cbb69ac4d8e5bf433d770b
AU_QLD_TRAFFIC_EVENTS_API_KEY=

# LVZ.NRW (Nordrhein-Westfalen) via Mobilithek (de-nw-verkehr-events)
DE_NW_VERKEHR_EVENTS_SUBSCRIPTION_ID=

# Düsseldorf (dmotion) via Mobilithek (de-nw-duesseldorf-events)
DE_NW_DUESSELDORF_EVENTS_SUBSCRIPTION_ID=

# Köln via Mobilithek (de-nw-koeln-events)
DE_NW_KOELN_EVENTS_SUBSCRIPTION_ID=

# Kreis Unna via Mobilithek (de-nw-unna-events)
DE_NW_UNNA_EVENTS_SUBSCRIPTION_ID=

# NRW.Mobidrom bundled roadworks via Mobilithek (de-nw-mobidrom-events)
DE_NW_MOBIDROM_EVENTS_SUBSCRIPTION_ID=

# Bayern via Mobilithek (de-by-mobilithek-events)
DE_BY_MOBILITHEK_EVENTS_SUBSCRIPTION_ID=

# Baden-Württemberg via Mobilithek (de-bw-mobilithek-events)
DE_BW_MOBILITHEK_EVENTS_SUBSCRIPTION_ID=

# Berlin via Mobilithek (de-be-mobilithek-events)
DE_BE_MOBILITHEK_EVENTS_SUBSCRIPTION_ID=

# Brandenburg via Mobilithek (de-bb-mobilithek-events)
DE_BB_MOBILITHEK_EVENTS_SUBSCRIPTION_ID=

# Bremen via Mobilithek (de-hb-mobilithek-events)
DE_HB_MOBILITHEK_EVENTS_SUBSCRIPTION_ID=

# Hamburg via Mobilithek (de-hh-mobilithek-events)
DE_HH_MOBILITHEK_EVENTS_SUBSCRIPTION_ID=

# Hessen via Mobilithek (de-he-mobilithek-events)
DE_HE_MOBILITHEK_EVENTS_SUBSCRIPTION_ID=

# Mecklenburg-Vorpommern via Mobilithek (de-mv-mobilithek-events)
DE_MV_MOBILITHEK_EVENTS_SUBSCRIPTION_ID=

# NLStBV (Niedersachsen) via Mobilithek (de-ni-nlstbv-events)
DE_NI_NLSTBV_EVENTS_SUBSCRIPTION_ID=

# Hannover via Mobilithek (de-ni-hannover-events)
DE_NI_HANNOVER_EVENTS_SUBSCRIPTION_ID=

# Sachsen via Mobilithek (de-sn-mobilithek-events)
DE_SN_MOBILITHEK_EVENTS_SUBSCRIPTION_ID=

# Sachsen-Anhalt via Mobilithek (de-st-mobilithek-events)
DE_ST_MOBILITHEK_EVENTS_SUBSCRIPTION_ID=

# Schleswig-Holstein via Mobilithek (de-sh-mobilithek-events)
DE_SH_MOBILITHEK_EVENTS_SUBSCRIPTION_ID=

# Thüringen via Mobilithek (de-th-mobilithek-events)
DE_TH_MOBILITHEK_EVENTS_SUBSCRIPTION_ID=

# Autobahn GmbH BAB traffic data (NL Nord: Hamburg & Schleswig-Holstein) (de-hh-autobahn-flow)
DE_HH_AUTOBAHN_FLOW_SUBSCRIPTION_ID=
DE_HH_AUTOBAHN_FLOW_SITES_SUBSCRIPTION_ID=

# Autobahn GmbH BAB traffic data (Nordrhein-Westfalen, per lane) (de-nw-autobahn-flow)
DE_NW_AUTOBAHN_FLOW_SUBSCRIPTION_ID=
DE_NW_AUTOBAHN_FLOW_SITES_SUBSCRIPTION_ID=

# Autobahn GmbH BAB traffic data (VZD, Hessen) (de-he-autobahn-flow)
DE_HE_AUTOBAHN_FLOW_SUBSCRIPTION_ID=
DE_HE_AUTOBAHN_FLOW_SITES_SUBSCRIPTION_ID=

# Autobahn GmbH BAB traffic data (NL Südwest, Baden-Württemberg) (de-bw-autobahn-flow)
DE_BW_AUTOBAHN_FLOW_SUBSCRIPTION_ID=
DE_BW_AUTOBAHN_FLOW_SITES_SUBSCRIPTION_ID=

# Autobahn GmbH BAB traffic data (Bayern, per lane) (de-by-autobahn-flow)
DE_BY_AUTOBAHN_FLOW_SUBSCRIPTION_ID=

# Autobahn GmbH BAB Verkehrslage LoS (Nordrhein-Westfalen, per lane) (de-nw-autobahn-los-flow)
DE_NW_AUTOBAHN_LOS_FLOW_SUBSCRIPTION_ID=
DE_NW_AUTOBAHN_LOS_FLOW_SITES_SUBSCRIPTION_ID=

# Autobahn GmbH BAB Verkehrslage LoS (NL Südwest, Baden-Württemberg) (de-bw-autobahn-los-flow)
DE_BW_AUTOBAHN_LOS_FLOW_SUBSCRIPTION_ID=
DE_BW_AUTOBAHN_LOS_FLOW_SITES_SUBSCRIPTION_ID=

# Vejdirektoratet (Denmark) (dk-vejdirektoratet-events)
# Danish data exchanger — dataset 416: https://du-portal-ui.dataudveksler.app.vd.dk/data/416/overview
# CC-BY-4.0; attribution "Vejdirektoratet." Access is via a service account, not a plain API key — confirm from the dataset page whether its credential is a header/query token or an OAuth2 client-credentials pair.
DK_VEJDIREKTORATET_EVENTS_API_KEY=

# Tark Tee (Estonia) (ee-tarktee-events)
# Register at Tark Tee: https://tarktee.transpordiamet.ee/#/en/datex-registration
# CC-BY-4.0 (commercial OK).
EE_TARKTEE_EVENTS_API_KEY=

# National Highways NTIS (England) (gb-nationalhighways-events)
# National Highways developer portal: https://developer.data.nationalhighways.co.uk/signin
# OGL-UK-3.0; attribution "Contains National Highways data © Crown copyright and database right."
GB_NATIONALHIGHWAYS_EVENTS_API_KEY=

# NAP Slovenia (promet.si) (si-nap-events)
# Register at NAP Slovenia: https://www.nap.si/en/registration
# CC-BY-SA (ShareAlike). The B2B host (b2b.ncup.si) is credential-gated; the NAP account is sent as HTTP Basic — confirm the exact scheme when granted.
SI_NAP_EVENTS_USER=
SI_NAP_EVENTS_PASSWORD=

# Tankerkönig fuel prices (Germany) (de-tankerkoenig-fuel)
# Request Tankerkönig API key: https://onboarding.tankerkoenig.de/
# Data is CC BY 4.0 (MTS-K) — attribution required. Free-tier limits: 1 request/min, 25 km radius.
DE_TANKERKOENIG_FUEL_API_KEY=

# Transport for NSW Park&Ride (au-nsw-tfnsw-parking)
# Get API key: https://opendata.transport.nsw.gov.au/
# Transport for NSW (Australia). The Car Park API provides real-time Park&Ride / Sydney Metro car-park occupancy.
AU_NSW_TFNSW_PARKING_API_KEY=

# DB BahnPark station parking (de-db-bahnpark-parking)
# Open DB API Marketplace: https://developers.deutschebahn.com/db-api-marketplace/apis/product/parking-information-db-bahnpark
# Provides ~315 DB BahnPark facilities. The higher transit-authority plan needs a separate data agreement.
DE_DB_BAHNPARK_PARKING_CLIENT_ID=
DE_DB_BAHNPARK_PARKING_API_KEY=

# North East Travel Data car parks (gb-eng-netraveldata-parking)
# Register for NE Travel Data: https://www.netraveldata.co.uk/?page_id=9
# This is the Newcastle / Tyne & Wear (UTMC) feed at netraveldata.co.uk — not a Glasgow contact. The website login you create is the API credential.
GB_ENG_NETRAVELDATA_PARKING_USERNAME=
GB_ENG_NETRAVELDATA_PARKING_PASSWORD=
