{
  "name": "@openconditions/contributions-api",
  "version": "0.1.0",
  "description": "OpenConditions contributions service — crowd report intake and evidence-state recompute",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "exports": {
    "./federation/inbox": {
      "types": "./dist/federation/inbox.d.ts",
      "import": "./dist/federation/inbox.js"
    },
    "./contrib": {
      "types": "./dist/contrib.d.ts",
      "import": "./dist/contrib.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@cloudflare/privacypass-ts": "0.9.0",
    "@openconditions/contrib-core": "workspace:*",
    "@openconditions/core": "workspace:*",
    "@openconditions/federation": "workspace:*",
    "@openconditions/ingest-framework": "workspace:*",
    "@openconditions/model": "workspace:*",
    "@openconditions/model-registry": "workspace:*",
    "@openconditions/storage": "workspace:*",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@openconditions/publishers": "workspace:*",
    "@openconditions/test-database": "workspace:*",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
