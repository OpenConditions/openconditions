{
  "name": "@openconditions/ingest",
  "version": "0.1.0",
  "description": "OpenConditions ingest service — fetch → parse → atomic PostGIS swap",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "exports": {
    "./pipeline/write-postgis": {
      "types": "./dist/pipeline/write-postgis.d.ts",
      "import": "./dist/pipeline/write-postgis.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/proxy-addr": "^5.1.0",
    "@openconditions/core": "workspace:*",
    "@openconditions/ingest-framework": "workspace:*",
    "@openconditions/normalize": "workspace:*",
    "@openconditions/openlr": "workspace:*",
    "@openconditions/publishers": "workspace:*",
    "@openconditions/roads": "workspace:*",
    "croner": "^10.0.1",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "hyparquet": "1.28.0",
    "testcontainers": "^12.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
