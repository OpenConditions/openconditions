{
  "name": "@openconditions/conformance",
  "version": "0.0.0",
  "description": "Test-only: the official schemas of the standards OpenConditions reads and writes, fetched pinned by SHA-256, and the checks that hold fixtures and mappings to them",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./standards/*": {
      "types": "./dist/standards/*.d.ts",
      "import": "./dist/standards/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.2",
    "fast-xml-parser": "^5.11.2",
    "xmllint-wasm": "^5.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
