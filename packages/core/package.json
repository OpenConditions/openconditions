{
  "name": "@openconditions/core",
  "version": "0.1.0",
  "description": "Generic two-axis canonical model, severity, and freshness helpers for OpenConditions",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js",
      "require": "./dist/credentials.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "drizzle",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "pnpm --filter @openconditions/model build && drizzle-kit generate"
  },
  "devDependencies": {
    "@openconditions/test-database": "workspace:*",
    "@types/geojson": "^7946.0.16",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@openconditions/model": "workspace:*",
    "@photostructure/tz-lookup": "^11.8.0",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "private": true
}
