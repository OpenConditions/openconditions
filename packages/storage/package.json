{
  "name": "@openconditions/storage",
  "version": "0.1.0",
  "description": "Persistence for OpenConditions records: the source catalogue, the record writer and the legacy observation projection",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openconditions/core": "workspace:*",
    "@openconditions/ingest-framework": "workspace:*",
    "@openconditions/model": "workspace:*",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@openconditions/charging": "workspace:*",
    "@openconditions/model-registry": "workspace:*",
    "testcontainers": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
