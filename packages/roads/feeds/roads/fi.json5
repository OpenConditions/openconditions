[
  {
    operator: "digitraffic",
    name: "Digitraffic (Finland)",
    format: "digitraffic",
    url: [
      "https://tie.digitraffic.fi/api/traffic-message/v1/messages?inactiveHours=0&includeAreaGeometry=false&situationType=TRAFFIC_ANNOUNCEMENT",
      "https://tie.digitraffic.fi/api/traffic-message/v1/messages?inactiveHours=0&includeAreaGeometry=false&situationType=ROAD_WORK",
      "https://tie.digitraffic.fi/api/traffic-message/v1/messages?inactiveHours=0&includeAreaGeometry=false&situationType=WEIGHT_RESTRICTION",
      // Exempted transports are located by municipality, not road address, so
      // this is the one family that needs the area geometry — requested without
      // it, every record arrives geometry-less and is dropped.
      "https://tie.digitraffic.fi/api/traffic-message/v1/messages?inactiveHours=0&includeAreaGeometry=true&situationType=EXEMPTED_TRANSPORT",
    ],
    cadenceSec: 120,
    freshnessWindowSec: 600,
    license: "CC-BY-4.0",
    attribution: "Fintraffic / Digitraffic",
    country: "FI",
    privacyUrl: "https://www.fintraffic.fi/en/fintraffic/data-protection",
  },
  {
    operator: "fintraffic",
    name: "Fintraffic TMS traffic speed (Finland)",
    format: "fintraffic-tms",
    produces: "flow",
    url: "https://tie.digitraffic.fi/api/tms/v1/stations/data",
    requestHeaders: { "Digitraffic-User": "OpenConditions/1.0" },
    stationRegistry: {
      url: "https://tie.digitraffic.fi/api/tms/v1/stations",
      format: "fintraffic-stations",
    },
    cadenceSec: 300,
    freshnessWindowSec: 900,
    license: "CC-BY-4.0",
    licenseUrl: "https://www.fintraffic.fi/en/fintraffic/open-data",
    attribution: "Fintraffic / Digitraffic",
    country: "FI",
    privacyUrl: "https://www.fintraffic.fi/en/fintraffic/data-protection",
  },
]
