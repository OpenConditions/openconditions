{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "no_delay",
        "delay",
        "closed",
        "unknown"
      ]
    },
    "waitMinutes": {
      "type": "number",
      "minimum": 0
    },
    "lanesOpen": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "vehiclesInQueue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "paused": {
      "type": "boolean"
    }
  },
  "required": [
    "v",
    "status"
  ],
  "additionalProperties": false
}
