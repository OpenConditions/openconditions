{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "workingStatus": {
      "type": "string",
      "enum": [
        "in_service",
        "out_of_service",
        "fault",
        "blank",
        "unknown"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Text"
                  }
                }
              },
              "required": [
                "page",
                "lines"
              ],
              "additionalProperties": false
            }
          },
          "pictograms": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "area": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "codeSystem": {
                  "type": "string",
                  "enum": [
                    "iso14823",
                    "datex",
                    "vienna",
                    "wzdx",
                    "provider"
                  ]
                },
                "description": {
                  "$ref": "#/$defs/Text"
                },
                "value": {
                  "$ref": "#/$defs/Quantity"
                }
              },
              "required": [
                "area",
                "code",
                "codeSystem"
              ],
              "additionalProperties": false
            }
          },
          "graphic": {
            "type": "object",
            "properties": {
              "mediaType": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "mediaType"
            ],
            "additionalProperties": false
          },
          "supplementary": {
            "$ref": "#/$defs/Text"
          },
          "speedLimit": {
            "$ref": "#/$defs/Quantity"
          },
          "flashing": {
            "type": "boolean"
          },
          "laneSignals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lane": {
                  "$ref": "#/$defs/LaneRef"
                },
                "signal": {
                  "type": "string",
                  "enum": [
                    "open",
                    "closed",
                    "merge_left",
                    "merge_right",
                    "speed",
                    "hazard",
                    "blank"
                  ]
                },
                "speed": {
                  "$ref": "#/$defs/Quantity"
                }
              },
              "required": [
                "lane",
                "signal"
              ],
              "additionalProperties": false
            }
          },
          "reasonRef": {
            "$ref": "#/$defs/RecordRef"
          },
          "validity": {
            "$ref": "#/$defs/Validity"
          }
        },
        "required": [
          "index"
        ],
        "additionalProperties": false
      }
    },
    "multiString": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "v",
    "workingStatus",
    "messages"
  ],
  "additionalProperties": false,
  "$defs": {
    "Text": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "machine": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "lang",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "Quantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "accuracy": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "LaneRef": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "enum": [
            "general",
            "hov",
            "bus",
            "bicycle",
            "shoulder",
            "hard_shoulder",
            "emergency",
            "turn",
            "exit",
            "entrance",
            "median",
            "center_turn",
            "ramp",
            "parking",
            "sidewalk"
          ]
        }
      },
      "required": [
        "index"
      ],
      "additionalProperties": false
    },
    "RecordRef": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "feature",
            "situation",
            "observation",
            "offer"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "componentKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "class",
        "id"
      ],
      "additionalProperties": false
    },
    "Validity": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "active",
            "suspended",
            "ended",
            "cancelled",
            "unknown"
          ]
        },
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "estimatedEnd": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "startVerified": {
          "type": "boolean"
        },
        "endVerified": {
          "type": "boolean"
        },
        "periods": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Schedule"
          }
        },
        "exceptions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Schedule"
          }
        },
        "endedReason": {
          "type": "string",
          "enum": [
            "source_ended",
            "withdrawn_from_feed",
            "expired",
            "superseded",
            "cancelled",
            "stale"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "Schedule": {
      "type": "object",
      "properties": {
        "repeatFrequency": {
          "type": "string",
          "pattern": "^P(?!$)(?:\\d+Y)?(?:\\d+M)?(?:\\d+W)?(?:\\d+D)?(?:T(?=\\d)(?:\\d+H)?(?:\\d+M)?(?:\\d+S)?)?$"
        },
        "repeatCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startTime": {
          "type": "string",
          "minLength": 1
        },
        "endTime": {
          "type": "string",
          "minLength": 1
        },
        "duration": {
          "type": "string",
          "pattern": "^P(?!$)(?:\\d+Y)?(?:\\d+M)?(?:\\d+W)?(?:\\d+D)?(?:T(?=\\d)(?:\\d+H)?(?:\\d+M)?(?:\\d+S)?)?$"
        },
        "byDay": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "MO",
              "TU",
              "WE",
              "TH",
              "FR",
              "SA",
              "SU"
            ]
          }
        },
        "byMonth": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "byMonthDay": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          }
        },
        "exceptDate": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "scheduleTimezone": {
          "type": "string"
        }
      },
      "required": [
        "scheduleTimezone"
      ],
      "additionalProperties": false
    }
  }
}
