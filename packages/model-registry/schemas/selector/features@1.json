{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "type": "array",
  "items": {
    "$ref": "#/$defs/RecordRef"
  },
  "$defs": {
    "RecordRef": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "feature",
            "situation",
            "observation",
            "offer"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "componentKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "class",
        "id"
      ],
      "additionalProperties": false
    }
  }
}
