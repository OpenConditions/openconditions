{
  "name": "@openconditions/ocpi",
  "version": "0.1.0",
  "description": "OCPI wire types and decoders for OpenConditions: location and tariff normalisation, the OCPDB, NDW, Via Lietuva and Digitraffic dialects",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@openconditions/conformance": "workspace:*",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenConditions/openconditions.git",
    "directory": "packages/ocpi"
  },
  "homepage": "https://github.com/OpenConditions/openconditions/tree/main/packages/ocpi",
  "dependencies": {
    "@types/node": "26.6.5"
  }
}
