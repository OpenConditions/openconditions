{
  "name": "@openconditions/publishers",
  "version": "0.1.0",
  "description": "Outbound emitters (GeoJSON, JSON-LD, TraFF, DATEX II, routing outputs) — pure projections from OpenConditions records to standard wire formats",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openconditions/core": "workspace:*",
    "@openconditions/ingest-framework": "workspace:*",
    "@openconditions/model": "workspace:*",
    "@openconditions/model-roads": "workspace:*",
    "@openconditions/roads": "workspace:*",
    "fast-xml-parser": "^5.11.1",
    "hyparquet": "1.31.1",
    "hyparquet-writer": "0.16.10"
  },
  "devDependencies": {
    "@openconditions/model-registry": "workspace:*",
    "@types/geojson": "^7946.0.16",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
