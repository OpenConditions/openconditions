o/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},"title":{"CharacterString":"SID Parameter"}}},"keyword":[{"CharacterString":"Temperatur"},{"CharacterString":"Relativ luftfuktighet"}]}},{"MD_Keywords":{"thesaurusName":{"CI_Citation":{"date":{"CI_Date":{"date":{"Date":"2022-01-17"},"dateType":{"CI_DateTypeCode":{"codeListValue":"publication","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},"title":{"CharacterString":"SID harvest target"}}},"keyword":[{"CharacterString":"geodata.se"},{"CharacterString":"dataportal.se"}]}}],"citation":{"CI_Citation":{"date":[{"CI_Date":{"date":{"Date":"2019-08-27"},"dateType":{"CI_DateTypeCode":{"codeListValue":"creation","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},{"CI_Date":{"date":{"Date":"2019-09-27"},"dateType":{"CI_DateTypeCode":{"codeListValue":"publication","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},{"CI_Date":{"date":{"Date":"2024-05-03"},"dateType":{"CI_DateTypeCode":{"codeListValue":"revision","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}}],"identifier":{"MD_Identifier":{"code":{"Anchor":{"href":"https://opendata-catalog.smhi.se/md/45970e30-c8a4-11e9-87e3-097244ef907f"}}}},"title":{"CharacterString":"SE.ACMF Meteorologiska observationer - Daggpunktstemperatur timvärde"}}},"resourceConstraints":[{"MD_LegalConstraints":{"otherConstraints":{"Anchor":{"href":"http://resources.geodata.se/codelists/metadata/atkomstrestriktioner.xml#IngenBegransning","content":"Ingen begränsning"}},"accessConstraints":{"MD_RestrictionCode":{"codeListValue":"otherRestrictions","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_RestrictionCode"}}}},{"MD_LegalConstraints":{"otherConstraints":{"CharacterString":"I och med att du laddar ned data så accepterar du följande licensvillkor, https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning. Ange om möjligt SMHI som källa."},"useConstraints":{"MD_RestrictionCode":{"codeListValue":"otherRestrictions","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_RestrictionCode"}}}}],"spatialRepresentationType":{"MD_SpatialRepresentationTypeCode":{"codeListValue":"vector","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_SpatialRepresentationTypeCode"}},"language":{"LanguageCode":{"codeListValue":"swe","codeList":"http://www.loc.gov/standards/iso639-2/","content":"Svenska"}},"topicCategory":{"MD_TopicCategoryCode":"climatologyMeteorologyAtmosphere"},"abstract":{"CharacterString":"Syfte: Beskriver aktuellt väder och med tiden klimatet. Underlag för prognoser och klimatstudier.\n\nEnhet: °C\n\nEgenskaper: Daggpunkten är ett mått på hur mycket vattenånga atmosfären innehåller. Om temperaturen sjunker till daggpunkten blir luften mättad med vattenånga och den relativa luftfuktigheten blir 100 %. Från mätningar av temperatur och relativ fuktighet beräknas daggpunkten.\n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Grönt = Kontrollerade och godkända värden. Gult = Misstänkta värden, aggregerade värden och grovt kontrollerade arkivdata.\n\nGränser: -60 till +40 °C\n\nFör mer info se: https://www.smhi.se/kunskapsbanken/meteorologi/dimma-och-fuktdis/dagg"},"status":{"MD_ProgressCode":{"codeListValue":"onGoing","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_ProgressCode"}},"pointOfContact":{"CI_ResponsibleParty":{"organisationName":{"CharacterString":"SMHI"},"role":{"CI_RoleCode":{"codeListValue":"owner","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_RoleCode"}},"contactInfo":{"CI_Contact":{"address":{"CI_Address":{"deliveryPoint":{"CharacterString":"Folkborgsvägen 17"},"city":{"CharacterString":"Norrköping"},"postalCode":{"CharacterString":60176},"electronicMailAddress":{"CharacterString":"dataleveranser@smhi.se"}}},"phone":{"CI_Telephone":{"voice":{"CharacterString":"011-4958000"}}}}}}}}},"dateStamp":{"Date":"2025-04-02"},"fileIdentifier":{"CharacterString":"45970e30-c8a4-11e9-87e3-097244ef907f"},"hierarchyLevel":{"MD_ScopeCode":{"codeListValue":"dataset","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_ScopeCode"}},"contact":{"CI_ResponsibleParty":{"organisationName":{"CharacterString":"SMHI"},"role":{"CI_RoleCode":{"codeListValue":"pointOfContact","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_RoleCode"}},"contactInfo":{"CI_Contact":{"address":{"CI_Address":{"deliveryPoint":{"CharacterString":"Folkborgsvägen 17"},"city":{"CharacterString":"Norrköping"},"postalCode":{"CharacterString":60176},"electronicMailAddress":{"CharacterString":"klimatolog@smhi.se"}}},"phone":{"CI_Telephone":{"voice":{"CharacterString":"011-4958000"}}}}}}},"metadataStandardName":{"CharacterString":"SS-EN-ISO-19115:2005-NMDP 4.0"},"dataQualityInfo":{"DQ_DataQuality":{"lineage":{"LI_Lineage":{"statement":{"CharacterString":"Vid automatstationer mäts den relativa luftfuktigheten med fuktgivare av märket Vaisala. Före 1995 utfördes mätningarna med hårhygrometrar eller i några fall med assmanpsykrometrar. Automatiska mätningar görs varje timme medan de manuella mätningarna gjordes var tredje timme. Med hjälp av rådande lufttemperatur kan den relativa luftfuktigheten räknas om till andra fuktighetsmått. Beskrivningar av mätmetoder och mätfrekvenser finns på: https://www.smhi.se/kunskapsbanken/meteorologi/hur-mats-luftfuktighet-1.6959 När data lagrats i databasen körs automatiska kontroller som sätter en kvalitetskod. Detta tar normalt ca 2 timmar. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.\n\nTemporal utsträckning:\nI huvudsak komplett sedan 1961. Laddning av äldre historiska data pågår löpande."}}},"scope":{"DQ_Scope":{"level":{"MD_ScopeCode":{"codeListValue":"dataset","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_ScopeCode"}}}},"report":{"DQ_DomainConsistency":{"result":{"DQ_ConformanceResult":{"pass":{"Boolean":false},"specification":{"CI_Citation":{"date":{"CI_Date":{"date":{"Date":"2010-12-08"},"dateType":{"CI_DateTypeCode":{"codeListValue":"publication","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},"title":{"Anchor":{"href":"https://data.europa.eu/eli/reg/2010/1089","content":"Kommissionens förordning (EU) nr 1089/2010 av den 23 november 2010 om genomförande av Europaparlamentets och rådets direktiv 2007/2/EG vad gäller interoperabilitet för rumsliga datamängder och datatjänster"}}}},"explanation":{"CharacterString":"Se refererad specifikation"}}}}}}},"language":{"LanguageCode":{"codeListValue":"swe","codeList":"http://www.loc.gov/standards/iso639-2/","content":"Svenska"}},"distributionInfo":{"MD_Distribution":{"distributor":{"MD_Distributor":{"distributorContact":{"CI_ResponsibleParty":{"organisationName":{"CharacterString":"SMHI"},"role":{"CI_RoleCode":{"codeListValue":"distributor","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_RoleCode"}},"contactInfo":{"CI_Contact":{"address":{"CI_Address":{"deliveryPoint":{"CharacterString":"Folkborgsvägen 17"},"city":{"CharacterString":"Norrköping"},"postalCode":{"CharacterString":"601 76"},"electronicMailAddress":{"CharacterString":"dataleveranser@smhi.se"}}},"phone":{"CI_Telephone":{"voice":{"CharacterString":"011-495 8000"}}}}}}},"distributorTransferOptions":{"MD_DigitalTransferOptions":{"onLine":[{"CI_OnlineResource":{"protocol":{"Anchor":{"href":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning","content":"HTTP:Nedladdning"}},"function":{"CI_OnLineFunctionCode":{"codeListValue":"download","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_OnLineFunctionCode"}},"name":{"CharacterString":"API för nedladdning"},"description":{"CharacterString":"Nedladdning av data"},"linkage":{"URL":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/39.json"}}},{"CI_OnlineResource":{"protocol":{"Anchor":{"href":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning","content":"HTTP:Nedladdning"}},"function":{"CI_OnLineFunctionCode":{"codeListValue":"download","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_OnLineFunctionCode"}},"name":{"CharacterString":"GUI för nedladdning"},"description":{"CharacterString":"Webbplats för nedladdning"},"linkage":{"URL":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/dewPointTemperature"}}},{"CI_OnlineResource":{"protocol":{"Anchor":{"href":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS","content":"HTTP:OGC:WMS"}},"function":{"CI_OnLineFunctionCode":{"codeListValue":"information","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_OnLineFunctionCode"}},"name":{"CharacterString":"Visningstjänst temperatur momentanvärde"},"description":{"CharacterString":"Visningstjänst (WMS) temperatur momentanvärde"},"linkage":{"URL":"https://opendata-view.smhi.se/met-obs/ACMF.daggpunktstemperatur_momentan_view/wms?service=wms&request=getcapabilities"}}},{"CI_OnlineResource":{"protocol":{"Anchor":{"href":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Information","content":"HTTP:Inf