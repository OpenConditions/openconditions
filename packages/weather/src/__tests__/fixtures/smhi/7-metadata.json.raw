"Observation"}}},{"MD_Keywords":{"thesaurusName":{"CI_Citation":{"date":{"CI_Date":{"date":{"Date":"2012-09-04"},"dateType":{"CI_DateTypeCode":{"codeListValue":"publication","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},"title":{"CharacterString":"SID Parameter"}}},"keyword":{"CharacterString":"Nederbördsmängd"}}},{"MD_Keywords":{"thesaurusName":{"CI_Citation":{"date":{"CI_Date":{"date":{"Date":"2022-01-17"},"dateType":{"CI_DateTypeCode":{"codeListValue":"publication","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},"title":{"CharacterString":"SID harvest target"}}},"keyword":[{"CharacterString":"geodata.se"},{"CharacterString":"dataportal.se"}]}}],"citation":{"CI_Citation":{"date":[{"CI_Date":{"date":{"Date":"2013-09-16"},"dateType":{"CI_DateTypeCode":{"codeListValue":"creation","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},{"CI_Date":{"date":{"Date":"2013-09-16"},"dateType":{"CI_DateTypeCode":{"codeListValue":"publication","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},{"CI_Date":{"date":{"Date":"2024-05-03"},"dateType":{"CI_DateTypeCode":{"codeListValue":"revision","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}}],"identifier":{"MD_Identifier":{"code":{"Anchor":{"href":"https://opendata-catalog.smhi.se/md/2cdaac6d-e9eb-4857-a44f-b07521a18afd"}}}},"title":{"CharacterString":"SE.ACMF Meteorologiska observationer - Nederbörd timvärde"}}},"resourceConstraints":[{"MD_LegalConstraints":{"otherConstraints":{"Anchor":{"href":"http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/noLimitations","content":"No limitations to public access"}},"accessConstraints":{"MD_RestrictionCode":{"codeListValue":"otherRestrictions","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_RestrictionCode"}}}},{"MD_LegalConstraints":{"otherConstraints":{"CharacterString":"I och med att du laddar ned data så accepterar du följande licensvillkor, https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning. Ange om möjligt SMHI som källa."},"useConstraints":{"MD_RestrictionCode":{"codeListValue":"otherRestrictions","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_RestrictionCode"}}}}],"spatialRepresentationType":{"MD_SpatialRepresentationTypeCode":{"codeListValue":"vector","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_SpatialRepresentationTypeCode"}},"language":{"LanguageCode":{"codeListValue":"swe","codeList":"http://www.loc.gov/standards/iso639-2/","content":"Svenska"}},"topicCategory":{"MD_TopicCategoryCode":"climatologyMeteorologyAtmosphere"},"abstract":{"CharacterString":"Syfte: Beskriver aktuellt väder och med tiden klimatet. Underlag för klimatstudier och prognosverifikation.\n\nEnhet: mm \n\nEgenskaper: Nederbörd uppmätt vid automatiska mätstationer, ackumulerat värde under en timme. Nederbörden mäts i smält form.\n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Grönt = Kontrollerade och godkända värden. Gult = Misstänkta värden, aggregerade värden, grovt kontrollerade arkivdata och okontrollerade realtidsdata (senaste 2 tim). \n\nGränser: >=0 \n\nFör mer info se: https://www.smhi.se/data/meteorologi/nederbord"},"status":{"MD_ProgressCode":{"codeListValue":"onGoing","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_ProgressCode"}},"pointOfContact":{"CI_ResponsibleParty":{"organisationName":{"CharacterString":"SMHI"},"role":{"CI_RoleCode":{"codeListValue":"owner","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_RoleCode"}},"contactInfo":{"CI_Contact":{"address":{"CI_Address":{"deliveryPoint":{"CharacterString":"Folkborgsvägen 17"},"city":{"CharacterString":"Norrköping"},"postalCode":{"CharacterString":60176},"electronicMailAddress":{"CharacterString":"klimatolog@smhi.se"}}},"phone":{"CI_Telephone":{"voice":{"CharacterString":"011-4958000"}}}}}}}}},"dateStamp":{"Date":"2025-04-02"},"fileIdentifier":{"CharacterString":"2cdaac6d-e9eb-4857-a44f-b07521a18afd"},"hierarchyLevel":{"MD_ScopeCode":{"codeListValue":"dataset","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_ScopeCode"}},"contact":{"CI_ResponsibleParty":{"organisationName":{"CharacterString":"SMHI"},"role":{"CI_RoleCode":{"codeListValue":"pointOfContact","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_RoleCode"}},"contactInfo":{"CI_Contact":{"address":{"CI_Address":{"deliveryPoint":{"CharacterString":"Folkborgsvägen 17"},"city":{"CharacterString":"Norrköping"},"postalCode":{"CharacterString":60176},"electronicMailAddress":{"CharacterString":"klimatolog@smhi.se"}}},"phone":{"CI_Telephone":{"voice":{"CharacterString":"011-4958000"}}}}}}},"metadataStandardName":{"CharacterString":"SS-EN-ISO-19115:2005-NMDP 4.0"},"dataQualityInfo":{"DQ_DataQuality":{"lineage":{"LI_Lineage":{"statement":{"CharacterString":"Nederbörden mäts automatiskt med givare av märket Geonor se https://www.geonor.no. En hink som samlar nederbörden är upphängd med tre metalltrådar varav en är fäst i givaren. Nederbördens vikt mäts och mängden beräknas. Timvisa mätningar infördes 1995.  Beskrivningar av mätmetoder och mätfrekvenser finns på: https://www.smhi.se/kunskapsbanken/meteorologi/regn/hur-mats-nederbord. När data lagrats i databasen körs automatiska kontroller som sätter en kvalitetskod. Detta tar normalt ca 2 timmar. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.  I SMHIs observationsnät ingår stationer som ägs av Försvarsmakten och står på deras flygplatser. De har en optisk givare som genom mätning av nederbördsintensitet kan beräkna nederbördsmängd.  Denna givare har inte samma mätnoggrannhet som givaren från Geonor.\n\nTemporal utsträckning:\nI huvudsak komplett sedan 1961. Laddning av äldre historiska data pågår löpande."}}},"scope":{"DQ_Scope":{"level":{"MD_ScopeCode":{"codeListValue":"dataset","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_ScopeCode"}}}},"report":[{"DQ_DomainConsistency":{"result":{"DQ_ConformanceResult":{"pass":{"Boolean":false},"specification":{"CI_Citation":{"date":{"CI_Date":{"date":{"Date":"2010-12-08"},"dateType":{"CI_DateTypeCode":{"codeListValue":"publication","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},"title":{"Anchor":{"href":"http://data.europa.eu/eli/reg/2010/1089","content":"Kommissionens förordning (EU) nr 1089/2010 av den 23 november 2010 om genomförande av Europaparlamentets och rådets direktiv 2007/2/EG vad gäller interoperabilitet för rumsliga datamängder och datatjänster"}}}},"explanation":{"CharacterString":"Se refererad specifikation"}}}}},{"DQ_CompletenessOmission":{"result":{"DQ_QuantitativeResult":{"valueType":{"RecordType":"kvot"},"valueUnit":{"title":"km2"},"value":{"Record":"449964/449964"}}},"nameOfMeasure":{"CharacterString":"Yttäckning - täckningsgrad"}}}]}},"language":{"LanguageCode":{"codeListValue":"swe","codeList":"http://www.loc.gov/standards/iso639-2/","content":"Svenska"}},"distributionInfo":{"MD_Distribution":{"distributionFormat":{"MD_Format":{"name":{"CharacterString":"application/xml"},"version":{"CharacterString":1}}},"distrib