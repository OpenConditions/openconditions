ing":"Observation"}}},{"MD_Keywords":{"thesaurusName":{"CI_Citation":{"date":{"CI_Date":{"date":{"Date":"2012-09-04"},"dateType":{"CI_DateTypeCode":{"codeListValue":"publication","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},"title":{"CharacterString":"SID Parameter"}}},"keyword":{"CharacterString":"Lufttemperatur"}}},{"MD_Keywords":{"thesaurusName":{"CI_Citation":{"date":{"CI_Date":{"date":{"Date":"2022-01-17"},"dateType":{"CI_DateTypeCode":{"codeListValue":"publication","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},"title":{"CharacterString":"SID harvest target"}}},"keyword":[{"CharacterString":"geodata.se"},{"CharacterString":"dataportal.se"}]}}],"citation":{"CI_Citation":{"date":[{"CI_Date":{"date":{"Date":"2013-09-06"},"dateType":{"CI_DateTypeCode":{"codeListValue":"creation","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},{"CI_Date":{"date":{"Date":"2013-09-06"},"dateType":{"CI_DateTypeCode":{"codeListValue":"publication","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},{"CI_Date":{"date":{"Date":"2024-05-03"},"dateType":{"CI_DateTypeCode":{"codeListValue":"revision","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}}],"identifier":{"MD_Identifier":{"code":{"Anchor":{"href":"https://opendata-catalog.smhi.se/md/c6ae10b6-6a18-4e15-9444-fbd746f4609d"}}}},"title":{"CharacterString":"SE.ACMF Meteorologiska observationer - Lufttemperatur timvärde"}}},"resourceConstraints":[{"MD_LegalConstraints":{"otherConstraints":{"Anchor":{"href":"http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/noLimitations","content":"No limitations to public access"}},"accessConstraints":{"MD_RestrictionCode":{"codeListValue":"otherRestrictions","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_RestrictionCode"}}}},{"MD_LegalConstraints":{"otherConstraints":{"CharacterString":"I och med att du laddar ned data så accepterar du följande licensvillkor, https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning. Ange om möjligt SMHI som källa."},"useConstraints":{"MD_RestrictionCode":{"codeListValue":"otherRestrictions","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_RestrictionCode"}}}}],"spatialRepresentationType":{"MD_SpatialRepresentationTypeCode":{"codeListValue":"vector","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_SpatialRepresentationTypeCode"}},"language":{"LanguageCode":{"codeListValue":"swe","codeList":"http://www.loc.gov/standards/iso639-2/","content":"Svenska"}},"topicCategory":{"MD_TopicCategoryCode":"climatologyMeteorologyAtmosphere"},"abstract":{"CharacterString":"Syfte: Beskriver aktuellt väder och med tiden klimatet. Underlag för prognoser och klimatstudier.\n\nEnhet: °C\n\nEgenskaper: Lufttemperatur uppmätt vid mätstationer. Momentanvärde varje resp var tredje timme, samt på enklare stationer två eller tre gånger per dygn. \n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Grönt = Kontrollerade och godkända värden. Gult = Misstänkta värden, aggregerade värden och grovt kontrollerade arkivdata.\n\nGränser: -60 till +40 °C\n\nFör mer info se: https://www.smhi.se/data/meteorologi/temperatur"},"status":{"MD_ProgressCode":{"codeListValue":"onGoing","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_ProgressCode"}},"pointOfContact":{"CI_ResponsibleParty":{"organisationName":{"CharacterString":"SMHI"},"role":{"CI_RoleCode":{"codeListValue":"owner","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_RoleCode"}},"contactInfo":{"CI_Contact":{"address":{"CI_Address":{"deliveryPoint":{"CharacterString":"Folkborgsvägen 17"},"city":{"CharacterString":"Norrköping"},"postalCode":{"CharacterString":60176},"electronicMailAddress":{"CharacterString":"Dataleveranser@smhi.se"}}},"phone":{"CI_Telephone":{"voice":{"CharacterString":"011-4958000"}}}}}}}}},"dateStamp":{"Date":"2025-04-02"},"fileIdentifier":{"CharacterString":"c6ae10b6-6a18-4e15-9444-fbd746f4609d"},"hierarchyLevel":{"MD_ScopeCode":{"codeListValue":"dataset","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_ScopeCode"}},"contact":{"CI_ResponsibleParty":{"organisationName":{"CharacterString":"SMHI"},"role":{"CI_RoleCode":{"codeListValue":"pointOfContact","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_RoleCode"}},"contactInfo":{"CI_Contact":{"address":{"CI_Address":{"deliveryPoint":{"CharacterString":"Folkborgsvägen 17"},"city":{"CharacterString":"Norrköping"},"postalCode":{"CharacterString":60176},"electronicMailAddress":{"CharacterString":"klimatolog@smhi.se"}}},"phone":{"CI_Telephone":{"voice":{"CharacterString":"011-4958000"}}}}}}},"metadataStandardName":{"CharacterString":"SS-EN-ISO-19115:2005-NMDP 4.0"},"dataQualityInfo":{"DQ_DataQuality":{"lineage":{"LI_Lineage":{"statement":{"CharacterString":"Temperaturen mäts automatiskt med Pt100 resistanstermometrar, se https://www.pentronic.se. Före 1995 utfördes nästan alla mätningar manuellt med kvicksilver- eller sprittermometer. Idag har även manuella stationer Pt100 givare vars värden avläses manuellt på ett mätinstrument. Automatiska mätningar görs varje timme medan de manuella gjordes var tredje timme. En uppgradering med insamling av automatiska mätningar varje minut är på gång. SMHI har även ett flertal enklare stationer som gör temperaturmätningar 2 eller 3 gånger/dygn.  Beskrivningar av mätmetoder och mätfrekvenser finns på: https://www.smhi.se/kunskapsbanken/meteorologi/temperatur/hur-mats-lufttemperatur. I samband med att data lagras till databasen körs automatiska kontroller som sätter en kvalitetskod. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.\n\nTemporal utsträckning:\nI huvudsak komplett sedan 1961. Laddning av äldre historiska data pågår löpande."}}},"scope":{"DQ_Scope":{"level":{"MD_ScopeCode":{"codeListValue":"dataset","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_ScopeCode"}}}},"report":[{"DQ_DomainConsistency":{"result":{"DQ_ConformanceResult":{"pass":{"Boolean":false},"specification":{"CI_Citation":{"date":{"CI_Date":{"date":{"Date":"2010-12-08"},"dateType":{"CI_DateTypeCode":{"codeListValue":"publication","codeList":"http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode"}}}},"title":{"Anchor":{"href":"http://data.europa.eu/eli/reg/2010/1089","content":"Kommissionens förordning (EU) nr 1089/2010 av den 23 november 2010 om genomförande av Europaparlamentets och rådets direktiv 2007/2/EG vad gäller interoperabilitet för rumsliga datamängder och datatjänster"}}}},"explanation":{"CharacterString":"Se refererad specifikation"}}}}},{"DQ_CompletenessOmission":{"result":{"DQ_QuantitativeResult":{"valueType":{"RecordType":"kvot"},"valueUnit":{"title":"km2"},"value":{"Record":"449964/449964"}}},"nameOfMeasure":{"CharacterString":"Yttäckning - täckningsgrad"}}}]}},"language":{"LanguageCode":{"codeListValue":"swe","codeList":"http://www.loc.gov/standards/iso639-2/","content":"Svenska"}},"distributionInfo":{"MD_Distribution":{"distributionFormat":{"MD_Format":{"name":{"CharacterString":"application/xml"},"version":{"CharacterString":