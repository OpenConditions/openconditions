{
  "$schema": "../schema/vehicles.schema.json",
  "feeds": [
    {
      "subdivision": "ia",
      "operator": "iowadot",
      "product": "maintenance",
      "name": "Iowa DOT selected moving maintenance trucks",
      "tier": "authoritative",
      "format": "iowa-avl",
      "endpoints": {
        "main": {
          "url": "https://services.arcgis.com/8lRhdTsQyJpO52F1/arcgis/rest/services/AVL_Direct_View/FeatureServer/0/query?where=1%3D1&outFields=OBJECTID,LABEL,HEADING,VELOCITY,ACTIVE_MATERIAL,ROUTE_NAME,MODIFIEDDT&outSR=4326&resultRecordCount=500&orderByFields=OBJECTID&f=json",
          "cadenceSec": 120,
          "pagination": {
            "skipParam": "resultOffset",
            "pageSize": 500,
            "recordsPath": "features",
            "maxPages": 10,
            "arcgis": true,
          },
        },
      },
      "coverage": { "countries": ["US-IA"], "bbox": [-96.7, 40.3, -90, 43.6] },
      "freshnessWindowSec": 600,
      "extrasFederate": false,
