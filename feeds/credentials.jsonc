{
  "$schema": "./schema/credentials.schema.json",
  "credentials": {
    // One org machine certificate authenticates every Mobilithek client pull: a
    // new region needs no new credential beyond its own subscription id.
    "mobilithek": {
      "cert": {
        "title": "Mobilithek — client certificate (PEM)",
        "description": "PEM contents of the machine-account client certificate (mutual TLS). ONE certificate authenticates every Mobilithek feed — set it once, then just add each feed's subscription id. Recommended: generate your own keypair with `openssl req -x509 -newkey rsa:4096 -nodes -days 825 -keyout mobilithek.key.pem -out mobilithek.cert.pem -subj \"/CN=openmapx-mobilithek\"`, upload mobilithek.cert.pem under the machine account's 'Zertifikat hochladen' tab (no SMS needed), then paste mobilithek.cert.pem here and mobilithek.key.pem in the key field. Alternative: convert an issued .p12 with `openssl pkcs12 -in m.p12 -clcerts -nokeys | openssl x509` (cert) and `openssl pkcs12 -in m.p12 -nocerts -nodes | openssl rsa` (key).",
        "setup": {
          "url": "https://mobilithek.info/registration-request",
          "urlLabel": "Mobilithek registration",
          "steps": [
            "Register your organisation at mobilithek.info/registration-request; leave 'Organisation relevant gemäß MDV/PBefG' unchecked.",
            "Subscribe to the offer(s) you want (each feed's offer IDs are listed in its subscription-id field).",
            "Create a machine account at mobilithek.info/organisation/machine-accounts and upload your own certificate (generate it with the openssl command shown in this field's description, no SMS needed). Paste the certificate PEM here and its private key in the key field.",
          ],
          "notes": "This ONE certificate authenticates every Mobilithek feed — set it once, then add each feed's subscription id. (The NRW state network is published under 'LVZ.NRW', not 'Straßen.NRW'.)",
        },
      },
      "key": {
        "title": "Mobilithek — client private key (PEM)",
        "description": "PEM contents of the certificate's private key, with no passphrase (generate with openssl -nodes, or strip an issued .p12 key with openssl rsa). Stays with us — never uploaded to Mobilithek. Shared by every Mobilithek feed.",
      },
    },
    // The Freeway Travel Time feed and both disruption feeds sit on the same
    // Transport Victoria Open Data server behind the same subscription key.
    "au-vic-transportvic": {
      "api_key": {
        "title": "Transport Victoria Open Data key",
        "description": "Ocp-Apim-Subscription-Key header value from the Transport Victoria Open Data Portal. Serves the Freeway Travel Time feed and the planned and unplanned disruption feeds.",
        "setup": {
          "url": "https://opendata.transport.vic.gov.au/",
          "urlLabel": "Transport Victoria Open Data Portal",
          "steps": [
            "Create an account at opendata.transport.vic.gov.au (email verification + authenticator 2FA).",
            "Open My Account → Profile → API tokens; the key is generated there.",
            "Copy the key and set it as the Ocp-Apim-Subscription-Key value.",
          ],
          "cost": "Free",
          "notes": "CC-BY-4.0 (Freeway Travel Time — NOT the CC-BY-NC Bluetooth feed); attribution \"Department of Transport and Planning (Victoria)\". Rate limit 5 req/min.",
        },
      },
    },
    // One Open Data Hub token serves every Transport for NSW product it is
    // subscribed to: the live hazards, the car parks and the live cameras.
    "au-nsw-tfnsw": {
      "api_key": {
        "title": "Transport for NSW Open Data API key (Australia)",
        "description": "An Open Data Hub API token, sent as the 'apikey' authorization header. Serves the Live Traffic hazards, the Park&Ride car parks and the Live Traffic cameras.",
        "setup": {
          "url": "https://opendata.transport.nsw.gov.au/",
          "urlLabel": "Get API key",
          "steps": [
            "Register for a free account at opendata.transport.nsw.gov.au and log in to the Open Data Hub.",
            "Click your profile icon, choose 'API Tokens', enter a name, click 'CREATE API TOKEN' and copy the key (shown only once).",
            "In the data catalogue, open the 'Car park API' and 'Live Traffic Cameras API' datasets and subscribe each to your application; the token alone authorises the live-hazard endpoints.",
            "Paste the generated token here (sent as the 'apikey' authorization header).",
          ],
          "cost": "Free",
          "notes": "CC-BY-4.0; attribution \"Transport for NSW\". One token for the hazards, car-park and camera feeds.",
        },
      },
    },
    // Ontario 511's developer key, which every Ontario 511 API call needs:
    // the events, construction projects, road conditions and cameras share it
    // and its ten calls a minute. Pacing is per feed, so the cadences keep the
    // four together well inside the limit.
    "ca-on-511": {
      "api_key": {
        "title": "Ontario 511 developer key (Canada)",
        "description": "Sent as the 'key' query parameter. Serves the Ontario 511 events, construction projects, road conditions and cameras feeds.",
        "setup": {
          "url": "https://511on.ca/developers/doc",
          "urlLabel": "Ontario 511 developer resources",
          "steps": [
            "Create a free account at 511on.ca/my511/register (or log in); an account is needed before a key can be requested.",
            "Request a Developer API key from the developer resources page. The request names your organisation and primary contact, describes the proposed service, and identifies every third party that will receive, redistribute or display Ontario 511 data through it (for an OpenMapX instance: OpenMapX, and federation peers if federation is on).",
            "The Ministry reviews requests case by case; once granted, copy the key (sent as the 'key' query parameter).",
          ],
          "cost": "Free",
          "notes": "Developer's Access Agreement: https://511on.ca/developers/resources. Data under the Open Government Licence – Ontario; the disclaimer travels with the data when it is distributed. Ontario 511 allows ten calls every 60 seconds per key. Each of the four feeds paces itself to that limit on its own, not together; their cadences (five minutes for the events, construction projects and road conditions, an hour for the cameras) keep the four well inside ten calls a minute.",
        },
      },
    },
    "hr-hc": {
      "user": {
        "title": "Hrvatske ceste (Croatia) — B2B username",
        "description": "HTTP Basic username for the promet-info B2B feeds (Croatia).",
        "setup": {
          "url": "https://www.hrvatske-ceste.hr/",
          "urlLabel": "Hrvatske ceste",
          "steps": [
            "There is no self-service portal — request B2B account credentials from Hrvatske ceste (the promet-info operator), via hrvatske-ceste.hr or the data.gov.hr dataset page.",
            "Ask for the events publication (\"HC Prometni događaji DatexII v3\") to be enabled on the account as well as roadworks — the two are authorised separately.",
          ],
          "notes": "Open licence (commercial OK); access is gated on the B2B account.",
        },
      },
      "password": {
        "title": "Hrvatske ceste (Croatia) — B2B password",
      },
    },
    "no-vegvesen": {
      "user": {
        "title": "Statens vegvesen (Norway) — username",
        "setup": {
          "url": "https://www.vegvesen.no/en/fag/technology/open-data/a-selection-of-open-data/what-is-datex/get-access/",
          "urlLabel": "Statens vegvesen — get DATEX access",
          "steps": [
            "Request a free account for the DATEX II server via the 'Get access' page (Open data → What is DATEX → Get access).",
          ],
          "cost": "Free",
          "notes": "NLOD-2.0 (commercial OK). One account serves the events and the traffic-speed feeds.",
        },
      },
      "password": {
        "title": "Statens vegvesen (Norway) — password",
      },
    },
    // Where this instance reaches Overpass: the public instance unless the
    // operator runs its own. Every OpenStreetMap source, the road-graph
    // import and the maxspeed lookup query `<url>/api/interpreter`.
    "overpass": {
      "url": {
        "title": "Overpass URL",
        "description": "Base URL of the Overpass instance (http://overpass:80, https://overpass-api.de) or its full interpreter URL (http://overpass:80/api/interpreter), as OpenMapX's OVERPASS_URL accepts: queries go to the base URL plus /api/interpreter. Defaults to the public instance, which allows about 10,000 requests a day; point it at a self-hosted Overpass for heavier use. A private host also needs OPENCONDITIONS_EGRESS_ALLOWED_HOSTS.",
        "default": "https://overpass-api.de",
      },
    },
    "se-trafikverket": {
      "api_key": {
        "title": "Trafikverket key (Sweden)",
        "description": "Authentication key: sent as ?authenticationkey= to the DATEX II situation feed and in the POST request body to the traffic-flow feed.",
        "setup": {
          "url": "https://data.trafikverket.se/oauth2/Account/register",
          "urlLabel": "Sign up at Trafikverket",
          "steps": [
            "Sign up at data.trafikverket.se/oauth2/Account/register.",
            "Create an authentication key under data.trafikverket.se/mypage/systems (My systems).",
          ],
          "cost": "Free",
          "notes": "CC0 — no restrictions. API endpoint: api.trafikinfo.trafikverket.se/v2/data.json (the bare host has no web page).",
        },
      },
    },
    "sg-lta": {
      "api_key": {
        "title": "LTA DataMall AccountKey (Singapore)",
        "setup": {
          "url": "https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html",
          "urlLabel": "Request LTA API access",
          "steps": [
            "Request an API account via the form at datamall.lta.gov.sg/content/datamall/en/request-for-api.html.",
            "The AccountKey is emailed to you.",
          ],
          "cost": "Free",
          "notes": "Singapore ODL (commercial OK); attribution to the Land Transport Authority. Serves the Traffic Incidents and Traffic Speed Bands feeds.",
        },
      },
    },
    // One TDX member account's client pair serves the EV charging and the road
    // CCTV feeds, which share the account's monthly quota.
    "tw-tdx": {
      "client_id": {
        "title": "TDX client id",
        "setup": {
          "url": "https://tdx.transportdata.tw/register",
          "urlLabel": "Register for a TDX platform account",
          "steps": [
            "Go to tdx.transportdata.tw/register and create a free platform member account.",
            "Sign in, open Member Center → 資料服務 → 服務金鑰 (API Key).",
            "Create a Client Id / Client Secret pair (up to 3 per account).",
            "Copy both values — the Client Secret is only shown once.",
          ],
          "cost": "Free",
          "notes": "Used to obtain an OAuth2 client-credentials bearer token from tdx.transportdata.tw for the EV charging Station, ChargingRate and ConnectorLiveStatus APIs and the road CCTV lists. The free tier's quota (about 4,500 calls a month at 5 a minute) is the account's, shared by both feeds.",
        },
      },
      "client_secret": {
        "title": "TDX client secret",
        "description": "The secret of the same Client Id / Client Secret pair.",
      },
    },
    "us-ny-511": {
      "api_key": {
        "title": "511NY data feed access (New York)",
        "description": "The access NYSDOT grants under the 511NY Developer Access Agreement, for the events and winter road conditions feeds (and the camera inventory).",
        "setup": {
          "url": "https://511ny.org/help/24",
          "urlLabel": "Read the 511NY data feed page and Developer Access Agreement",
          "steps": [
            "Read the Developer Access Agreement on 511ny.org/help/24 (last updated 2026-09-18). Submitting a request accepts it.",
            "Open the request form linked on that page (\"CARS Agencies' XML Feed Request Form\", shared by several state DOTs). Fill in Name, \"Company, Agency, or Personal Use\", the company or project name, and the email the approval should go to, and tick NY under the agencies.",
            "Reason for Access is the only free-text field, so it must cover what the agreement asks a request to describe: the intended use and the product (name the traffic events, winter road conditions and camera inventory feeds); the intended market and the benefit to travelers; any similar products you have built or plan; and every intermediate or third-party disseminator. Name OpenConditions, the self-hosted data service that fetches the feeds for your map, and, if this instance serves its public API or federates with peers, those as recipients too. Then state that you accept the agreement and its attribution and display duties.",
            "Ready-to-adapt reason: \"I am requesting access to the NYSDOT (511NY) XML data feeds (traffic events, winter road conditions and the camera inventory) for OpenMapX, a free, non-commercial, open-source maps and navigation app. Our instance fetches the feeds through OpenConditions, our own self-hosted traffic data service, and shows live incidents, road work, closures, winter road conditions and traffic cameras on the map and in route planning, so travelers in New York can plan around them. Audience: the general public, free of charge. Similar products: none. Recipients: our app's end users through OpenConditions, operated by us; no other third parties, and we will tell NYSDOT before that changes. We will show when each report was published or last updated, keep the meaning of every report as NYSDOT published it, pass on NYSDOT's disclaimer, and credit 511NY / NYSDOT as the source. We accept the 511NY Developer Access Agreement.\"",
            "Requests are reviewed weekly. An approval email brings the feed addresses, the access credential and the documentation. Send those to whoever maintains this OpenConditions instance: the feeds need their new addresses, and a reader if the format differs from the retired IBI 511 API, before they can be enabled.",
          ],
          "cost": "Free",
          "notes": "Agreement duties: show when each report was published or last updated; keep the meaning of every report as published; use best efforts to pass on NYSDOT's disclaimer; keep NYSDOT informed of changes to your product, distribution plans and recipients. Permitted, not required: the \"powered by 511NY\" tag line with the unaltered 511NY logo and a link to 511ny.org; otherwise \"511NY\" may not be used to market or brand your product. Questions and feed problems go to the 511NY program manager named on 511ny.org/help/24. The old 511ny.org developer keys and API no longer work.",
        },
      },
    },
    "us-oh-ohgo": {
      "api_key": {
        "title": "OHGO API key",
        "setup": {
          "url": "https://ohgo.com/developer",
          "urlLabel": "OHGO developer registration",
          "steps": [
            "Register for a free OHGO developer account at ohgo.com/developer and create an API key.",
            "Set US_OH_OHGO_API_KEY to the key value; the feeds activate on the next scheduler cycle.",
          ],
          "notes": "Free key. Data is U.S. government public domain. Serves the travel delays, construction and incidents feeds.",
        },
      },
    },
  },
}
