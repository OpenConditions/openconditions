{
  "$schema": "./schema/credentials.schema.json",
  "credentials": {
    // One org machine certificate authenticates every Mobilithek client pull: a
    // new region needs no new credential beyond its own subscription id.
    "mobilithek": {
      "cert": {
        "title": "Mobilithek — client certificate (PEM)",
        "description": "PEM contents of the machine-account client certificate (mutual TLS). ONE certificate authenticates every Mobilithek feed — set it once, then just add each feed's subscription id. Recommended: generate your own keypair with `openssl req -x509 -newkey rsa:4096 -nodes -days 825 -keyout mobilithek.key.pem -out mobilithek.cert.pem -subj \"/CN=openmapx-mobilithek\"`, upload mobilithek.cert.pem under the machine account's 'Zertifikat hochladen' tab (no SMS needed), then paste mobilithek.cert.pem here and mobilithek.key.pem in the key field. Alternative: convert an issued .p12 with `openssl pkcs12 -in m.p12 -clcerts -nokeys | openssl x509` (cert) and `openssl pkcs12 -in m.p12 -nocerts -nodes | openssl rsa` (key).",
        "setup": {
          "url": "https://mobilithek.info/registration-request",
          "urlLabel": "Mobilithek registration",
          "steps": [
            "Register your organisation at mobilithek.info/registration-request; leave 'Organisation relevant gemäß MDV/PBefG' unchecked.",
            "Subscribe to the offer(s) you want (each feed's offer IDs are listed in its subscription-id field).",
            "Create a machine account at mobilithek.info/organisation/machine-accounts and upload your own certificate (generate it with the openssl command shown in this field's description, no SMS needed). Paste the certificate PEM here and its private key in the key field.",
          ],
          "notes": "This ONE certificate authenticates every Mobilithek feed — set it once, then add each feed's subscription id. (The NRW state network is published under 'LVZ.NRW', not 'Straßen.NRW'.)",
        },
      },
      "key": {
        "title": "Mobilithek — client private key (PEM)",
        "description": "PEM contents of the certificate's private key, with no passphrase (generate with openssl -nodes, or strip an issued .p12 key with openssl rsa). Stays with us — never uploaded to Mobilithek. Shared by every Mobilithek feed.",
      },
    },
    // The Freeway Travel Time feed and both disruption feeds sit on the same
    // Transport Victoria Open Data server behind the same subscription key.
    "au-vic-transportvic": {
      "api_key": {
        "title": "Transport Victoria Open Data key",
        "description": "Ocp-Apim-Subscription-Key header value from the Transport Victoria Open Data Portal. Serves the Freeway Travel Time feed and the planned and unplanned disruption feeds.",
        "setup": {
          "url": "https://opendata.transport.vic.gov.au/",
          "urlLabel": "Transport Victoria Open Data Portal",
          "steps": [
            "Create an account at opendata.transport.vic.gov.au (email verification + authenticator 2FA).",
            "Open My Account → Profile → API tokens; the key is generated there.",
            "Copy the key and set it as the Ocp-Apim-Subscription-Key value.",
          ],
          "cost": "Free",
          "notes": "CC-BY-4.0 (Freeway Travel Time — NOT the CC-BY-NC Bluetooth feed); attribution \"Department of Transport and Planning (Victoria)\". Rate limit 5 req/min.",
        },
      },
    },
    "hr-hc": {
      "user": {
        "title": "Hrvatske ceste (Croatia) — B2B username",
        "description": "HTTP Basic username for the promet-info B2B feeds (Croatia).",
        "setup": {
          "url": "https://www.hrvatske-ceste.hr/",
          "urlLabel": "Hrvatske ceste",
          "steps": [
            "There is no self-service portal — request B2B account credentials from Hrvatske ceste (the promet-info operator), via hrvatske-ceste.hr or the data.gov.hr dataset page.",
            "Ask for the events publication (\"HC Prometni događaji DatexII v3\") to be enabled on the account as well as roadworks — the two are authorised separately.",
          ],
          "notes": "Open licence (commercial OK); access is gated on the B2B account.",
        },
      },
      "password": {
        "title": "Hrvatske ceste (Croatia) — B2B password",
      },
    },
    "no-vegvesen": {
      "user": {
        "title": "Statens vegvesen (Norway) — username",
        "setup": {
          "url": "https://www.vegvesen.no/en/fag/technology/open-data/a-selection-of-open-data/what-is-datex/get-access/",
          "urlLabel": "Statens vegvesen — get DATEX access",
          "steps": [
            "Request a free account for the DATEX II server via the 'Get access' page (Open data → What is DATEX → Get access).",
          ],
          "cost": "Free",
          "notes": "NLOD-2.0 (commercial OK). One account serves the events and the traffic-speed feeds.",
        },
      },
      "password": {
        "title": "Statens vegvesen (Norway) — password",
      },
    },
    "se-trafikverket": {
      "api_key": {
        "title": "Trafikverket key (Sweden)",
        "description": "Authentication key: sent as ?authenticationkey= to the DATEX II situation feed and in the POST request body to the traffic-flow feed.",
        "setup": {
          "url": "https://data.trafikverket.se/oauth2/Account/register",
          "urlLabel": "Sign up at Trafikverket",
          "steps": [
            "Sign up at data.trafikverket.se/oauth2/Account/register.",
            "Create an authentication key under data.trafikverket.se/mypage/systems (My systems).",
          ],
          "cost": "Free",
          "notes": "CC0 — no restrictions. API endpoint: api.trafikinfo.trafikverket.se/v2/data.json (the bare host has no web page).",
        },
      },
    },
    "sg-lta": {
      "api_key": {
        "title": "LTA DataMall AccountKey (Singapore)",
        "setup": {
          "url": "https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html",
          "urlLabel": "Request LTA API access",
          "steps": [
            "Request an API account via the form at datamall.lta.gov.sg/content/datamall/en/request-for-api.html.",
            "The AccountKey is emailed to you.",
          ],
          "cost": "Free",
          "notes": "Singapore ODL (commercial OK); attribution to the Land Transport Authority. Serves the Traffic Incidents and Traffic Speed Bands feeds.",
        },
      },
    },
    "us-ny-511": {
      "api_key": {
        "title": "511NY API key (New York)",
        "description": "Query key for the 511NY events and winter road conditions feeds.",
        "setup": {
          "url": "https://511ny.org/my511/register",
          "urlLabel": "Create a 511NY account",
          "steps": [
            "Create an account at 511ny.org/my511/register.",
            "Request an API key at 511ny.org/developers/help. The form asks for your reasons, and submitting accepts the Developer's Access Agreement (DAA), which permits commercial redistribution.",
            "Ready-to-paste reason: OpenMapX (https://openmapx.com) is a free, open-source maps and navigation app. I would use the 511NY events feed to display live incidents, road work, and closures on the map and to help travelers route around active disruptions in New York, with 'Powered by 511NY' attribution shown to users. It serves the general public at no charge; the data is shown only to end users, not resold or provided to any third-party data broker.",
          ],
          "cost": "Free",
          "notes": "Attribution required: \"Powered by 511NY\". 10 calls per 60s across the account, shared by both feeds.",
        },
      },
    },
    "us-oh-ohgo": {
      "api_key": {
        "title": "OHGO API key",
        "setup": {
          "url": "https://ohgo.com/developer",
          "urlLabel": "OHGO developer registration",
          "steps": [
            "Register for a free OHGO developer account at ohgo.com/developer and create an API key.",
            "Set US_OH_OHGO_API_KEY to the key value; the feeds activate on the next scheduler cycle.",
          ],
          "notes": "Free key. Data is U.S. government public domain. Serves the travel delays, construction and incidents feeds.",
        },
      },
    },
  },
}
