{
  "$schema": "../schema/roads.schema.json",
  "feeds": [
    {
      // The WZDx feed registry, resolved into one child per registered work-zone
      // feed. The main endpoint names the registry the resolver reads; the
      // children's own endpoints are what gets polled.
      "operator": "wzdx",
      "product": "events",
      "name": "WZDx (United States)",
      "tier": "authoritative",
      "format": "wzdx",
      "catalog": {
        "resolver": "wzdx-registry",
        "approvedChildren": ["us-wzdx-fe9b3423ea03546f-events"],
      },
      "endpoints": {
        "main": {
          "url": "https://datahub.transportation.gov/resource/69qe-yiui.json?$limit=5000",
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "NOASSERTION",
      "terms": {
        "url": "https://datahub.transportation.gov/resource/69qe-yiui.json",
        "note": "Licences vary per registry child: each WZDx publisher licenses its own feed, and a child is approved only once its dataset grant has been reviewed.",
      },
      "attribution": "WZDx publishers",
      "privacyUrl": "https://www.transportation.gov/privacy",
      "attributionPolicy": {
        "placement": "visible",
        "surfaces": ["map", "content", "image"],
        "basis": "unresolved",
        "reviewedAt": "2026-10-14",
        "evidenceUrls": [
          "https://datahub.transportation.gov/resource/69qe-yiui.json",
          "https://github.com/usdot-jpo-ode/wzdx",
        ],
        "reason": "Exact source rights/placement remain unresolved; generic licence label is not collapse permission",
      },
    },
    {
      "subdivision": "ny",
      "operator": "511",
      "product": "events",
      "name": "511NY (New York)",
      "tier": "authoritative",
      "format": "cars",
      "auth": { "kind": "basic", "user": "@us-ny-511.user", "password": "@us-ny-511.password" },
      // Every current event of the 511NY events API (Castle Rock CARS) but the
      // winter road conditions, which the conditions feed reads: incidents,
      // closures, work zones, special events, truck restrictions and the
      // events affecting transit. TRANSCOM relays its New Jersey and
      // Connecticut partners' events too. The API answers the whole list
      // without paging; NYSDOT asks for one poll every five minutes.
      "endpoints": {
        "main": {
          "url": "https://nysdot.carsprogram.org/carsapi_v1/api/events?eventClassifications=incidents,closures,construction,specialEvents,truckersReports,transitEvents,weatherWarningsAreaEvents",
          "cadenceSec": 300,
        },
      },
      "snapshot": { "completeness": "complete", "recordsPath": "$" },
      "freshnessWindowSec": 900,
      "timezone": "America/New_York",
      "coverage": { "countries": ["US-NY", "US-NJ", "US-CT"] },
      "license": "LicenseRef-511NY-DAA",
      "licenseUrl": "https://511ny.org/help/24",
      "terms": {
        "url": "https://511ny.org/help/24",
        "reviewedAt": "2026-10-14",
        "redistribution": false,
        "note": "The agreement allows redistribution to the disseminators named in the access request. Set redistribution to true in the local catalogue layer once the approved request names this instance's public API and federation peers. Show the publication time of every report, pass on NYSDOT's disclaimer, and keep NYSDOT informed of changes to the product or its recipients.",
      },
      "attribution": "511NY / New York State DOT",
      "homepage": "https://511ny.org/",
      "privacyUrl": "https://511ny.org/privacy",
      "attributionPolicy": {
        "placement": "visible",
        "surfaces": ["map", "content", "image"],
        "basis": "unresolved",
        "reviewedAt": "2026-10-14",
        "evidenceUrls": [
          "https://511ny.org/help/24",
          "https://api-511x-nysdot.carsprogram.org/cms/helpPages/24",
        ],
        "reason": "Plain source text and expanded disclaimer details conditional; Logo+powered by 511NY is permitted trademark pattern, not universal mandatory duty; Named disseminators and actual approved access scope unresolved; Pass on disclaimer using best efforts; preserve report substance",
      },
    },
    {
      "subdivision": "ny",
      "operator": "511",
      "product": "conditions",
      "name": "511NY winter road conditions (New York)",
      "tier": "authoritative",
      "format": "cars",
      "auth": { "kind": "basic", "user": "@us-ny-511.user", "password": "@us-ny-511.password" },
      // The winter driving segments of the same API, each a stretch of state
      // highway with the condition its plow route reports. A segment that
      // reports nothing adverse (out of season: "no active reporting") is
      // accounted for as ended, so a snapshot of only those publishes none.
      "endpoints": {
        "main": {
          "url": "https://nysdot.carsprogram.org/carsapi_v1/api/events?eventClassifications=winterDriving",
          "cadenceSec": 300,
        },
      },
      "snapshot": { "completeness": "complete", "recordsPath": "$" },
      "freshnessWindowSec": 1800,
      "timezone": "America/New_York",
      "coverage": { "countries": ["US-NY"] },
      "license": "LicenseRef-511NY-DAA",
      "licenseUrl": "https://511ny.org/help/24",
      "terms": {
        "url": "https://511ny.org/help/24",
        "reviewedAt": "2026-10-14",
        "redistribution": false,
        "note": "The agreement allows redistribution to the disseminators named in the access request. Set redistribution to true in the local catalogue layer once the approved request names this instance's public API and federation peers. Show the publication time of every report, pass on NYSDOT's disclaimer, and keep NYSDOT informed of changes to the product or its recipients.",
      },
      "attribution": "511NY / New York State DOT",
      "homepage": "https://511ny.org/",
      "privacyUrl": "https://511ny.org/privacy",
      "attributionPolicy": {
        "placement": "visible",
        "surfaces": ["map", "content", "image"],
        "basis": "unresolved",
        "reviewedAt": "2026-10-14",
        "evidenceUrls": [
          "https://511ny.org/help/24",
          "https://api-511x-nysdot.carsprogram.org/cms/helpPages/24",
        ],
        "reason": "Plain source text and expanded disclaimer details conditional; Logo+powered by 511NY is permitted trademark pattern, not universal mandatory duty; Named disseminators and actual approved access scope unresolved; Pass on disclaimer using best efforts; preserve report substance",
      },
    },
    {
      "subdivision": "ny",
      "operator": "511",
      "product": "signs",
      "name": "511NY message signs (New York)",
      "tier": "authoritative",
      "format": "cars-signs",
      // NYSDOT's dynamic message signs on state highways and what each shows,
      // from the signs list the 511NY data feed access names. It is served
      // without credentials.
      "endpoints": {
        "main": { "url": "https://nyapi.carsprogram.org/signs.json", "cadenceSec": 300 },
      },
      "freshnessWindowSec": 900,
      "coverage": { "countries": ["US-NY"] },
      "license": "LicenseRef-511NY-DAA",
      "licenseUrl": "https://511ny.org/help/24",
      "terms": {
        "url": "https://511ny.org/help/24",
        "reviewedAt": "2026-10-14",
        "redistribution": false,
        "note": "The agreement allows redistribution to the disseminators named in the access request. Set redistribution to true in the local catalogue layer once the approved request names this instance's public API and federation peers. Show the publication time of every report, pass on NYSDOT's disclaimer, and keep NYSDOT informed of changes to the product or its recipients.",
      },
      "attribution": "511NY / New York State DOT",
      "homepage": "https://511ny.org/",
      "privacyUrl": "https://511ny.org/privacy",
      "attributionPolicy": {
        "placement": "visible",
        "surfaces": ["map", "content", "image"],
        "basis": "unresolved",
        "reviewedAt": "2026-10-14",
        "evidenceUrls": [
          "https://511ny.org/help/24",
          "https://api-511x-nysdot.carsprogram.org/cms/helpPages/24",
        ],
        "reason": "Plain source text and expanded disclaimer details conditional; Logo+powered by 511NY is permitted trademark pattern, not universal mandatory duty; Named disseminators and actual approved access scope unresolved; Pass on disclaimer using best efforts; preserve report substance",
      },
    },
    {
      "subdivision": "nyc",
      "operator": "dot",
      "product": "flow",
      "name": "NYC DOT real-time traffic speeds (New York City)",
      "tier": "authoritative",
      "format": "nyc-dot",
      "endpoints": {
        "main": {
          "url": "https://data.cityofnewyork.us/resource/i4gi-tjb9.json?$limit=5000",
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "LicenseRef-NYC-Open-Data",
      "licenseUrl": "https://www.nyc.gov/html/data/terms.html",
      "attribution": "New York City Department of Transportation",
      "privacyUrl": "https://www.nyc.gov/home/privacy-policy.page",
    },
    {
      "subdivision": "oh",
      "operator": "ohgo",
      "product": "flow",
      "name": "OHGO travel delays (Ohio)",
      "tier": "authoritative",
      "format": "ohgo",
      "auth": {
        "kind": "header-key",
        "header": "Authorization",
        "credential": "@us-oh-ohgo.api_key",
        "valuePrefix": "APIKEY ",
      },
      "endpoints": {
        "main": {
          "url": "https://publicapi.ohgo.com/api/v1/travel-delays?page-all=true",
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "LicenseRef-US-Gov-Public-Domain",
      "licenseUrl": "https://www.usa.gov/government-works",
      "attribution": "Ohio Department of Transportation (OHGO)",
      "privacyUrl": "https://www.transportation.ohio.gov/about-us/privacy",
    },
    {
      "subdivision": "oh",
      "operator": "ohgo",
      "qualifier": "construction",
      "product": "events",
      "name": "OHGO construction (Ohio)",
      "tier": "authoritative",
      "format": "ohgo-events",
      "auth": {
        "kind": "header-key",
        "header": "Authorization",
        "credential": "@us-oh-ohgo.api_key",
        "valuePrefix": "APIKEY ",
      },
      "endpoints": {
        "main": {
          // `include-future=true` pulls work zones that have not started yet; the
          // display-side horizon filter decides what a user actually sees.
          "url": "https://publicapi.ohgo.com/api/v1/construction?page-all=true&include-future=true",
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "LicenseRef-US-Gov-Public-Domain",
      "licenseUrl": "https://www.usa.gov/government-works",
      "attribution": "Ohio Department of Transportation (OHGO)",
      "privacyUrl": "https://www.transportation.ohio.gov/about-us/privacy",
    },
    {
      "subdivision": "oh",
      "operator": "ohgo",
      "product": "events",
      "name": "OHGO incidents (Ohio)",
      "tier": "authoritative",
      "format": "ohgo-events",
      "auth": {
        "kind": "header-key",
        "header": "Authorization",
        "credential": "@us-oh-ohgo.api_key",
        "valuePrefix": "APIKEY ",
      },
      "endpoints": {
        "main": {
          "url": "https://publicapi.ohgo.com/api/v1/incidents?page-all=true",
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "LicenseRef-US-Gov-Public-Domain",
      "licenseUrl": "https://www.usa.gov/government-works",
      "attribution": "Ohio Department of Transportation (OHGO)",
      "privacyUrl": "https://www.transportation.ohio.gov/about-us/privacy",
    },
  ],
}
