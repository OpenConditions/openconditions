{
  "$schema": "../schema/roads.schema.json",
  "feeds": [
    {
      // Trafikverket's roadworks and accidents, from the dedicated DATEX II URL
      // endpoint /v2/datex2/{schemaversion}/{namespace}/sit:situation (plain GET,
      // DATEX II v3). The Situation data is split into namespaces; this feed pulls
      // roadworks (roadworks + closures, the bulk) and accident, and the
      // situations feed below takes the other message types from the object API.
      // Auth = the key as ?authenticationkey=. Trafikverket publishes posList in
      // lon-lat order.
      "operator": "trafikverket",
      "product": "events",
      "name": "Trafikverket (Sweden)",
      "tier": "authoritative",
      "format": "datex2",
      "auth": {
        "kind": "query-key",
        "param": "authenticationkey",
        "credential": "@se-trafikverket.api_key",
      },
      "endpoints": {
        "main": {
          "urls": [
            "https://api.trafikinfo.trafikverket.se/v2/datex2/3.1/roadworks/sit:situation",
            "https://api.trafikinfo.trafikverket.se/v2/datex2/3.1/accident/sit:situation",
          ],
          "cadenceSec": 300,
        },
      },
      "posListLonLat": true,
      "freshnessWindowSec": 900,
      "license": "CC0-1.0",
      "licenseUrl": "https://data.trafikverket.se/",
      "attribution": "Trafikverket",
      "privacyUrl": "https://www.trafikverket.se/om-oss/kontakta-oss/om-webbplatsen/sa-hanterar-trafikverket-dataskyddsforordningen-gdpr/",
      "terms": {
        "url": "https://www.trafikverket.se/e-tjanster/trafikverkets-oppna-api-for-trafikinformation/",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: CC0 1.0. \"Acceptera den licens som är knuten till API:t. [link text: \"Licens - senaste versionen\" -> https://creativecommons.org/publicdomain/zero/1.0/deed.sv]\"",
      },
    },
    {
      // The rest of Trafikverket's situations, from the object API's Situation
      // (schema 1.6 in namespace road.trafficinfo; Trafikverket switched off the
      // older versions on 4 March 2026). The DATEX feed above already carries
      // the accident and roadworks datasets, whose deviations are the
      // MessageTypes "Olycka" and "Vägarbete", so this feed takes the other
      // five: ferries (Färjor), obstacles (Hinder), restrictions (Restriktion),
      // traffic messages (Trafikmeddelande) and important traffic information
      // (Viktig trafikinformation). Situations from two feeds are never merged,
      // so the split is what keeps an event from being counted twice. The
      // query's IN filter returns a situation when any of its deviations
      // matches, with all its deviations, so excludeMessageTypes drops the two
      // the DATEX feed carries. The key travels in the POST body; "F&#228;rjor"
      // is "Färjor", written as an XML character reference to keep the body
      // ASCII.
      "operator": "trafikverket",
      "qualifier": "situations",
      "product": "events",
      "name": "Trafikverket situations: ferries, obstacles, restrictions and traffic messages (Sweden)",
      "tier": "authoritative",
      "format": "trafikverket",
      "endpoints": {
        "main": {
          "url": "https://api.trafikinfo.trafikverket.se/v2/data.json",
          "method": "POST",
          "headers": { "Content-Type": "text/xml" },
          "body": "<REQUEST><LOGIN authenticationkey=\"${@se-trafikverket.api_key}\"/><QUERY objecttype=\"Situation\" namespace=\"road.trafficinfo\" schemaversion=\"1.6\"><FILTER><IN name=\"Deviation.MessageType\" value=\"F&#228;rjor,Hinder,Restriktion,Trafikmeddelande,Viktig trafikinformation\"/></FILTER></QUERY></REQUEST>",
          "cadenceSec": 300,
        },
      },
      "excludeMessageTypes": ["Olycka", "Vägarbete"],
      // Times other than ModifiedTime are Swedish local time, documented as
      // carrying no offset unless stated.
      "timezone": "Europe/Stockholm",
      "freshnessWindowSec": 900,
      "license": "CC0-1.0",
      "licenseUrl": "https://data.trafikverket.se/",
      "attribution": "Trafikverket",
      "privacyUrl": "https://www.trafikverket.se/om-oss/kontakta-oss/om-webbplatsen/sa-hanterar-trafikverket-dataskyddsforordningen-gdpr/",
      "terms": {
        "url": "https://www.trafikverket.se/e-tjanster/trafikverkets-oppna-api-for-trafikinformation/",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: CC0 1.0. \"Acceptera den licens som är knuten till API:t. [link text: \"Licens - senaste versionen\" -> https://creativecommons.org/publicdomain/zero/1.0/deed.sv]\"",
      },
    },
    {
      // The TrafficFlow object (speed/flow sensors) lives on the object API, a
      // separate endpoint from the DATEX2 situation feed above. It is queried
      // via a POST XML request body (not a query-key), so the key travels
      // through the body's ${@se-trafikverket.api_key} expansion instead of auth.
      "operator": "trafikverket",
      "product": "flow",
      "name": "Trafikverket traffic flow (Sweden)",
      "tier": "authoritative",
      "format": "trafikverket-flow",
      "endpoints": {
        "main": {
          "url": "https://api.trafikinfo.trafikverket.se/v2/data.json",
          "method": "POST",
          "headers": { "Content-Type": "text/xml" },
          "body": "<REQUEST><LOGIN authenticationkey=\"${@se-trafikverket.api_key}\"/><QUERY objecttype=\"TrafficFlow\" schemaversion=\"1.4\"><INCLUDE>SiteId</INCLUDE><INCLUDE>AverageVehicleSpeed</INCLUDE><INCLUDE>VehicleFlowRate</INCLUDE><INCLUDE>MeasurementTime</INCLUDE><INCLUDE>Geometry.WGS84</INCLUDE></QUERY></REQUEST>",
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "CC0-1.0",
      "licenseUrl": "https://api.trafikinfo.trafikverket.se/",
      "attribution": "Trafikverket",
      "privacyUrl": "https://www.trafikverket.se/om-oss/kontakta-oss/om-webbplatsen/sa-hanterar-trafikverket-dataskyddsforordningen-gdpr/",
      "terms": {
        "url": "https://www.trafikverket.se/e-tjanster/trafikverkets-oppna-api-for-trafikinformation/",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: CC0 1.0. \"Acceptera den licens som är knuten till API:t. [link text: \"Licens - senaste versionen\" -> https://creativecommons.org/publicdomain/zero/1.0/deed.sv]\"",
      },
    },
  ],
}
