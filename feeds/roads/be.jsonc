    {
      "operator": "brussels",
      "product": "events",
      "name": "Bruxelles Mobilité traffic events",
      "tier": "authoritative",
      "format": "geojson",
      // Times are written without an offset, in Brussels time.
      "timezone": "Europe/Brussels",
      "endpoints": {
        "main": {
          "url": "https://data.mobility.brussels/datasets/v1/traffic/collections/traffic_events/items?f=json&limit=1000",
          "cadenceSec": 300,
        },
      },
      "geojson": {
        "idField": "fid",
        "typeField": "datex_codes",
        "typeMap": {
          "RWK": "roadworks",
          "EMR": "public_event",
          "ACC": "accident",
          "JAM": "congestion",
        },
        "defaultType": "other",
        "headlineField": "consequences_fr",
        "roadField": "location_fr",
        "severityField": "importance",
        "severityMap": {
          "0": "low",
          "1": "low",
          "2": "medium",
          "3": "high",
          "4": "critical",
        },
        "updatedField": "last_update",
      },
      "freshnessWindowSec": 900,
      "license": "CC0-1.0",
      "licenseUrl": "https://data.mobility.brussels/",
      "attribution": "Bruxelles Mobilité / Brussel Mobiliteit",
      "privacyUrl": "https://mobilite-mobiliteit.brussels/en/privacy",
      "terms": {
        "url": "https://data.mobility.brussels/datasets/v1/traffic/collections/traffic_events/dcat/",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: CC0. \"\"dct:license\":\"CC0\"\"",
      },
    },
    {
