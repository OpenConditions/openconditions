{
  "$schema": "../schema/roads.schema.json",
  "feeds": [
    {
      // Federal motorway network — enumerated from the Autobahn road index by the
      // catalog resolver, which replaced the bespoke discovery closure. The main
      // endpoint names the index the resolver reads; each road's services are its
      // children. Complements the non-motorway city/state feeds below.
      "operator": "autobahn",
      "product": "events",
      "name": "Autobahn GmbH (Germany)",
      "tier": "authoritative",
      "format": "autobahn",
      "catalog": {
        "resolver": "autobahn-index",
      },
      "endpoints": {
        "main": { "url": "https://verkehr.autobahn.de/o/autobahn/", "cadenceSec": 300 },
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-BY-2.0",
      "attribution": "Quelle: Die Autobahn GmbH des Bundes",
      "privacyUrl": "https://www.autobahn.de/datenschutz",
    },
    {
      "subdivision": "bw",
      "operator": "svzbw",
      "product": "events",
      "name": "MobiData BW roadworks (Baden-Württemberg)",
      "tier": "authoritative",
      "format": "datex2",
      "endpoints": {
        "main": {
          "url": "https://api.mobidata-bw.de/datasets/traffic/roadworks/roadworks_svzbw.datex2.xml",
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-BY-2.0",
      "licenseUrl": "https://www.mobidata-bw.de",
      "attribution": "MobiData BW / Ministerium für Verkehr Baden-Württemberg (SVZ-BW)",
      "privacyUrl": "https://www.mobidata-bw.de/pages/datenschutz",
    },
    {
      "subdivision": "be",
      "operator": "berlin",
      "product": "events",
      "name": "VIZ Berlin roadworks & closures",
      "tier": "authoritative",
      "format": "geojson",
      "endpoints": {
        "main": {
          "url": "https://api.viz.berlin.de/daten/baustellen_sperrungen_viz.json",
          "cadenceSec": 600,
        },
      },
      "geojson": {
        "idField": "id",
        "typeField": "subtype",
        "typeMap": {
          "Baustelle": "roadworks",
          "Bauarbeiten": "roadworks",
          "Sperrung": "road_closure",
          "Störung": "obstruction",
        },
        "defaultType": "other",
        "headlineField": "content",
        "roadField": "street",
        "severityField": "severity",
        "severityMap": {
          "Vollsperrung": "high",
          "Fahrtrichtungssperrung": "medium",
          "keine Sperrung": "low",
        },
        "updatedField": "tstore",
      },
      "freshnessWindowSec": 1800,
      "license": "DL-DE-BY-2.0",
      "licenseUrl": "https://daten.berlin.de/",
      "attribution": "Verkehrsinformationszentrale Berlin (VIZ)",
      "privacyUrl": "https://www.berlin.de/datenschutzerklaerung/",
    },
    {
      // Germany via Mobilithek — one credential-gated DATEX II client-pull feed per
      // region (states + city bundles), all sharing ONE org machine certificate
      // (mtls, the shared mobilithek cert/key) — a new region needs no new credential
      // beyond its subscription id. Each region's comma-separated subscription id
      // fans out one HTTPS client-pull per id (expand). Mobilithek REQUIRES
      // Accept-Encoding: gzip (else HTTP 400) and serves gzipped DATEX II. Licenses
      // are per-region (from the Mobilithek catalog + each publisher's terms); the
      // CC-BY-SA Mobidrom bundle is isolated in its own feed so it never folds into
      // a more permissive source.
      "subdivision": "nw",
      "operator": "verkehr",
      "product": "events",
      "name": "LVZ.NRW (Nordrhein-Westfalen) via Mobilithek",
      "homepage": "https://www.strassen.nrw.de",
      "tier": "authoritative",
      "format": "datex2",
      "credentials": {
        "subscription_id": {
          "title": "NRW (LVZ.NRW) Mobilithek — subscription id(s)",
          "description": "Numeric subscription id(s) from mobilithek.info/organisation/subscriptions (one per subscribed offer, e.g. roadworks 648508602333433856 + incidents 648512079906336768). List multiple comma-separated; the feed fans out one HTTPS client-pull per id. DL-DE-ZERO-2.0.",
        },
      },
      "auth": { "kind": "mtls", "cert": "@mobilithek.cert", "key": "@mobilithek.key" },
      "endpoints": {
        "main": {
          "url": "https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/${subscription_id}/clientPullService?subscriptionID=${subscription_id}",
          "expand": "subscription_id",
          "headers": { "Accept-Encoding": "gzip" },
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-ZERO-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/zero-2-0",
      "attribution": "Landesverkehrszentrale NRW (Straßen.NRW)",
      "privacyUrl": "https://www.strassen.nrw.de/de/datenschutz.html",
    },
    {
      "subdivision": "nw",
      "operator": "duesseldorf",
      "product": "events",
      "name": "Düsseldorf (dmotion) via Mobilithek",
      "homepage": "https://www.duesseldorf.de",
      "tier": "authoritative",
      "format": "datex2",
      "credentials": {
        "subscription_id": {
          "title": "Düsseldorf Mobilithek — subscription id",
          "description": "Subscription id for the Düsseldorf/dmotion offer (110000000002056000). Uses the shared MOBILITHEK_CERT/KEY. DL-DE-ZERO-2.0.",
        },
      },
      "auth": { "kind": "mtls", "cert": "@mobilithek.cert", "key": "@mobilithek.key" },
      "endpoints": {
        "main": {
          "url": "https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/${subscription_id}/clientPullService?subscriptionID=${subscription_id}",
          "expand": "subscription_id",
          "headers": { "Accept-Encoding": "gzip" },
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-ZERO-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/zero-2-0",
      "attribution": "Landeshauptstadt Düsseldorf (dmotion)",
      "privacyUrl": "https://mobilithek.info/datenschutz",
    },
    {
      // Düsseldorf, Köln and Kreis Unna are separate feeds rather than one
      // comma-separated municipal bundle: each carries its own publisher's
      // attribution, each is credentialed on its own, and a city whose
      // subscription lapses no longer takes the others down with it.
      "subdivision": "nw",
      "operator": "koeln",
      "product": "events",
      "name": "Köln via Mobilithek",
      "homepage": "https://www.stadt-koeln.de",
      "tier": "authoritative",
      "format": "datex2",
      "credentials": {
        "subscription_id": {
          "title": "Köln Mobilithek — subscription id(s)",
          "description": "Subscription id(s) for the Köln offers (110000000002900004, 110000000002899004, 110000000003011002). Comma-separated. Uses the shared MOBILITHEK_CERT/KEY. DL-DE-ZERO-2.0.",
        },
      },
      "auth": { "kind": "mtls", "cert": "@mobilithek.cert", "key": "@mobilithek.key" },
      "endpoints": {
        "main": {
          "url": "https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/${subscription_id}/clientPullService?subscriptionID=${subscription_id}",
          "expand": "subscription_id",
          // Köln publishes across three offers; one of them failing should cost that
          // offer's records, not the whole city's.
          "fanout": "tolerant",
          "headers": { "Accept-Encoding": "gzip" },
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-ZERO-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/zero-2-0",
      "attribution": "Stadt Köln",
      "privacyUrl": "https://mobilithek.info/datenschutz",
    },
    {
      "subdivision": "nw",
      "operator": "unna",
      "product": "events",
      "name": "Kreis Unna via Mobilithek",
      "homepage": "https://www.kreis-unna.de",
      "tier": "authoritative",
      "format": "datex2",
      "credentials": {
        "subscription_id": {
          "title": "Kreis Unna Mobilithek — subscription id",
          "description": "Subscription id for the Kreis Unna offer (930448553981730816). Uses the shared MOBILITHEK_CERT/KEY. DL-DE-ZERO-2.0.",
        },
      },
      "auth": { "kind": "mtls", "cert": "@mobilithek.cert", "key": "@mobilithek.key" },
      "endpoints": {
        "main": {
          "url": "https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/${subscription_id}/clientPullService?subscriptionID=${subscription_id}",
          "expand": "subscription_id",
          "headers": { "Accept-Encoding": "gzip" },
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-ZERO-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/zero-2-0",
      "attribution": "Kreis Unna",
      "privacyUrl": "https://mobilithek.info/datenschutz",
    },
    {
      // The city's roadworks information system (BSIS), which publishes each
      // measure three times: as points, street lines and work areas, joined by
      // sdatenid. Only the point layer carries the measure's description and
      // restriction text, and it holds every measure, so the feed reads it
      // alone. Its von/bis are calendar dates (the line layer's times are not
      // in it); `date` is the day of the extract, the same on every record.
      // `symbol` combines the restriction with a status the city updates daily.
      // A full closure stays a roadworks record: its text often lets cyclists
      // and pedestrians through or names only part of a street.
      "subdivision": "nw",
      "operator": "aachen",
      "product": "events",
      "name": "Stadt Aachen roadworks (BSIS)",
      "homepage": "https://offenedaten.aachen.de/dataset/baustellen-stadtgebiet-aachen",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "url": "https://bsis.aachen.de/geoserver/ows?service=WFS&version=2.0.0&request=GetFeature&typeNames=BSIS:PUNKTE_ALLE&outputFormat=application/json&srsName=EPSG:4326",
          "cadenceSec": 1800,
        },
      },
      "geojson": {
        "idField": "sdatenid",
        "typeField": "art",
        "typeMap": {
          "Strassenbau": "roadworks",
          "Autokran+Arbeitsbühne": "roadworks.works",
          "Bauzaun": "roadworks",
          "Baumateriallagerung": "roadworks",
          "Container über 10 cbm": "roadworks",
          "Absperrung einer Fläche": "roadworks",
          "Begrünung": "roadworks.works.tree_work",
          "Beschilderung+Markierung": "roadworks.works.line_marking",
          "Elektrotankstellen": "roadworks.works.construction",
        },
        "defaultType": "roadworks",
        "headlineField": "name",
        "descriptionField": "einschraen",
        "roadField": "strassen",
        "severityField": "symbol",
        "severityMap": {
          "Vollsperrung - aktuell": "high",
          "Vollsperrung - zukünftig": "high",
          "Teilsperrung - aktuell": "medium",
          "Teilsperrung - zukünftig": "medium",
          "starke Verkehrsbehinderung - aktuell": "medium",
          "starke Verkehrsbehinderung - zukünftig": "medium",
          "Verkehrsbehinderung - aktuell": "low",
          "Verkehrsbehinderung - zukünftig": "low",
        },
        "validFromField": "von",
        "validToField": "bis",
        "validityDates": true,
        "filter": [
          {
            "field": "symbol",
            "exclude": [
              "Vollsperrung - abgelaufen",
              "Teilsperrung - abgelaufen",
              "starke Verkehrsbehinderung - abgelaufen",
              "Verkehrsbehinderung - abgelaufen",
            ],
          },
        ],
      },
      "freshnessWindowSec": 7200,
      "license": "DL-DE-BY-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/by-2-0",
      "attribution": "Stadt Aachen",
      "privacyUrl": "https://www.aachen.de/datenschutz",
    },
    {
      // The city's current roadworks view (FB 32) on its ArcGIS Enterprise
      // data portal, behind the "ODP - Baustellenatlas": 10 lines on
      // 2026-10-28, the larger measures only. maxRecordCount 2000, so one
      // request returns everything; outSR=4326 gives lon/lat. OBJECTID equals
      // umleitung_id and is stable. art_sperru is the closure class,
      // art_leistu the work, baustelle the street, bereich the stretch, and
      // hinweis1-3 notes on detours (hinweis1 is read). bbeginn/bende are
      // calendar dates published as epoch ms at 00:00 UTC.
      // The licence asks for "Stadt Cottbus/Chóśebuz" and the year of
      // retrieval in brackets.
      "subdivision": "bb",
      "operator": "cottbus",
      "product": "events",
      "name": "Stadt Cottbus/Chóśebuz roadworks (Baustellenatlas)",
      "homepage": "https://datenportal.cottbus.de/portal/home/item.html?id=3d8fa40a50274da895d8b12611ed7e5c",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "url": "https://datenportal.cottbus.de/server/rest/services/FB32/vw_baustellen_aktuell/FeatureServer/0/query?where=1%3D1&outFields=*&outSR=4326&f=geojson",
          "cadenceSec": 1800,
        },
      },
      "geojson": {
        "idField": "OBJECTID",
        "defaultType": "roadworks",
        "headlineField": "art_leistu",
        "descriptionField": "hinweis1",
        "roadField": "baustelle",
        "severityField": "art_sperru",
        "severityMap": {
          "Vollsperrung": "high",
          "halbseitige Sperrung": "medium",
          "halbseitige Sperrung mit Einbahnstraßenregelung": "medium",
        },
        "validFromField": "bbeginn",
        "validToField": "bende",
        // ArcGIS date fields: days as epochs at midnight UTC; the last day counts.
        "validityDates": true,
      },
      "freshnessWindowSec": 7200,
      "license": "DL-DE-BY-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/by-2-0",
      "attribution": "Stadt Cottbus/Chóśebuz ({year})",
      "privacyUrl": "https://cottbus.de/datenschutz-fur-den-internetauftritt-www-cottbus-de/",
    },
    {
      // The Garten- und Tiefbauamt's roadworks coordination: only the major
      // works on main roads with significant traffic impact, current and
      // future (`ist_zukuenftig`), as work-area polygons (21 on 2026-10-28).
      // MapServer, asked for WGS84 (lon, lat checked). `fid` is the database
      // key; one measure can have two polygons with their own fids.
      // The two records whose bauherr is Autobahn GmbH (the A5 junction
      // Freiburg-Süd) are dropped: the Autobahn GmbH feed carries them.
      // There is no type or restriction class: `verkehrshinweis` is free text
      // (the description) and severity stays unknown. `lage` describes the
      // section ("Zwischen … und …"), not a road name, so no road is set.
      "subdivision": "bw",
      "operator": "freiburg",
      "product": "events",
      "name": "Stadt Freiburg i. Br. roadworks (Garten- und Tiefbauamt)",
      "homepage": "https://geodaten.freiburg.de/geonetwork/srv/ger/catalog.search#/metadata/42e2dbba-5fb2-4146-9fed-181045dc6be4",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "url": "https://geoportal.freiburg.de/wfs/gut_baustellen/gut_baustellen?service=WFS&version=2.0.0&request=GetFeature&typeNames=baustellenumgriffe&outputFormat=GEOJSON&srsName=EPSG:4326",
          "cadenceSec": 1800,
        },
      },
      "geojson": {
        "idField": "fid",
        "defaultType": "roadworks",
        "headlineField": "name",
        "descriptionField": "verkehrshinweis",
        "validFromField": "zeitraum_von",
        "validToField": "zeitraum_bis",
        "validityDates": true,
        "filter": [{ "field": "bauherr", "exclude": ["Autobahn GmbH"] }],
      },
      "freshnessWindowSec": 7200,
      "license": "DL-DE-BY-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/by-2-0",
      "attribution": "Datengrundlage: Stadt Freiburg, www.freiburg.de",
      "privacyUrl": "https://www.freiburg.de/datenschutz",
    },
    {
      // The Tiefbauamt's roadworks, published by the Stadtmessungsamt as two
      // point layers, under construction ("im Bau", 60) and planned
      // ("geplant", 11 on 2026-10-28), read together. Read in the native
      // EPSG:25832, which the payload's `crs` names: asked for WGS84, this
      // GeoServer rounds coordinates to four decimals (about 10 m).
      // The records have no key (the WFS feature id carries the layer name
      // and a row number), so the id hashes the fields that do not change
      // when works start; STATUS and ANFANG are left out.
      // ENDE is a dotted date on 35 of 71 records and otherwise a phrase
      // ("Ende Nov. 2026", "Anfang April 2027"), which should become an open
      // end; ANFANG is always a date. NOTE (2026-10-28): toIsoTimestamp's
      // Date.parse fallback reads these phrases as wrong dates instead
      // ("Ende Dez. 2026" as 1 January 2026), so 14 records look ended; fix
      // that before enabling this feed. VERKEHRSAUSWIRKUNG is free text,
      // nearly unique per record, so it is the description and severity stays
      // unknown. ART_ARBEIT is free text too (36 values), so it is the
      // headline and every record is roadworks.
      "subdivision": "bw",
      "operator": "stuttgart",
      "product": "events",
      "name": "Landeshauptstadt Stuttgart roadworks (Tiefbauamt)",
      "homepage": "https://opendata.stuttgart.de/dataset/b318ff40-616f-4f18-8f3c-80b4b5cdb696",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "urls": [
            "https://geoserver.stuttgart.de/gdc/Verkehr_Mobilitaet/ows?service=WFS&version=1.0.0&request=GetFeature&typeName=Verkehr_Mobilitaet:A66_BAUM_BAUSTELLEN_DATE_WEB_im_Bau_EPSG25832&outputFormat=application/json",
            "https://geoserver.stuttgart.de/gdc/Verkehr_Mobilitaet/ows?service=WFS&version=1.0.0&request=GetFeature&typeName=Verkehr_Mobilitaet:A66_BAUM_BAUSTELLEN_DATE_WEB_geplant_EPSG25832&outputFormat=application/json",
          ],
          "cadenceSec": 1800,
        },
      },
      "geojson": {
        "idFields": [
          "STRASSENNAME",
          "DETAILS_STANDORT",
          "ART_ARBEIT",
          "KOORDINATE_X",
          "KOORDINATE_Y",
        ],
        "defaultType": "roadworks",
        "headlineField": "ART_ARBEIT",
        "descriptionField": "VERKEHRSAUSWIRKUNG",
        "roadField": "STRASSENNAME",
        "validFromField": "ANFANG",
        "validToField": "ENDE",
        "validityDates": true,
      },
      "freshnessWindowSec": 7200,
      "license": "CC-BY-4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "attribution": "Landeshauptstadt Stuttgart",
      "privacyUrl": "https://www.stuttgart.de/datenschutz",
    },
    {
      // The roadworks of the TechnologieRegion Karlsruhe mobility portal, run
      // by the Stadt Karlsruhe Tiefbauamt with TRK: Karlsruhe, Rheinstetten,
      // Bruchsal, Stutensee, Rastatt, Baden-Baden and Ettlingen enter their
      // own works (`datenquelle`). Two catalogued layers, current and
      // planned, are read together: their `id`s do not collide (904 + 451
      // features, no shared id or vorgangsnummer on 2026-10-28), and an item
      // moving from planned to current gets a new id. Asked for WGS84 (lon,
      // lat checked); each request returns all its features. Each works area
      // or line comes with a marker point under the next id, alike in every
      // property; the reader's merge of nearby alike records folds them
      // (1,193 kept features became 581 records, mostly polygons and lines).
      // The Collectivité européenne d'Alsace records (82, French, outside
      // Germany) are dropped; no Autobahn GmbH or MobiData BW records were
      // present. "keine Verkehrsbehinderung" (80) is dropped as no road
      // disruption. A full closure stays roadworks with severity high.
      // The DATEX II file (datex.xml) is not read: its publicationTime was
      // 2026-08-20. The uncatalogued combined layer TBA:baustellen also
      // carries Landau and Gaggenau, outside the dataset's stated scope.
      "subdivision": "bw",
      "operator": "trk",
      "product": "events",
      "name": "TechnologieRegion Karlsruhe roadworks (Mobilitätsportal)",
      "homepage": "https://transparenz.karlsruhe.de/dataset/baustellen",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "urls": [
            "https://mobil.trk.de/geoserver/TBA/ows?service=WFS&version=1.0.0&request=GetFeature&typeName=TBA:baustellen_aktuell&outputFormat=application/json&srsName=EPSG:4326",
            "https://mobil.trk.de/geoserver/TBA/ows?service=WFS&version=1.0.0&request=GetFeature&typeName=TBA:baustellen_vorschau&outputFormat=application/json&srsName=EPSG:4326",
          ],
          "cadenceSec": 1800,
        },
      },
      "geojson": {
        "idField": "id",
        "typeField": "art",
        "typeMap": {
          "Bauliche Sondernutzung": "roadworks",
          "Strom bzw. TK-Versorgung": "roadworks.works.utility_work",
          "Gas bzw. Wasserversorgung": "roadworks.works.utility_work",
          "Fernwärmeversorgung": "roadworks.works.utility_work",
          "Kanalbau": "roadworks.works.utility_work",
          "Gleisbau": "roadworks.works.construction",
          "Straßenbau": "roadworks.works.construction",
          "Haltestellenumbau mit Straßenumgestaltung": "roadworks.works.construction",
          "Stützwand": "roadworks.works.construction",
          "Tunnelbau": "roadworks.works.construction",
          "Straßenunterhaltung": "roadworks.works.maintenance",
          "Tunnelwartung": "roadworks.works.maintenance",
          "Brückenbau": "roadworks.works.bridge_work",
          "Abbruch/Rückbau": "roadworks.works.demolition",
          "Baugrunduntersuchung": "roadworks.works.inspection",
          "Grünpflegearbeiten": "roadworks.works.tree_work",
          "Kraneinsatz": "roadworks.works",
          "geänderte Verkehrsführung im Zuge von Baumaßnahmen": "roadworks",
        },
        "defaultType": "roadworks",
        "headlineField": "lage",
        "descriptionField": "zusatzinfo",
        "severityField": "sperrung",
        "severityMap": {
          "mit Vollsperrung": "high",
          "mit Sperrung in eine Fahrtrichtung": "medium",
          "mit Verkehrsbehinderung": "low",
        },
        "updatedField": "stand",
        "validFromField": "vorgangszeitraum_von",
        "validToField": "vorgangszeitraum_bis",
        "filter": [
          { "field": "datenquelle", "exclude": ["Collectivité européenne d’Alsace"] },
          { "field": "sperrung", "exclude": ["keine Verkehrsbehinderung"] },
        ],
      },
      "freshnessWindowSec": 7200,
      "license": "CC-BY-4.0",
