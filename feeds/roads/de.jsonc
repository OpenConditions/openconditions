          "expand": "subscription_id",
          "headers": { "Accept-Encoding": "gzip" },
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      // Publishes GML in UTM zone 33 with the zone as an easting prefix
      // ("33342865" = zone 33, easting 342865) and declares no srsName, so the
      // raw grid values were being stored as if they were degrees.
      "srsName": "EPSG:5650",
      "license": "LicenseRef-GeoNutzV",
      "licenseUrl": "https://www.gesetze-im-internet.de/geonutzv/",
      "attribution": "Landesamt für Straßenbau und Verkehr Mecklenburg-Vorpommern",
      "privacyUrl": "https://mobilithek.info/datenschutz",
    },
    {
      "subdivision": "ni",
      // Named for the publishing authority rather than for Mobilithek, which is
      // only how the data is delivered — the same reason Hannover sits in its own
      // feed below instead of being credited to the state authority.
