      // Stadt Bochum's roadworks map service (ArcGIS MapServer, an export of
      // the city's Baustellenmanagement database). Each site is published as a
      // midpoint (layer 0) and a street line (layer 2), 178 each on 2026-10-28,
      // one row per site, joined by FID. The feed reads the midpoints: FID is a
      // row number of the export, not a stable id, and the line layer has
      // nothing else that tells a measure's several sites apart (48 line rows
      // repeat another's attributes), while a midpoint's X/Y does; about a
      // quarter of the lines are zero-length anyway. The id hashes the
      // measure number (NUMSTR) and the midpoint. maxRecordCount is 1000, so
      // one request returns everything.
      // BEEINTRAEC lists the restrictions comma-separated (58 combinations);
      // the map below holds every one seen: any carriageway closure is high,
      // half/partial closure, one-way, traffic lights, lane reduction or one
      // carriageway closed is medium, a speed limit or narrowed lane alone is
      // low. 29 records name none (severity unknown). 9 records close only a
      // footway or cycle path and are filtered out. DATUMVON/DATUMBIS are
      // epoch ms at UTC midnight of the calendar date, so a record ends at
      // 01:00 local on its last day (2 records ending today read as ended).
      // The reader's same-feed dedupe folds 21 midpoints of one measure lying
      // within 60 m of each other, so 178 rows give 148 events.
      "subdivision": "nw",
      "operator": "bochum",
      "product": "events",
      "name": "Stadt Bochum roadworks (Baustellenmanagement)",
      "homepage": "https://bochum.opendata.ruhr/dataset/bochum-baustellen",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "url": "https://geoservicekkm.bochum.de/arcgis/rest/services/maponline/Baustellen/MapServer/0/query?where=1%3D1&outFields=*&outSR=4326&f=geojson",
          "cadenceSec": 1800,
        },
      },
      "geojson": {
        "idFields": ["NUMSTR", "X", "Y"],
        "defaultType": "roadworks",
        "headlineField": "MERKMAL",
        "descriptionField": "BEEINTRAEC",
        "roadField": "STANDORT",
        "severityField": "BEEINTRAEC",
        "severityMap": {
          "Vollsperrung Fahrbahn": "high",
          "Vollsperrung Fahrbahn, Vollsperrung Gehweg": "high",
          "Vollsperrung Fahrbahn, Beeinträchtigung ÖPNV, Vollsperrung Gehweg": "high",
          "Vollsperrung Fahrbahn,  Relevant für Pressefilter": "high",
          "Vollsperrung Fahrbahn, Vollsperrung Radweg, Vollsperrung Gehweg": "high",
          "Vollsperrung Fahrbahn, Einsatz Lichtsignalanlage, Halbseitige Sperrung Fahrbahn": "high",
          "Vollsperrung Fahrbahn, teilweise Sperrung Gehweg": "high",
          "Einbahnstraße": "medium",
          "Einsatz Lichtsignalanlage": "medium",
          "Einsatz Lichtsignalanlage, Beschränkung auf 30 km/h": "medium",
