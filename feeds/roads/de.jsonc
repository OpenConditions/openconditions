    {
      // The Tiefbauamt's "Baustellen Bürgerauskunft", exported daily from the
      // city's VMS system to an ArcGIS Online FeatureServer. Layer 1 holds one
      // (Multi)Polygon per permit (AKZ): 455 records for 454 file numbers
      // (2026-10-28). Layer 0 repeats them as 732 points, several per permit,
      // and lacks 16 permits, so the feed reads the areas. maxRecordCount is
      // 2000, so one request returns everything; outSR=4326 gives lon/lat.
      // OBJECTID is renumbered when the hosted layer is overwritten, so the id
      // is the file number with the street (one AKZ, TB 2026/0027-2, appears
      // twice with identical content and folds into one record).
      // DATUM_VON/DATUM_BIS are the first and last day ("Erster/Letzter Tag der
      // Sperrung" in the city's metadata), published as epoch ms at 00:00 UTC.
      // SPUR is the closure class. Filters (2026-10-28): removals (AKZ "U",
      // four spellings of "Umzug - mit Möbelfahrzeug ...", 26 records) and
      // permits whose SPERRUNG names only the footway, a parking strip or lot,
      // a pedestrian zone, a footbridge or a path (25 spellings, 88 records,
      // 6 of them "Vollsperrung" of such a footway) do not restrict traffic.
      // SPERRUNG is free text: a new spelling passes the filter. GRUND, the
      // reason, is free text too (294 values for 455 records), so it is the
      // headline rather than a type. 13 records
      // ended in the past (the export lags a day or two); one runs to 2202.
      "subdivision": "sn",
      "operator": "chemnitz",
      "product": "events",
      "name": "Stadt Chemnitz roadworks (Baustellen Bürgerauskunft)",
      "homepage": "https://portal-chemnitz.opendata.arcgis.com/datasets/baustellen-buergerauskunft",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "url": "https://services6.arcgis.com/jiszdsDupTUO3fSM/arcgis/rest/services/Baustellen_Buergerauskunft/FeatureServer/1/query?where=1%3D1&outFields=*&outSR=4326&f=geojson",
          "cadenceSec": 1800,
        },
      },
      "geojson": {
        "idFields": ["AKZ", "STRASSE"],
        "defaultType": "roadworks",
        "headlineField": "GRUND",
        "descriptionField": "SPERRUNG",
        "roadField": "STRASSE",
        "severityField": "SPUR",
        "severityMap": {
          "Vollsperrung": "high",
          "Verkehrsraumeinschränkung": "low",
        },
        "validFromField": "DATUM_VON",
        "validToField": "DATUM_BIS",
        // ArcGIS date fields: days as epochs at midnight UTC; the last day counts.
        "validityDates": true,
        "filter": [
          {
            "field": "GRUND",
            "exclude": [
              "Umzug  -  mit Möbelfahrzeug (ohne Einsatz Möbellift)",
              "Umzug  -  mit Möbelfahrzeug einschl. Möbellift",
              "Umzug  -   -  mit Möbelfahrzeug einschl. Möbellift",
              "Umzug  -  mit Möbelfahrzeug 1.) einschl. Möbellift/ 2.) ohne Möbellift",
            ],
          },
          {
            "field": "SPERRUNG",
            "exclude": [
              "Fußgänger- und Radbrücke",
              "Fußgängerzone (teilw.)",
              "Gehbahn",
              "Gehbahn (teilw. + vollst.)",
              "Gehbahn (teilw.)",
              "Gehbahn (teilw.)  Fläche: 25 m² + 8m²",
              "Gehbahn (teilw.); Parkplatz",
              "Gehbahn (teilw.); Parkstreifen",
              "Gehbahn (wechselseitig)",
              "Gehbahn Parkstreifen",
              "Gehbahn; Parkstreifen",
              "Gehbahnen (teilw.)",
              "Gehbahnen (teilw.); Parkstreifen",
              "Pakstreifen (teilw.)",
              "Parkfläche",
              "Parkfläche (teilw.)",
              "Parkflächen (teilw.)",
              "Parkplatz",
              "Parkplatz (teilw.)",
              "Parkstreifen",
              "Parkstreifen teilweise",
              "Raf-/ Fußweg (teilw.)",
              "Treppe/ Gebäudedurchgang",
              "Verbindungsweg",
              "Verbindungsweg (teilw.)",
            ],
          },
        ],
      },
      "freshnessWindowSec": 7200,
      "license": "DL-DE-BY-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/by-2-0",
      "attribution": "Stadt Chemnitz",
      "privacyUrl": "https://www.chemnitz.de/de/datenschutz",
    },
    {
      // The Straßen- und Tiefbauamt's traffic restrictions from its permit
      // process for works and events, as the Themenstadtplan shows them
      // ("aktuelle"/"zukünftige Verkehrseinschränkungen"), read from the
      // city's cardo OGC API Features server: L60 holds those valid today
      // (1,078 lines on 2026-10-28), L150 those starting later (132). The two
      // never share a record (L150 starts tomorrow at the earliest). Each line
      // is one section of the city's street network (SKN5): staid (sta_id in
      // L150) is the section key, and there is no street name. The name is in
      // collection L123 (SKN5 Kanten, `schluessel` -> `strasse`; all 1,078
      // keys match), which the reader cannot join.
      // limit=10000 returns every record in one answer (WGS84 lon/lat). The
      // feature `id` is a row number and restarts in each collection, so the
      // id hashes the record's fields; records alike in all of them are
      // repeats with the same geometry (1,078 -> 956 in L60).
      // A record moving from L150 to L60 changes key name and so its id.
      // The *_format dates are a date alone where the time is 00:00
      // ("31.10.2026") and carry the time otherwise ("31.10.2026 23:59"), so
      // under validityDates an end date runs to the end of its day.
      // `typ`: the theme describes seven categories; three occur today.
      "subdivision": "sn",
      "operator": "dresden",
      "product": "events",
      "name": "Landeshauptstadt Dresden traffic restrictions (Verkehrseinschränkungen)",
      "homepage": "https://stadtplan.dresden.de/",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "urls": [
            "https://kommisdd.dresden.de/net4/public/ogcapi/collections/L60/items?f=json&limit=10000",
            "https://kommisdd.dresden.de/net4/public/ogcapi/collections/L150/items?f=json&limit=10000",
          ],
          "cadenceSec": 1800,
        },
      },
      "geojson": {
        "idFields": ["typ", "datum_von", "datum_bis", "sperrgrund_format", "staid", "sta_id"],
        "defaultType": "roadworks",
        "headlineField": "sperrgrund_format",
        "descriptionField": "typ",
        "severityField": "typ",
        "severityMap": {
          "Vollsperrung": "high",
          "Sperrung eines Fahrstreifens; halbseitige Sperrung: Verkehrsregelung durch Verkehrszeichen": "medium",
          "FB-teilweise mit erheblichen Einschränkungen": "medium",
        },
        "validFromField": "datum_von_format",
        "validToField": "datum_bis_format",
        "validityDates": true,
      },
      "freshnessWindowSec": 7200,
      // No licence is stated for these collections: not on the OGC API
      // landing page, collection metadata or the theme description, and the
      // data is not in the city's Open Data portal or on GovData. The city's
      // other kommisdd services listed on GovData are DL-DE-BY-2.0, but the
      // Themenstadtplan's own terms reserve commercial use of individual
      // contents outside the map to the Amt für Geodaten und Kataster.
      "license": "NOASSERTION",
      "terms": {
        "url": "https://stadtplan.dresden.de/content.aspx?method=CopyRight,UsageConstraints,ApplicationContent",
        "reviewedAt": "2026-10-28",
        "note": "No licence on the kommisdd OGC API collections L60/L150, on the Themenstadtplan themes they feed (their copyright section names only 'Datenquelle: … Landeshauptstadt Dresden') or on the city's ArcGIS Online 'Verkehrsbehinderungen' layer. Themenstadtplan terms: commercial use of individual contents (maps, digital data) outside the Themenstadtplan requires contacting the Geoservice of the Amt für Geodaten und Kataster (geoservice@dresden.de). Other Dresden kommisdd services on GovData carry DL-DE-BY-2.0. Ask the Straßen- und Tiefbauamt to publish the layer under DL-DE-BY-2.0.",
      },
      "attribution": "Landeshauptstadt Dresden, Straßen- und Tiefbauamt",
      "disabled": {
        "reason": "no licence stated, and the Themenstadtplan terms reserve commercial use of its digital data",
        "since": "2026-10-28",
      },
      "privacyUrl": "https://www.dresden.de/de/sonstiges/datenschutz.php",
    },
    {
      // The Verkehrs- und Tiefbauamt's register of restrictions of street
      // space, refreshed daily by FME (fme_tstamp). The WFS publishes the same
      // 1,472 records twice, as work-area polygons and as points (identical
      // objectid and properties); the feed reads the polygons, whose shape
      // shows which stretch is taken. GeoServer answers WGS84 lon/lat for
      // srsName=EPSG:4326, and one request returns every record (no feature cap).
      // The register holds every street-space permit: of 1,472 records
      // (2026-10-28), 635 have no sperrart and 435 "geringe Einschränkung" -
      // mostly removals (Umzug), site set-ups and parking-lane permits - and 28
      // close only the footway or cycle path. The filter keeps the 374 whose
      // sperrart restricts traffic (Vollsperrung 93, halbseitige Sperrung 16,
      // Einschränkungen 265), then drops removals (Umzug, 58) and no-parking
      // zones (Haltverbotszone, 2): 314 records. It loses 11 records with no
      // sperrart whose meldung does describe a closure (Straßenbau mostly);
      // the publisher did not classify them. None is expired: the register
      // holds current and future measures only. `meldung` is the placeholder
      // "keine Meldung" on most records.
      "subdivision": "sn",
      "operator": "leipzig",
      "product": "events",
      "name": "Stadt Leipzig traffic space restrictions (Verkehrsraumeinschränkungen)",
      "homepage": "https://opendata.leipzig.de/dataset/verkehrsraumeinschrankungen-polygone-stadt-leipzig",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "url": "https://geodienste.leipzig.de/l3/OpenData/wfs?SERVICE=WFS&VERSION=2.0.0&REQUEST=GetFeature&typeNames=OpenData:verkehrsraumeinschraenkungen&outputFormat=application/json&srsName=EPSG:4326",
          "cadenceSec": 1800,
        },
      },
      "geojson": {
        "idField": "objectid",
        "typeField": "sparte",
        "typeMap": {
          "Straßenbau": "roadworks.works.construction",
          "Gleisbau": "roadworks.works.construction",
          "DB AG Gleisbau": "roadworks.works.construction",
          "Brückenbau": "roadworks.works.bridge_work",
          "Trinkwasser": "roadworks.works.utility_work",
          "Abwasser": "roadworks.works.utility_work",
          "Fernwärme": "roadworks.works.utility_work",
          "Gas": "roadworks.works.utility_work",
          "Strom": "roadworks.works.utility_work",
          "Bahnstrom": "roadworks.works.utility_work",
          "Telekommunikation": "roadworks.works.utility_work",
          "Komplexer Leitungsbau": "roadworks.works.utility_work",
          "Stadtbeleuchtung": "roadworks.works.utility_work",
          "LSA/Koord.kabel": "roadworks.works.utility_work",
          "Begrünung": "roadworks.works.tree_work",
          "ASG Begrünung": "roadworks.works.tree_work",
          "Markierungsarbeiten": "roadworks.works.line_marking",
          "Absicherung Straßenschäden": "roadworks.works.maintenance",
          "Sondernutzung, Baustelleneinr.": "roadworks",
          "Sondernutzung, Kranstellung": "roadworks",
          "Sondernutzung": "roadworks",
          "Hinweisbeschilderung": "roadworks",
          "stationäre Verkehrsregelung": "roadworks",
          "Fahrradständer": "roadworks",
          "Sonstiges": "roadworks",
        },
        "defaultType": "roadworks",
        "headlineField": "sparte",
        "descriptionField": "meldung",
        "roadField": "adresse",
        "severityField": "sperrart",
        "severityMap": {
          "Vollsperrung": "high",
          "halbseitige Sperrung": "medium",
          "Einschränkungen": "low",
        },
        "validFromField": "beginn",
        "validToField": "ende",
        "validityDates": true,
        // Most records say "keine Meldung" (no message) where they have no text.
        "nullValues": ["keine Meldung"],
        "filter": [
          {
            "field": "sperrart",
            "include": ["Vollsperrung", "halbseitige Sperrung", "Einschränkungen"],
          },
          { "field": "sparte", "exclude": ["Umzug", "Haltverbotszone"] },
        ],
      },
      "freshnessWindowSec": 7200,
      "license": "DL-DE-BY-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/by-2-0",
      "attribution": "Stadt Leipzig",
      "privacyUrl": "https://www.leipzig.de/datenschutzerklaerung/",
    },
    {
      // SPERRINFOSYS, Saxony's register of closures lasting a day or more on
      // motorways, federal, state and county roads (municipal roads in part),
      // filled by the traffic authorities of the LASuV, the counties, the
      // county-free cities and the Große Kreisstädte, and published by LISt
      // GmbH as a zip rebuilt daily at about 04:00. It holds two GeoJSON
      // files in EPSG:25833, which each declares (`crs`), so the reader
      // reprojects them: the closures (1,271 lines on 2026-10-28) and the
      // detours (616 lines, the detour routes of 213 closures, sharing their
      // ID - a later addition as detour records). The feed reads the closures.
      // The http URL redirects to https.
      // One closure (ID) is split into several lines with the same fields
      // (942 IDs; only the export time_stamp differs), so the parts share an
      // id. Sperrung_Typ "V" marks events (57: processions, St. Martin), typed
      // public_event. Filter: "Zeitweiliges Halte- oder Parkverbot" (40
      // records, street cleaning) is no road disruption. A third of the dates
      // carry an hour ("10.08.2026  16 Uhr").
      // Overlap: the city feeds hold far more than their authorities enter
      // here - Leipzig VTA 36 lines (in 55 records naming Leipzig), Dresden
      // STA 77 (56 IDs), Chemnitz 30 (28 IDs) - so both are kept; a closure
      // in both appears twice. "Sachsen via Mobilithek" (LASuV DATEX II) is
      // likely the same register but has no credentials in production.
      "subdivision": "sn",
      "operator": "list",
      "product": "events",
      "name": "Freistaat Sachsen closures (SPERRINFOSYS, LISt)",
      "homepage": "https://www.govdata.de/suche/daten/sperrungen-und-umleitungen-sperrinfosys",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "url": "https://www.list.smwa.sachsen.de/gdi/download/baustelleninfo/Baustelleninfo_Sachsen_geojson.zip",
          "unzip": { "entries": "Sperrungen.*\\.geojson$" },
          "cadenceSec": 1800,
        },
      },
      "geojson": {
        "idField": "ID",
        "typeField": "Sperrung_Typ",
        "typeMap": {
          "N": "roadworks",
          "V": "public_event",
        },
        "defaultType": "roadworks",
        "headlineField": "Sperrung_Grund",
        "descriptionField": "Ort",
        "roadField": "Strasse",
        "severityField": "Sperrung_Art_Klartext",
        "severityMap": {
          "Vollsperrung": "high",
          "Sperrung einer Richtungsfahrbahn": "medium",
          "Sperrung einer Fahrtrichtung": "medium",
          "Halbseitige Sperrung": "medium",
          "Sperrung für LKW": "low",
          "Verkehrsbeschränkung": "low",
          "Verkehrssicherung": "low",
        },
        "validFromField": "Sperrung_von",
        "validToField": "Sperrung_bis",
        "validityDates": true,
        "filter": [
          { "field": "Sperrung_Art_Klartext", "exclude": ["Zeitweiliges Halte- oder Parkverbot"] },
        ],
      },
      "freshnessWindowSec": 7200,
      "license": "DL-DE-BY-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/by-2-0",
      "attribution": "Baustelleninformationssystem Freistaat Sachsen",
      "privacyUrl": "https://www.list.sachsen.de/datenschutz.html",
    },
