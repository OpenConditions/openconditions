      "license": "CC-BY-3.0-DE",
      "licenseUrl": "https://creativecommons.org/licenses/by/3.0/de/",
      "attribution": "Stadt Duisburg",
      "privacyUrl": "https://www.duisburg.de/service/datenschutz_67613.php",
