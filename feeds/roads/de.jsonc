      "privacyUrl": "https://mobilithek.info/datenschutz",
    },
    {
      // Police-sourced safety incidents from the Landesmeldestelle für den
      // Verkehrswarndienst (Polizei Hamburg): Stau, Unfall, Sperrung, Baustelle,
      // Wartung — the "police" channel, distinct from the LSBG roadworks feed
      // above. Served openly (DL-DE-BY-2.0) via the api.hamburg.de OGC API
      // Features endpoint as WGS84 GeoJSON points; we use the deduplicated
      // "current filtered main messages" collection. NOT the Mobilithek mirror of
      // this dataset, which is licensed other-closed. The `art` field carries
      // DATEX II situation record class names, mapped below; a management class
      // keeps its measure as its coarse type. Severity is type-derived.
      // No credential: needs no Mobilithek certificate.
      "subdivision": "hh",
      "operator": "polizei",
      "product": "events",
      "name": "Polizei Hamburg traffic incidents (Landesmeldestelle)",
      "tier": "authoritative",
      "format": "geojson",
      "endpoints": {
        "main": {
          "url": "https://api.hamburg.de/datasets/v1/verkehrsinformation/collections/hauptmeldungen_aktuell/items?f=json&limit=5000",
          "cadenceSec": 300,
        },
      },
      "geojson": {
        "idField": "id",
        "typeField": "art",
        "typeMap": {
          "Accident": "incident.accident",
          "VehicleObstruction": "incident.breakdown",
          "GeneralObstruction": "incident.obstruction",
          "EnvironmentalObstruction": "incident.obstruction",
          "InfrastructureDamageObstruction": "incident.obstruction.infrastructure_damage",
          "AbnormalTraffic": "congestion.congestion",
          "MaintenanceWorks": "roadworks.works.maintenance",
          "ConstructionWorks": "roadworks.works.construction",
          "PoorEnvironmentConditions": "weather_condition.weather",
          "PublicEvent": "public_event.event",
          "EquipmentOrSystemFault": "equipment_fault.fault",
          "RoadOrCarriagewayOrLaneManagement": "lane_closure",
          "ReroutingManagement": "detour",
          "SpeedManagement": "speed_restriction",
        },
        "descriptionField": "description",
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-BY-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/by-2-0",
      "attribution": "Freie und Hansestadt Hamburg, Polizei Hamburg",
      "privacyUrl": "https://www.hamburg.de/datenschutz/",
    },
    {
      "subdivision": "he",
