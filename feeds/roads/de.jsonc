{
  "$schema": "../schema/roads.schema.json",
  "feeds": [
    {
      // Federal motorway network — enumerated from the Autobahn road index by the
      // catalog resolver, which replaced the bespoke discovery closure. The main
      // endpoint names the index the resolver reads; each road's services are its
      // children. Complements the non-motorway city/state feeds below.
      "operator": "autobahn",
      "product": "events",
      "name": "Autobahn GmbH (Germany)",
      "tier": "authoritative",
      "format": "autobahn",
      "catalog": {
        "resolver": "autobahn-index",
      },
      "endpoints": {
        "main": { "url": "https://verkehr.autobahn.de/o/autobahn/", "cadenceSec": 300 },
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-BY-2.0",
      "attribution": "Quelle: Die Autobahn GmbH des Bundes",
      "privacyUrl": "https://www.autobahn.de/datenschutz",
    },
    {
      "subdivision": "bw",
      "operator": "svzbw",
      "product": "events",
      "name": "MobiData BW roadworks (Baden-Württemberg)",
      "tier": "authoritative",
      "format": "datex2",
      "endpoints": {
        "main": {
          "url": "https://api.mobidata-bw.de/datasets/traffic/roadworks/roadworks_svzbw.datex2.xml",
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-BY-2.0",
      "licenseUrl": "https://www.mobidata-bw.de",
      "attribution": "MobiData BW / Ministerium für Verkehr Baden-Württemberg (SVZ-BW)",
      "privacyUrl": "https://www.mobidata-bw.de/pages/datenschutz",
    },
    {
      "subdivision": "be",
      "operator": "berlin",
      "product": "events",
      "name": "VIZ Berlin roadworks & closures",
      "tier": "authoritative",
      "format": "geojson",
      "endpoints": {
        "main": {
          "url": "https://api.viz.berlin.de/daten/baustellen_sperrungen_viz.json",
          "cadenceSec": 600,
        },
      },
      "geojson": {
        "idField": "id",
        "typeField": "subtype",
        "typeMap": {
          "Baustelle": "roadworks",
          "Bauarbeiten": "roadworks",
          "Sperrung": "road_closure",
          "Störung": "obstruction",
        },
        "defaultType": "other",
        "headlineField": "content",
        "roadField": "street",
        "severityField": "severity",
        "severityMap": {
          "Vollsperrung": "high",
          "Fahrtrichtungssperrung": "medium",
          "keine Sperrung": "low",
        },
        "updatedField": "tstore",
      },
      "freshnessWindowSec": 1800,
      "license": "DL-DE-BY-2.0",
      "licenseUrl": "https://daten.berlin.de/",
      "attribution": "Verkehrsinformationszentrale Berlin (VIZ)",
      "privacyUrl": "https://www.berlin.de/datenschutzerklaerung/",
    },
    {
      // Germany via Mobilithek — one credential-gated DATEX II client-pull feed per
      // region (states + city bundles), all sharing ONE org machine certificate
      // (mtls, the shared mobilithek cert/key) — a new region needs no new credential
      // beyond its subscription id. Each region's comma-separated subscription id
      // fans out one HTTPS client-pull per id (expand). Mobilithek REQUIRES
      // Accept-Encoding: gzip (else HTTP 400) and serves gzipped DATEX II. Licenses
      // are per-region (from the Mobilithek catalog + each publisher's terms); the
      // CC-BY-SA Mobidrom bundle is isolated in its own feed so it never folds into
      // a more permissive source.
      "subdivision": "nw",
      "operator": "verkehr",
      "product": "events",
      "name": "LVZ.NRW (Nordrhein-Westfalen) via Mobilithek",
      "tier": "authoritative",
      "format": "datex2",
      "credentials": {
        "subscription_id": {
          "title": "NRW (LVZ.NRW) Mobilithek — subscription id(s)",
          "description": "Numeric subscription id(s) from mobilithek.info/organisation/subscriptions (one per subscribed offer, e.g. roadworks 648508602333433856 + incidents 648512079906336768). List multiple comma-separated; the feed fans out one HTTPS client-pull per id. DL-DE-ZERO-2.0.",
        },
      },
      "auth": { "kind": "mtls", "cert": "@mobilithek.cert", "key": "@mobilithek.key" },
      "endpoints": {
        "main": {
          "url": "https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/${subscription_id}/clientPullService?subscriptionID=${subscription_id}",
          "expand": "subscription_id",
          "headers": { "Accept-Encoding": "gzip" },
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-ZERO-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/zero-2-0",
      "attribution": "Landesverkehrszentrale NRW (Straßen.NRW)",
      "privacyUrl": "https://www.strassen.nrw.de/de/datenschutz.html",
    },
    {
      "subdivision": "nw",
      "operator": "duesseldorf",
      "product": "events",
      "name": "Düsseldorf (dmotion) via Mobilithek",
      "tier": "authoritative",
      "format": "datex2",
      "credentials": {
        "subscription_id": {
          "title": "Düsseldorf Mobilithek — subscription id",
          "description": "Subscription id for the Düsseldorf/dmotion offer (110000000002056000). Uses the shared MOBILITHEK_CERT/KEY. DL-DE-ZERO-2.0.",
        },
      },
      "auth": { "kind": "mtls", "cert": "@mobilithek.cert", "key": "@mobilithek.key" },
      "endpoints": {
        "main": {
          "url": "https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/${subscription_id}/clientPullService?subscriptionID=${subscription_id}",
          "expand": "subscription_id",
          "headers": { "Accept-Encoding": "gzip" },
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-ZERO-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/zero-2-0",
      "attribution": "Landeshauptstadt Düsseldorf (dmotion)",
      "privacyUrl": "https://mobilithek.info/datenschutz",
    },
    {
      // Düsseldorf, Köln and Kreis Unna are separate feeds rather than one
      // comma-separated municipal bundle: each carries its own publisher's
      // attribution, each is credentialed on its own, and a city whose
      // subscription lapses no longer takes the others down with it.
      "subdivision": "nw",
      "operator": "koeln",
      "product": "events",
      "name": "Köln via Mobilithek",
      "tier": "authoritative",
      "format": "datex2",
      "credentials": {
        "subscription_id": {
          "title": "Köln Mobilithek — subscription id(s)",
          "description": "Subscription id(s) for the Köln offers (110000000002900004, 110000000002899004, 110000000003011002). Comma-separated. Uses the shared MOBILITHEK_CERT/KEY. DL-DE-ZERO-2.0.",
        },
      },
      "auth": { "kind": "mtls", "cert": "@mobilithek.cert", "key": "@mobilithek.key" },
      "endpoints": {
        "main": {
          "url": "https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/${subscription_id}/clientPullService?subscriptionID=${subscription_id}",
          "expand": "subscription_id",
          // Köln publishes across three offers; one of them failing should cost that
          // offer's records, not the whole city's.
          "fanout": "tolerant",
          "headers": { "Accept-Encoding": "gzip" },
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-ZERO-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/zero-2-0",
      "attribution": "Stadt Köln",
      "privacyUrl": "https://mobilithek.info/datenschutz",
    },
    {
      "subdivision": "nw",
      "operator": "unna",
      "product": "events",
      "name": "Kreis Unna via Mobilithek",
      "tier": "authoritative",
      "format": "datex2",
      "credentials": {
        "subscription_id": {
          "title": "Kreis Unna Mobilithek — subscription id",
          "description": "Subscription id for the Kreis Unna offer (930448553981730816). Uses the shared MOBILITHEK_CERT/KEY. DL-DE-ZERO-2.0.",
        },
      },
      "auth": { "kind": "mtls", "cert": "@mobilithek.cert", "key": "@mobilithek.key" },
      "endpoints": {
        "main": {
          "url": "https://mobilithek.info:8443/mobilithek/api/v1.0/subscription/${subscription_id}/clientPullService?subscriptionID=${subscription_id}",
          "expand": "subscription_id",
          "headers": { "Accept-Encoding": "gzip" },
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "DL-DE-ZERO-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/zero-2-0",
      "attribution": "Kreis Unna",
      "privacyUrl": "https://mobilithek.info/datenschutz",
    },
    {
      // NRW.Mobidrom bundled roadworks — CC-BY-SA (ShareAlike), kept in its own feed
      // so it never folds into a more permissive source.
      "subdivision": "nw",
      "operator": "mobidrom",
      "product": "events",
      "name": "NRW.Mobidrom bundled roadworks via Mobilithek",
