    {
      // The city's roadworks map. The ArcGIS service publishes the measures as
      // one point layer (`Baustellen`) and as line/area layers split into
      // current and planned. Only the point layer carries BaustelleID and the
      // Von/Bis dates, and it holds every measure (146 points against
      // 109 + 10 + 25 + 1 lines/areas, 2026-10-28), so the feed reads it
      // alone. The WFS is read rather than the REST query (f=geojson): the WFS
      // writes Von/Bis as "dd.mm.yyyy" dates, the REST query as epoch ms at
      // UTC midnight, which would end each record an hour into its last day.
      // A handful of Von/Bis values carry an edit time of day; they parse as
      // timestamps. Expired measures are not published. The WFS writes an
      // empty text field as the string "null" (Info_txt in 77 of 146 records),
      // so the description is `Auswirkung`, the restriction text every record
      // carries (as Aachen's `einschraen`). One measure appears twice with
      // the same BaustelleID and content; the id keeps one.
      // `Legende` is the city's own split: full closure (Voll_) or restriction
      // (Einschr_), current (Aktuell) or planned (Zukunft). The free-text
      // `Auswirkung` names "Vollsperrung" in 20 Einschr_ records too;
      // the feed follows Legende, the field the city classifies by.
      // A full closure stays a roadworks record (point geometry, free text).
      "subdivision": "sh",
      "operator": "kiel",
      "product": "events",
      "name": "Landeshauptstadt Kiel roadworks",
      "homepage": "https://opendata.schleswig-holstein.de/dataset/baustellen-in-kiel",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "url": "https://ims.kiel.de/geodatenextern/services/Stadtplan/LHKielWmsWfs/MapServer/WFSServer?request=GetFeature&service=WFS&typeName=Baustellen&outputFormat=geoJSON",
          "cadenceSec": 1800,
          "timeoutSec": 60,
        },
      },
      "geojson": {
        "idField": "BaustelleID",
        "defaultType": "roadworks",
        "headlineField": "Grund",
        "descriptionField": "Auswirkung",
        "roadField": "Strasse",
        "severityField": "Legende",
        "severityMap": {
          "Voll_Aktuell": "high",
          "Voll_Zukunft": "high",
          "Einschr_Aktuell": "low",
          "Einschr_Zukunft": "low",
        },
        "updatedField": "bearbeitet",
        "validFromField": "Von",
        "validToField": "Bis",
        "validityDates": true,
        // The WFS writes empty text fields as the string "null".
        "nullValues": ["null"],
        // Parking-only measures (closed parking bays, no carriageway or
        // footway affected): 7 of 146 records on 2026-10-28. Exact values,
        // since `Auswirkung` is free text; a new wording passes through.
        "filter": [
          {
            "field": "Auswirkung",
            "exclude": [
              "Sperrung Parkplätze",
              "Sperrung Parplätze",
              "Sperrung Parkplatz",
              "Teilweise Sperrung Parkplatz",
              "Sperrung von Behindertenparkplätzen",
              "Wegfall Parkplätze auf dem Seitenstreifen",
            ],
          },
        ],
      },
      "freshnessWindowSec": 7200,
      "license": "CC-BY-4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "attribution": "Landeshauptstadt Kiel, Amt für Bauordnung, Vermessung und Geoinformation",
      "privacyUrl": "https://www.kiel.de/de/_info/datenschutzerklaerung.php",
    },
    {
      // The city's traffic-order register (VMS, the same "SBOD" schema as
      // Aachen's BSIS; Sbod__Sdatenid is Aachen's sdatenid). It publishes each
      // order as a point (`vms:stvkinfoweb`) and as an area (`vms:stvkweb`),
      // 155 records each; the area layer's coordinates are broken (x around
      // -31,000,000), so the feed reads the points. Asked for EPSG:4326, the
      // WFS 2.0 GeoJSON comes back lon/lat. The GeoServer cascades to an
      // internal host that sometimes times out (an OWS exception, not JSON);
      // a retry a minute later succeeded.
      // Beginn/Ende are calendar dates; the times of day sit in separate
      // Beginn_Uhr/Ende_Uhr columns (often empty), so the window is read at
      // day granularity.
      // `Stbl_Ausd` is the order's effect on traffic, mapped like Aachen's
      // `symbol`. `Stsp_Sparte` is the trade doing the work.
      // A full closure stays a roadworks record (point geometry, free text).
      "subdivision": "sh",
      "operator": "norderstedt",
      "product": "events",
      "name": "Stadt Norderstedt roadworks (VMS)",
      "homepage": "https://opendata.schleswig-holstein.de/dataset/baustelleninformation",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
