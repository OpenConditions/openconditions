    {
      // Stadt Dortmund Tiefbauamt on the city's Opendatasoft portal: four
      // datasets, current ("tagesaktuell") and planned ("geplant") works, each
      // as points and as work-area polygons with the same fields. The feed
      // reads the two polygon datasets (the work's extent, 159 + 40 records on
      // 2026-10-28); the point datasets hold the same records. The portal
      // refreshes them nightly (~02:00 UTC). Exports carry no record id, so the
      // id hashes the measure text and its dates; no two records share them,
      // and a planned measure that becomes current keeps its id.
      // `art_der_baumassnahme` is "<street> - <measure> // <restriction>", the
      // restriction free text ("Vollsperrung", "VSP", "halbs. Sp.",
      // "Einengung", 61 spellings; 27 records name none). `einschrankung` is
      // empty on every record. So severity stays unknown and the few
      // footway-only closures ("Gehwegsperrung", ~5) cannot be filtered.
      // von/bis are calendar dates; nothing published is expired. A few
      // long-standing measures (a sinkhole since 2024) end in 2099, 2204 or
      // 2999: open-ended, kept.
      // `auftraggeber` (the client: Dortmunder Netz, Tiefbauamt, private) is
      // the only other text, so it serves as the description.
      "subdivision": "nw",
      "operator": "dortmund",
      "product": "events",
      "name": "Stadt Dortmund roadworks (Tiefbauamt)",
      "homepage": "https://open-data.dortmund.de/explore/dataset/fb66-baustellen-tagesaktuell-flachen/",
      "tier": "authoritative",
      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "urls": [
            "https://open-data.dortmund.de/api/v2/catalog/datasets/fb66-baustellen-tagesaktuell-flachen/exports/geojson",
            "https://open-data.dortmund.de/api/v2/catalog/datasets/fb66-baustellen-geplant-flachen/exports/geojson",
          ],
          "cadenceSec": 1800,
        },
      },
      "geojson": {
        "idFields": ["art_der_baumassnahme", "von", "bis"],
        "defaultType": "roadworks",
        "headlineField": "art_der_baumassnahme",
        "descriptionField": "auftraggeber",
        "validFromField": "von",
        "validToField": "bis",
        "validityDates": true,
        // The restriction is free text after "//" in 61 spellings (Vollsperrung,
        // VSP, halbs. Sp., Fahrbahneinengung …); the restriction field itself is
        // empty everywhere. The first pattern that matches gives the severity.
        "severityField": "art_der_baumassnahme",
        "severityPatterns": [
          {
            "match": "//.*(?:\\bVollsperr(?!ung\\s+Fu)|\\bVollsperung|\\bVSP\\b)",
            "severity": "high",
          },
          {
            "match": "//.*(?:halbs|halbseit|Teilsperr|Einbahn|Spureinzug|Abbiegespur|\\bLSA\\b|Wanderbaustelle)",
            "severity": "medium",
          },
          { "match": "//.*einengung", "severity": "low" },
        ],
        // Closures of the footway alone ("// Gehwegsperrung", "// gehwegsp.").
        "filter": [
          {
            "field": "art_der_baumassnahme",
            "excludeMatching": ["//\\s*(?:teilweise\\s+)?gehwegsp[a-zä.]*(?:\\s+teilw\\.?)?\\s*$"],
          },
        ],
      },
      "freshnessWindowSec": 7200,
      "license": "DL-DE-ZERO-2.0",
      "licenseUrl": "https://www.govdata.de/dl-de/zero-2-0",
      "attribution": "Stadt Dortmund, Tiefbauamt",
      "privacyUrl": "https://open-data.dortmund.de/pages/datenschutzhinweise/",
    },
    {
      // Stadt Duisburg's Verkehrsportal map service (ArcGIS MapServer). Each
