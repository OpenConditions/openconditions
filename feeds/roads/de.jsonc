      "format": "geojson",
      "timezone": "Europe/Berlin",
      "endpoints": {
        "main": {
          "url": "https://geoportal2.duisburg.de/arcgisserver/rest/services/Masterportal/MP_Verkehrsportal/MapServer/3/query?where=1%3D1&outFields=*&outSR=4326&f=geojson",
          "cadenceSec": 1800,
        },
      },
      "geojson": {
        "idField": "OBJECTID",
        "defaultType": "roadworks",
        "headlineField": "ANLASS_TXT_BM",
        "descriptionField": "BESCHREIBUNG",
        "roadField": "BEZEICHNUNG_BM",
        "severityField": "SYMBOL_ID",
        "severityMap": {
          "2": "high",
          "4": "medium",
          "1": "unknown",
        },
        // Start and end only as text in one field ("13.04.26 - 30.10.26").
        "validityRangeField": "BAUZEIT_AB",
        "validityDates": true,
        "filter": [{ "field": "AKTIV", "include": ["1"] }],
