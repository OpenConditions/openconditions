{
  "$schema": "../schema/roads.schema.json",
  "feeds": [
    {
      // Poland GDDKiA road obstructions (utrudnienia). Proprietary XML, WGS84 points,
      // CC0. Use the canonical www.archiwum host: the bare archiwum.gddkia.gov.pl
      // 301/302-redirects (via an http hop) to it, which the bare host's flaky DNS
      // made unreliable. Year-round despite the zima_html (winter) path.
      "operator": "gddkia",
      "product": "events",
      "name": "GDDKiA road obstructions (Poland)",
      "tier": "authoritative",
      "format": "gddkia",
      "endpoints": {
        "main": {
          "url": "https://www.archiwum.gddkia.gov.pl/dane/zima_html/utrdane.xml",
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "CC0-1.0",
      "licenseUrl": "https://dane.gov.pl/",
      "attribution": "GDDKiA",
      "privacyUrl": "https://www.gov.pl/web/gddkia",
      "attributionPolicy": {
        "placement": "visible",
        "surfaces": ["map", "content", "image"],
        "basis": "unresolved",
        "reviewedAt": "2026-10-14",
        "evidenceUrls": [
          "https://www.gov.pl/web/gddkia/ponowne-wykorzystanie-informacji-publicznej",
          "https://drogi.gddkia.gov.pl/informacje-drogowe/lista-utrudnien",
          "https://www.archiwum.gddkia.gov.pl/dane/zima_html/utrdane.xml",
        ],
        "reason": "Exact source rights/placement remain unresolved; generic licence label is not collapse permission",
      },
      "terms": {
        "url": "https://dane.gov.pl/pl/dataset/2752",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: CC0 1.0. \"license_name: \"CC0 1.0\"\"",
      },
    },
  ],
}
