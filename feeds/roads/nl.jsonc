{
  "$schema": "../schema/roads.schema.json",
  "feeds": [
    {
      "operator": "ndw",
      "product": "events",
      "name": "NDW (Netherlands)",
      "tier": "authoritative",
      "format": "datex2",
      // NDW documents lane 1 as the far-left lane, not the one nearest the hard shoulder.
      "laneNumbering": "left_first",
      "endpoints": {
        "main": {
          "url": "https://opendata.ndw.nu/actueel_beeld.xml.gz",
          "gzip": true,
          "cadenceSec": 60,
        },
      },
      // The publisher's current national picture, so absence from an accepted
      // snapshot is a withdrawal and every record is accounted for. Validated
      // structurally against the DATEX II v3 envelope, not by counting records.
      "snapshot": {
        "completeness": "complete",
        "rootElement": "messageContainer",
        "publicationElement": "payload",
        "publicationType": "SituationPublication",
        "recordElement": "situationRecord",
      },
      "freshnessWindowSec": 300,
      "license": "CC0-1.0",
      "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
      // CC0 as published, so the review records evidence and overrides nothing.
      "terms": { "url": "https://www.ndw.nu/service/copyright", "reviewedAt": "2026-09-12" },
      "attribution": "NDW / Rijkswaterstaat",
      "privacyUrl": "https://www.ndw.nu/privacy",
    },
    {
      // Separate source id from the events feed so each poll's write stays
      // source-scoped and the two NDW feeds never withdraw each other's records.
      // The trafficspeed feed carries measurements keyed by site id only; the
      // companion measurement.xml.gz site table supplies each site's geometry.
      "operator": "ndw",
      "product": "flow",
      "name": "NDW traffic speed (Netherlands)",
      "tier": "authoritative",
      "format": "datex2-measured",
      // NDW documents lane 1 as the far-left lane, not the one nearest the hard shoulder.
      "laneNumbering": "left_first",
      "endpoints": {
        "main": {
          "url": "https://opendata.ndw.nu/trafficspeed.xml.gz",
          "gzip": true,
          "cadenceSec": 60,
        },
        "sites": {
          "url": "https://opendata.ndw.nu/measurement.xml.gz",
          "gzip": true,
          "decoder": "datex2-sites",
          "cadenceSec": 21600,
        },
      },
      "freshnessWindowSec": 300,
      "license": "CC0-1.0",
      "licenseUrl": "https://www.ndw.nu",
      "attribution": "NDW / Rijkswaterstaat",
      "privacyUrl": "https://www.ndw.nu/privacy",
    },
  ],
}
