{
  "$schema": "../schema/roads.schema.json",
  "feeds": [
    {
      "operator": "ndw",
      "product": "events",
      "name": "NDW (Netherlands)",
      "tier": "authoritative",
      "format": "datex2",
      // NDW documents lane 1 as the far-left lane, not the one nearest the hard shoulder.
      "laneNumbering": "left_first",
      "endpoints": {
        "main": {
          "url": "https://opendata.ndw.nu/actueel_beeld.xml.gz",
          "gzip": true,
          "cadenceSec": 60,
        },
      },
      // The publisher's current national picture, so absence from an accepted
      // snapshot is a withdrawal and every record is accounted for. Validated
      // structurally against the DATEX II v3 envelope, not by counting records.
      "snapshot": {
        "completeness": "complete",
        "rootElement": "messageContainer",
        "publicationElement": "payload",
        "publicationType": "SituationPublication",
        "recordElement": "situationRecord",
      },
      "freshnessWindowSec": 300,
      "license": "CC0-1.0",
      "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
      // CC0 as published, so the review records evidence and overrides nothing.
      "terms": { "url": "https://www.ndw.nu/service/copyright", "reviewedAt": "2026-09-12" },
      "attribution": "NDW / Rijkswaterstaat",
      "privacyUrl": "https://www.ndw.nu/privacy",
    },
    {
      // Separate source id from the events feed so each poll's write stays
      // source-scoped and the two NDW feeds never withdraw each other's records.
      // NDW retires the v2.3 endpoints on 2027-02-09. The v3.6 pair keeps
      // source/site/channel ids stable; the table supplies indexed metadata.
      "operator": "ndw",
      "product": "flow",
      "name": "NDW traffic speed (Netherlands)",
      "tier": "authoritative",
      "format": "datex2-measured",
      // NDW documents lane 1 as the far-left lane, not the one nearest the hard shoulder.
      "laneNumbering": "left_first",
      "endpoints": {
        "main": {
          "url": "https://opendata.ndw.nu/snelheden_en_intensiteiten_meetgegevens.xml.gz",
          "gzip": true,
          // NDW publishes one-minute averages, but segment speeds are rebuilt
          // every five minutes. Polling every minute rewrote about 175 000
          // latest readings a minute, most of the database's disk writes.
          "cadenceSec": 300,
        },
        "sites": {
          "url": "https://opendata.ndw.nu/snelheden_en_intensiteiten_configuratie_meetlocaties.xml.gz",
          "gzip": true,
          "decoder": "datex2-sites",
          // V3 revises individual sites under a table version of "latest".
          // Refresh alongside measurements; mismatched site versions are withheld.
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "CC0-1.0",
      "licenseUrl": "https://www.ndw.nu",
      "attribution": "NDW / Rijkswaterstaat",
      "privacyUrl": "https://www.ndw.nu/privacy",
      "terms": {
        "url": "https://ntm.ndw.nu/publicaties/ef10b6e4-84ea-468b-aca8-9a8bbdd30a73",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: CC0 1.0. \"\"termsOfService\": {\"type\": \"LICENSE_ACCORDING_CREATIVE_COMMONS\", \"url\": \"https://creativecommons.org/publicdomain/zero/1.0/deed.nl\"}\"",
      },
    },
  ],
}
