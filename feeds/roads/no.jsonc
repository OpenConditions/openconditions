{
  "$schema": "../schema/roads.schema.json",
  "feeds": [
    {
      "operator": "vegvesen",
      "product": "events",
      "name": "Statens vegvesen (Norway)",
      "tier": "authoritative",
      "format": "datex2",
      "auth": { "kind": "basic", "user": "@no-vegvesen.user", "password": "@no-vegvesen.password" },
      "endpoints": {
        "main": {
          "url": "https://datex-server-get-v3-1.atlas.vegvesen.no/datexapi/GetSituation/pullSnapshotData",
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 900,
      "license": "NLOD-2.0",
      "licenseUrl": "https://data.norge.no/nlod/en/2.0",
      "attribution": "Statens vegvesen",
      "privacyUrl": "https://www.vegvesen.no/en/about-us/about-the-organisation/privacy-policy-and-cookies/",
      "terms": {
        "url": "https://dataut.vegvesen.no/dataset/trafikkmeldinger",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: Norsk lisens for offentlige data (NLOD). \"\"title\": \"Trafikkmeldinger\", \"license_title\": \"Norsk lisens for offentlige data (NLOD)\", \"license_url\": \"https://data.norge.no/nlod/no\"\"",
      },
    },
    {
      // Measured traffic data (speed/volume) joined to the MeasurementSiteTable for
      // geometry. Shares the same free vegvesen DATEX account as the events feed
      // above, so it runs whenever those credentials are set.
      "operator": "vegvesen",
      "product": "flow",
      "name": "Statens vegvesen traffic speed (Norway)",
      "tier": "authoritative",
      "format": "datex2-measured",
      "auth": { "kind": "basic", "user": "@no-vegvesen.user", "password": "@no-vegvesen.password" },
      "endpoints": {
        "main": {
          "url": "https://datex-server-get-v3-1.atlas.vegvesen.no/datexapi/GetMeasuredData/pullSnapshotData",
          "cadenceSec": 300,
        },
        "sites": {
          "url": "https://datex-server-get-v3-1.atlas.vegvesen.no/datexapi/GetMeasurementSiteTable/pullSnapshotData",
          "decoder": "datex2-sites",
          "cadenceSec": 21600,
        },
      },
      "freshnessWindowSec": 900,
      "license": "NLOD-2.0",
      "licenseUrl": "https://data.norge.no/nlod/en/2.0",
      "attribution": "Statens vegvesen",
      "privacyUrl": "https://www.vegvesen.no/en/about-us/about-the-organisation/privacy-policy-and-cookies/",
      "terms": {
        "url": "https://www.vegvesen.no/fag/teknologi/apne-data/et-utvalg-apne-data/hva-er-datex",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: Norsk lisens for offentlige data (NLOD). \"DATEX-tjenesten er tilgjengelig for media, ulike tilbydere av trafikkinformasjon og andre aktører som er interesserte i å benytte informasjon fra Statens vegvesen i egne tjenester. Bruken er regulert av norsk lisens for offentlige data .\"",
      },
    },
  ],
}
