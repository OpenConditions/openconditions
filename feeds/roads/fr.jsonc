{
  "$schema": "../schema/roads.schema.json",
  "feeds": [
    {
      "operator": "dir",
      "product": "events",
      "name": "DIR / Bison Futé (France national roads)",
      "tier": "authoritative",
      "format": "datex2",
      "endpoints": {
        "main": {
          "url": "https://transport.data.gouv.fr/resources/79174/download",
          "cadenceSec": 600,
        },
      },
      "freshnessWindowSec": 1800,
      "snapshot": {
        "completeness": "complete",
        "rootElement": "d2LogicalModel",
        "publicationElement": "payloadPublication",
        "publicationType": "SituationPublication",
        "recordElement": "situationRecord",
      },
      "license": "etalab-2.0",
      "licenseUrl": "https://www.etalab.gouv.fr/licence-ouverte-open-licence",
      // Licence Ouverte 2.0 as published, so the review records evidence and
      // overrides nothing.
      "terms": {
        "url": "https://www.data.gouv.fr/pages/legal/licences/etalab-2.0",
        "reviewedAt": "2026-09-11",
        "note": "Reviewed against transport.data.gouv.fr dataset 10760.",
      },
      "attribution": "DIR / Bison Futé",
      "privacyUrl": "https://www.bison-fute.gouv.fr/",
    },
    {
      "operator": "dir",
      "product": "flow",
      "name": "Circulation temps réel — vitesses & débits (France)",
      "tier": "authoritative",
      "format": "datex2-measured",
      "endpoints": {
        "main": {
          // The transport.data.gouv.fr /download link 302-chains to an HTTP endpoint,
          // which the streaming measured-data fetch can't follow; point straight at the
          // publisher's HTTPS file (the resolved target of resource 79165).
          "url": "https://tipi.bison-fute.gouv.fr/bison-fute-ouvert/publicationsDIR/QTV-DIR/qtvDir.xml",
          "cadenceSec": 360,
        },
        "sites": {
          "url": "https://tipi.bison-fute.gouv.fr/bison-fute-ouvert/publicationsDIR/QTV-DIR/refDir.csv",
          "decoder": "france-comptage-csv",
          "cadenceSec": 21600,
        },
      },
      "freshnessWindowSec": 1200,
      "license": "etalab-2.0",
      "licenseUrl": "https://www.etalab.gouv.fr/licence-ouverte-open-licence",
      "attribution": "Ministère de la Transition écologique / DIR",
      "privacyUrl": "https://www.bison-fute.gouv.fr/",
      "terms": {
        "url": "https://transport.data.gouv.fr/datasets/etat-de-circulation-en-temps-reel-sur-le-reseau-national-routier-non-concede",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: Licence Ouverte v2.0. \"\"licence\": \"lov2\" (dataset \"Circulation en temps réel - Réseau routier non concédé\", resource 79165 \"Vitesses moyennes et débits\", original_url \"http://tipi.bison-fute.gouv.fr/bison-fute-ouvert/publicationsDIR/QTV-DIR/qtvDir.xml\")\"",
      },
    },
    {
      "operator": "rennesmetropole",
      "product": "flow",
      "name": "État du trafic temps réel (Rennes Métropole)",
      "tier": "authoritative",
      "format": "geojson-flow",
      "endpoints": {
        "main": {
          // OpenDataSoft export delivers every segment in one call (no pagination),
          // each feature carrying an inline LineString plus a measured average speed,
          // the posted max speed (native free-flow) and a DATEX traffic status.
          "url": "https://data.rennesmetropole.fr/api/explore/v2.1/catalog/datasets/etat-du-trafic-en-temps-reel/exports/geojson?limit=-1",
          "cadenceSec": 180,
        },
      },
      "flowMap": {
        "idField": "predefinedlocationreference",
        "speedField": "averagevehiclespeed",
        "freeFlowField": "vitesse_maxi",
        "statusField": "trafficstatus",
        "updatedField": "datetime",
      },
      "freshnessWindowSec": 900,
      "license": "ODbL-1.0",
      "licenseUrl": "https://opendatacommons.org/licenses/odbl/1-0/",
      "attribution": "Rennes Métropole",
      "privacyUrl": "https://data.rennesmetropole.fr/pages/donnees-personnelles/",
      "terms": {
        "url": "https://data.rennesmetropole.fr/api/explore/v2.1/catalog/datasets/etat-du-trafic-en-temps-reel",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: Open Database License (ODbL). \"\"license\": \"Open Database License (ODbL)\", \"license_url\": \"http://opendatacommons.org/licenses/odbl/\", \"publisher\": \"Rennes Métropole\"\"",
      },
    },
    {
      "operator": "bordeauxmetropole",
      "product": "flow",
      "name": "État du trafic temps réel (Bordeaux Métropole)",
      "tier": "authoritative",
      "format": "geojson-flow",
      "endpoints": {
        "main": {
          // Categorical congestion status only (no measured speed): FLUIDE / DENSE /
          // EMBOUTEILLE, mapped to DATEX status tokens the shared flow builder derives
          // level-of-service from.
          "url": "https://opendata.bordeaux-metropole.fr/api/explore/v2.1/catalog/datasets/ci_trafi_l/exports/geojson?limit=-1",
          "cadenceSec": 300,
        },
      },
      "flowMap": {
        "idField": "ident",
        "statusField": "etat",
        "statusMap": {
          "FLUIDE": "freeFlow",
          "DENSE": "heavy",
          "EMBOUTEILLE": "congested",
          "INCONNU": "unknown",
        },
        "updatedField": "mdate",
      },
      "freshnessWindowSec": 1200,
      "license": "LicenseRef-Licence-Ouverte-1.0",
      "licenseUrl": "https://www.etalab.gouv.fr/wp-content/uploads/2014/05/Licence_Ouverte.pdf",
      "attribution": "Bordeaux Métropole",
      "privacyUrl": "https://opendata.bordeaux-metropole.fr/pages/donnees-personnelles/",
      "terms": {
        "url": "https://opendata.bordeaux-metropole.fr/api/explore/v2.1/catalog/datasets/ci_trafi_l",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: Licence Ouverte / Open Licence v1.0 (Etalab 2011), not the formerly declared licence. \"\"license\": \"Licence Ouverte\", \"license_url\": \"https://www.etalab.gouv.fr/wp-content/uploads/2014/05/Licence_Ouverte.pdf\"\"",
      },
    },
  ],
}
