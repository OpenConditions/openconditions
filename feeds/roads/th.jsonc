{
  "$schema": "../schema/roads.schema.json",
  "feeds": [
    {
      "operator": "longdo",
      "product": "events",
      "name": "Longdo Traffic Events (Thailand)",
      "tier": "aggregator",
      "format": "flatjson",
      // Times are written without an offset (`2026-10-11 03:53:30`), in Bangkok time.
      "timezone": "Asia/Bangkok",
      "endpoints": {
        "main": { "url": "https://event.longdo.com/feed/json", "cadenceSec": 300 },
      },
      "geojson": {
        "lonField": "longitude",
        "latField": "latitude",
        "idField": "eid",
        "typeField": "type",
        "typeMap": {
          "3": "accident",
        },
        "defaultType": "other",
        "headlineField": "title_en",
        "descriptionField": "description_en",
        "updatedField": "start",
        // An incident's progress ("the car was moved") is a new record beside
        // the original, its Thai title opening คืบหน้า ("progress"); the English
        // text marks only some of them.
        "followUp": { "field": "title", "prefixes": ["คืบหน้า"] },
      },
      "freshnessWindowSec": 900,
      "license": "CC-BY-4.0",
      "licenseUrl": "https://www.longdo.com/",
      "attribution": "Longdo Traffic / iTIC Foundation",
      "privacyUrl": "https://map.longdo.com/",
      "attributionPolicy": {
        "placement": "visible",
        "surfaces": ["map", "content", "image"],
        "basis": "unresolved",
        "reviewedAt": "2026-10-14",
        "evidenceUrls": [
          "https://event.longdo.com/",
          "https://event.longdo.com/feed/json",
          "https://traffic.longdo.com/feed/api.php",
          "https://map.longdo.com/api/terms",
        ],
        "reason": "Exact source rights/placement remain unresolved; generic licence label is not collapse permission",
      },
    },
  ],
}
