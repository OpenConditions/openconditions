{
  "$schema": "../schema/roads.schema.json",
  "feeds": [
    {
      "operator": "dgt",
      "product": "events",
      "name": "DGT (Spain)",
      "tier": "authoritative",
      "format": "datex2",
      "endpoints": {
        "main": {
          "url": "https://nap.dgt.es/datex2/v3/dgt/SituationPublication/datex2_v36.xml",
          "cadenceSec": 120,
        },
      },
      "freshnessWindowSec": 600,
      "license": "CC-BY-4.0",
      "licenseUrl": "https://nap.dgt.es",
      "attribution": "Dirección General de Tráfico (DGT)",
      "privacyUrl": "https://www.dgt.es/protecciondedatos/",
      "attributionPolicy": {
        "placement": "visible",
        "surfaces": ["map", "content", "image"],
        "basis": "unresolved",
        "reviewedAt": "2026-10-14",
        "evidenceUrls": [
          "https://nap.dgt.es/dataset/incidencias-dgt-datex2-v3-7",
          "https://nap.dgt.es/dataset/camaras-dgt-datex2-v3-7",
          "https://nap.dgt.es/dataset/puntos-de-recarga-electrica-para-vehiculos",
          "https://www.dgt.es/contenido/aviso-legal/",
        ],
        "reason": "Exact source rights/placement remain unresolved; generic licence label is not collapse permission",
      },
      "terms": {
        "url": "https://nap.dgt.es/dataset/incidencias-dgt-datex2-v3-7",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: Creative Commons Attribution (version not stated). \"Tipo de Licencia Licence and Free of charge Términos de Uso https://www.dgt.es/contenido/aviso-legal/ … Licencia Creative Commons Attribution\"",
      },
    },
    {
      "operator": "madrid",
      "product": "flow",
      "name": "Madrid INFORMO traffic (Spain)",
      "tier": "authoritative",
      "format": "informo",
      "endpoints": {
        "main": { "url": "https://informo.madrid.es/informo/tmadrid/pm.xml", "cadenceSec": 300 },
      },
      "freshnessWindowSec": 900,
      "license": "CC-BY-4.0",
      "licenseUrl": "https://datos.madrid.es/egob/catalogo/aviso-legal",
      "attribution": "Ayuntamiento de Madrid",
      "privacyUrl": "https://www.madrid.es/portal/site/munimadrid/menuitem.privacy",
      "terms": {
        "url": "https://datos.madrid.es/api/3/action/package_show?id=202087-0-trafico-intensidad",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: CC BY 4.0. \"\"license_id\": \"cc-by\", \"license_title\": \"Creative Commons Attribution 4.0 International (CC BY 4.0)\"\"",
      },
    },
    {
      "subdivision": "bcn",
      "operator": "ajuntament",
      "product": "flow",
      "name": "Estat del trànsit TRAMS (Barcelona)",
      "tier": "authoritative",
      "format": "bcn-trams",
      // Live status file: one `#`-delimited row per segment
      // (tramId#YYYYMMDDHHMMSS#estatActual#estatPrevist15min) on a 0-6 congestion
      // scale. Categorical only (no speed). The segment geometry lives in a
      // separate long-format CSV dictionary, joined by tram id via the station
      // registry below.
      "endpoints": {
        "main": {
          "url": "https://opendata-ajuntament.barcelona.cat/data/dataset/8319c2b1-4c21-4962-9acd-6db4c5ff1148/resource/2d456eb5-4ea6-4f68-9794-2f3f1a58a933/download",
          "cadenceSec": 300,
          // The portal takes 60-70 s to answer a download (measured October 2026).
          "timeoutSec": 180,
        },
        "sites": {
          "url": "https://opendata-ajuntament.barcelona.cat/data/dataset/0e3b6840-7dff-4731-a556-44fac28a7873/resource/c97072a3-3619-4547-84dd-f1999d2a3fec/download/transit_relacio_trams_format_long.csv",
          "decoder": "bcn-trams-csv",
          "cadenceSec": 21600,
          "timeoutSec": 180,
        },
      },
      "freshnessWindowSec": 900,
      "license": "CC-BY-4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "attribution": "Ajuntament de Barcelona",
      "privacyUrl": "https://www.barcelona.cat/en/privacy-policy",
      "terms": {
        "url": "https://opendata-ajuntament.barcelona.cat/data/api/3/action/package_show?id=trams",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: CC BY 4.0. \"\"license_id\": \"CC-BY-4.0\", \"license_title\": \"Creative Commons Attribution 4.0\"\"",
      },
    },
  ],
}
