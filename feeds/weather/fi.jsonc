{
  "$schema": "../schema/weather.schema.json",
  "feeds": [
    {
      "operator": "digitraffic",
      "product": "weather",
      "name": "Fintraffic Digitraffic road weather stations",
      "tier": "authoritative",
      "format": "digitraffic-weather",
      // The v2 station list, each station's details (names, road,
      // municipality: one call per station, about 530), and every station's
      // latest sensor values. v1 is deprecated and announced for removal
      // after 2027-04-13. Stations collect every five minutes and the API
      // caches answers for a minute. Without accepted compression the API
      // answers 406, and the user header raises its per-IP limit.
      "endpoints": {
        "sites": {
          "url": "https://tie.digitraffic.fi/api/weather/v2/stations",
          "headers": { "Digitraffic-User": "OpenConditions/1.0", "Accept-Encoding": "gzip" },
          "cadenceSec": 86400,
        },
        "details": {
          "url": "https://tie.digitraffic.fi/api/weather/v2/stations/{item}",
          "each": { "role": "sites", "records": "features", "field": "id" },
          "fanout": "tolerant",
          "headers": { "Digitraffic-User": "OpenConditions/1.0", "Accept-Encoding": "gzip" },
          "cadenceSec": 86400,
        },
        "status": {
          "url": "https://tie.digitraffic.fi/api/weather/v2/stations/data",
          "headers": { "Digitraffic-User": "OpenConditions/1.0", "Accept-Encoding": "gzip" },
          "cadenceSec": 300,
        },
      },
      "snapshot": { "completeness": "complete" },
      "freshnessWindowSec": 900,
      "requestLimits": { "perMinute": 60 },
      "license": "CC-BY-4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      // The publisher grants CC BY 4.0 as published, so the review records
      // evidence and overrides nothing.
      "terms": {
        "url": "https://www.digitraffic.fi/en/terms-of-service/",
        "reviewedAt": "2026-10-15",
      },
      "attribution": "Source: Fintraffic / digitraffic.fi, license CC 4.0 BY",
      "homepage": "https://www.digitraffic.fi/en/",
      "privacyUrl": "https://www.digitraffic.fi/en/privacy-policy/",
    },
  ],
}
