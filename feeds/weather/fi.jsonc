{
  "$schema": "../schema/weather.schema.json",
  "feeds": [
    {
      "operator": "digitraffic",
      "product": "weather",
      "name": "Fintraffic Digitraffic road weather stations",
      "tier": "authoritative",
      "format": "digitraffic-weather",
      // The v2 station list, each station's details (names, road,
      // municipality: one call per station, about 530), and every station's
      // latest sensor values. v1 is deprecated and announced for removal
      // after 2027-04-13. Stations collect every five minutes and the API
      // caches answers for a minute. Without accepted compression the API
      // answers 406, and the user header raises its per-IP limit. The list
      // carries each station's maintenance state, so it is read hourly: about
      // 21 kB, or a 304 when nothing changed. The details stay daily.
      "endpoints": {
        "sites": {
          "url": "https://tie.digitraffic.fi/api/weather/v2/stations",
          "headers": { "Digitraffic-User": "OpenConditions/1.0", "Accept-Encoding": "gzip" },
          "cadenceSec": 3600,
        },
        "details": {
          "url": "https://tie.digitraffic.fi/api/weather/v2/stations/{item}",
          "each": { "role": "sites", "records": "features", "field": "id" },
          "fanout": "tolerant",
          "headers": { "Digitraffic-User": "OpenConditions/1.0", "Accept-Encoding": "gzip" },
          "cadenceSec": 86400,
        },
        "status": {
          "url": "https://tie.digitraffic.fi/api/weather/v2/stations/data",
          "headers": { "Digitraffic-User": "OpenConditions/1.0", "Accept-Encoding": "gzip" },
          "cadenceSec": 300,
        },
      },
      "snapshot": { "completeness": "complete" },
      "freshnessWindowSec": 900,
      "requestLimits": { "perMinute": 60 },
      "license": "CC-BY-4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      // The publisher grants CC BY 4.0 as published, so the review records
      // evidence and overrides nothing.
      "terms": {
        "url": "https://www.digitraffic.fi/en/terms-of-service/",
        "reviewedAt": "2026-10-15",
      },
      "attribution": "Source: Fintraffic / digitraffic.fi, license CC 4.0 BY",
      "homepage": "https://www.digitraffic.fi/en/",
      "privacyUrl": "https://www.digitraffic.fi/en/privacy-policy/",
    },
    {
      "operator": "fmi",
      "product": "weather",
      "name": "Finnish Meteorological Institute weather observations",
      "tier": "authoritative",
      "format": "fmi-weather",
      "endpoints": {
        "sites": {
          "urls": [
            "https://opendata.fmi.fi/wfs?service=WFS&version=2.0.0&request=GetFeature&storedquery_id=fmi::ef::stations&networkid=121",
            "https://opendata.fmi.fi/wfs?service=WFS&version=2.0.0&request=GetFeature&storedquery_id=fmi::ef::stations&networkid=122",
            "https://opendata.fmi.fi/wfs?service=WFS&version=2.0.0&request=GetFeature&storedquery_id=fmi::ef::stations&networkid=224",
          ],
          "cadenceSec": 86400,
        },
        "status": {
          "url": "https://opendata.fmi.fi/wfs?service=WFS&version=2.0.0&request=GetFeature&storedquery_id=fmi::observations::weather::multipointcoverage&bbox=19,59,32,70,epsg:4326&starttime={utcMinute-90}&endtime={utcMinute}&timestep=10&parameters=t2m,td,rh,ws_10min,wg_10min,wd_10min,vis&crs=EPSG::4326",
          "cadenceSec": 600,
        },
      },
      "freshnessWindowSec": 3600,
      "requestLimits": {
        "perMinute": 60,
        "perDay": 20000,
      },
      "license": "CC-BY-4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "terms": {
        "url": "https://en.ilmatieteenlaitos.fi/open-data-licence",
        "reviewedAt": "2026-11-07",
      },
      "attribution": "Finnish Meteorological Institute; weather observations; normalized by OpenConditions; CC BY 4.0.",
      "homepage": "https://en.ilmatieteenlaitos.fi/",
      "privacyUrl": "https://en.ilmatieteenlaitos.fi/data-protection",
      "coverage": {
        "countries": ["FI"],
      },
      "disabled": {
        "reason": "National bbox/body limits and Finnish meteorological metadata membership remain unqualified; acquisition is also blocked in the format.",
        "since": "2026-11-07",
      },
    },
  ],
}
