{
  "$schema": "../schema/weather.schema.json",
  "feeds": [
    {
      "operator": "dwd",
      "qualifier": "cdc",
      "product": "weather",
      "name": "DWD CDC current meteorological station observations",
      "tier": "authoritative",
      "format": "dwd-cdc-10min",
      "endpoints": {
        "tu_stations": {
          "url": "https://opendata.dwd.de/climate_environment/CDC/observations_germany/climate/10_minutes/air_temperature/now/zehn_now_tu_Beschreibung_Stationen.txt",
          "cadenceSec": 86400,
          "timeoutSec": 30,
        },
        "tu_listing": {
          "url": "https://opendata.dwd.de/climate_environment/CDC/observations_germany/climate/10_minutes/air_temperature/now/",
          "cadenceSec": 3600,
          "timeoutSec": 30,
        },
        "tu": {
          "url": "{item}",
          "each": {
            "role": "tu_listing",
            "links": ["href=\"(10minutenwerte_TU_\\d{5}_now\\.zip)\"[^\\n]*?</a>\\s+([^\\r\\n]+)"],
            "revalidateSec": 3600,
            "maxItems": 1600,
          },
          "cadenceSec": 3600,
          "timeoutSec": 30,
        },
        "rr_stations": {
          "url": "https://opendata.dwd.de/climate_environment/CDC/observations_germany/climate/10_minutes/precipitation/now/zehn_now_rr_Beschreibung_Stationen.txt",
          "cadenceSec": 86400,
          "timeoutSec": 30,
        },
        "rr_listing": {
          "url": "https://opendata.dwd.de/climate_environment/CDC/observations_germany/climate/10_minutes/precipitation/now/",
          "cadenceSec": 3600,
          "timeoutSec": 30,
        },
        "rr": {
          "url": "{item}",
          "each": {
            "role": "rr_listing",
            "links": [
              "href=\"(10minutenwerte_nieder_\\d{5}_now\\.zip)\"[^\\n]*?</a>\\s+([^\\r\\n]+)",
            ],
            "revalidateSec": 3600,
            "maxItems": 1600,
          },
          "cadenceSec": 3600,
          "timeoutSec": 30,
        },
        "ff_stations": {
          "url": "https://opendata.dwd.de/climate_environment/CDC/observations_germany/climate/10_minutes/wind/now/zehn_now_ff_Beschreibung_Stationen.txt",
          "cadenceSec": 86400,
          "timeoutSec": 30,
        },
        "ff_listing": {
          "url": "https://opendata.dwd.de/climate_environment/CDC/observations_germany/climate/10_minutes/wind/now/",
          "cadenceSec": 3600,
          "timeoutSec": 30,
        },
        "ff": {
          "url": "{item}",
          "each": {
            "role": "ff_listing",
            "links": [
              "href=\"(10minutenwerte_wind_\\d{5}_now\\.zip)\"[^\\n]*?</a>\\s+([^\\r\\n]+)",
            ],
            "revalidateSec": 3600,
            "maxItems": 1600,
          },
          "cadenceSec": 3600,
          "timeoutSec": 30,
        },
        "fx_stations": {
          "url": "https://opendata.dwd.de/climate_environment/CDC/observations_germany/climate/10_minutes/extreme_wind/now/zehn_now_fx_Beschreibung_Stationen.txt",
          "cadenceSec": 86400,
          "timeoutSec": 30,
        },
        "fx_listing": {
          "url": "https://opendata.dwd.de/climate_environment/CDC/observations_germany/climate/10_minutes/extreme_wind/now/",
          "cadenceSec": 3600,
          "timeoutSec": 30,
        },
        "fx": {
          "url": "{item}",
          "each": {
            "role": "fx_listing",
            "links": [
              "href=\"(10minutenwerte_extrema_wind_\\d{5}_now\\.zip)\"[^\\n]*?</a>\\s+([^\\r\\n]+)",
            ],
            "revalidateSec": 3600,
            "maxItems": 1600,
          },
          "cadenceSec": 3600,
          "timeoutSec": 30,
        },
      },
      "freshnessWindowSec": 3600,
      "acquisitionLimits": { "requests": 3000, "bytes": 16777216, "deadlineSec": 1200 },
      "requestLimits": {
        "perMinute": 240,
      },
      "license": "CC-BY-4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "terms": {
        "url": "https://opendata.dwd.de/climate_environment/CDC/Terms_of_use.pdf",
        "reviewedAt": "2026-11-07",
      },
      "attribution": "Quelle: Deutscher Wetterdienst; CC BY 4.0; station identifiers, units and observations normalized by OpenConditions.",
      "privacyUrl": "https://www.dwd.de/DE/service/datenschutz/datenschutz_node.html",
      "homepage": "https://opendata.dwd.de/climate_environment/CDC/",
    },
  ],
}
