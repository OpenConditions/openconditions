{
  "$schema": "../schema/charging.schema.json",
  "feeds": [
    {
      "operator": "afdc",
      "product": "charging",
      "name": "Alternative Fuel Stations, electric charging (AFDC)",
      "tier": "aggregator",
      "format": "afdc",
      // Every public electric station of the US and Canada, open or planned,
      // in one call. No live status; pricing is free text. 1,000 requests an
      // hour per key.
      "credentials": {
        "api_key": {
          "title": "NLR developer API key",
          "description": "A National Laboratory of the Rockies (formerly NREL) developer network key.",
          "setup": {
            "url": "https://developer.nlr.gov/signup/",
            "urlLabel": "Sign up for an NREL API key",
            "steps": [
              "Open developer.nlr.gov/signup/.",
              "Enter your first name, last name, and email, and accept the terms.",
              "Submit the form; the 40-character API key is generated instantly and emailed to you.",
            ],
            "cost": "Free, instant",
            "notes": "This NREL / api.data.gov key powers the AFDC Alternative Fuel Stations dataset. DEMO_KEY works for testing but has very low rate limits.",
          },
        },
      },
      "auth": { "kind": "header-key", "header": "X-Api-Key", "credential": "api_key" },
      "endpoints": {
        "main": {
          "url": "https://developer.nlr.gov/api/alt-fuel-stations/v1.json?fuel_type=ELEC&country=all&status=E,P&access=public&limit=all",
          "cadenceSec": 86400,
        },
      },
      "coverage": { "countries": ["US", "CA"] },
      "freshnessWindowSec": 172800,
      "license": "LicenseRef-NLR-Developer-Network-Terms",
      "licenseUrl": "https://developer.nlr.gov/terms/",
      "attribution": "U.S. DOE / NLR – Alternative Fuels Data Center (afdc.energy.gov/stations)",
      "homepage": "https://afdc.energy.gov/stations",
      "privacyUrl": "https://afdc.energy.gov/stations-privacy",
    },
  ],
}
