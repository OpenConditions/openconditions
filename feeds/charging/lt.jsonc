{
  "$schema": "../schema/charging.schema.json",
  "feeds": [
    {
      "operator": "vialietuva",
      "product": "charging",
      "name": "Via Lietuva charge points",
      "tier": "authoritative",
      "format": "ocpi",
      // OCPI 2.3.0 with each EVSE's live status inline. The server drops
      // unpublished locations from a page after cutting it, so a page comes
      // back shorter than its limit before the end and offset paging would
      // stop after the first; one request with a limit above the register's
      // size (about 3,300 locations, 2,000 published) returns them all. The
      // tariffs come unpaged. Cloudflare in front wants a User-Agent.
      "endpoints": {
        "main": {
          "url": "https://ev.vialietuva.lt/ocpi/2.3.0/locations?limit=10000",
          "headers": { "User-Agent": "OpenConditions/1.0" },
          "cadenceSec": 600,
        },
        "tariffs": {
          "url": "https://ev.vialietuva.lt/ocpi/2.3.0/tariffs",
          "headers": { "User-Agent": "OpenConditions/1.0" },
          "cadenceSec": 86400,
        },
      },
      "freshnessWindowSec": 3600,
      "license": "CC-BY-4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "attribution": "Via Lietuva, CC BY 4.0",
      "homepage": "https://ev.vialietuva.lt/en/data-provision",
      "privacyUrl": "https://vialietuva.lt/en/privacy-policy",
    },
  ],
}
