{
  "$schema": "../schema/cameras.schema.json",
  "feeds": [
    {
      "subdivision": "bc",
      "operator": "drivebc",
      "product": "cameras",
      "name": "DriveBC Ministry highway cameras",
      "rawRetention": "reference",
      "tier": "authoritative",
      "format": "csv",
      "endpoints": {
        "main": {
          "url": "https://catalogue.data.gov.bc.ca/dataset/6b39a910-6c77-476f-ac96-7b4f18849b1c/resource/a9d52d85-8402-4ce7-b2ac-a2779837c48a/download/webcams.csv",
          "cadenceSec": 86400,
        },
      },
      "freshnessWindowSec": 172800,
      "requestLimits": {
        "perDay": 2,
      },
      "coverage": {
        "countries": ["CA-BC"],
      },
      "license": "LicenseRef-OGL-BC",
      "licenseUrl": "https://pub.data.gov.bc.ca/license/OGL-vbc2.0.pdf",
      "attribution": "Contains information licensed under the Open Government Licence – British Columbia.",
      "homepage": "https://catalogue.data.gov.bc.ca/dataset/bc-highwaycams",
      "privacyUrl": "https://www2.gov.bc.ca/gov/content/home/privacy",
      // Monthly catalogue has no formal deletion contract. Missing groups remain last-good;
      // views of a present group are replaced by that group's current CSV rows.
      "snapshot": {
        "completeness": "partial",
        "qualification": "qualified",
        "minimumRecords": 1000,
        "csv": true,
      },
      "layout": {
        "lon": "longitude",
        "lat": "latitude",
      },
      "cameras": {
        "imageHosts": ["www.drivebc.ca/images/"],
        "groupBy": "cam_group",
        "viewKey": "id",
        "rejectConflictingViews": true,
        "name": "camName",
        "viewName": "camName",
        "description": "caption",
        "road": "highway_number",
        "lang": "en",
        "type": "traffic",
        "imageUrl": "links_imageURL",
        "detailUrl": "links_camDetailsPage",
        "credit": "credit",
        "direction": {
          "field": "orientation",
          "map": {
            "N": "N",
            "NE": "NE",
            "E": "E",
            "SE": "SE",
            "S": "S",
            "SW": "SW",
            "W": "W",
            "NW": "NW",
          },
        },
        "imageRedistribution": "allowed",
      },
      "terms": {
        "url": "https://github.com/bcgov/drivebc-webcam-api",
        "reviewedAt": "2026-11-07",
        "note": "OGL-BC v2 covers the Ministry-owned catalogue product; the Ministry explicitly releases webcam images and data for commercial use. Preserve row credits and actual future exceptions. Excludes website-only partner IDs, replay and archives. Image age and availability are unknown; inventory retrieval is not image capture. CKAN generic open/content flags conflict with the express grant.",
      },
    },
    {
      "subdivision": "on",
      "operator": "511",
      "product": "cameras",
      "name": "Ontario 511 cameras (Canada)",
      "tier": "authoritative",
      "format": "ibi511",
      // Every camera with its views in one call, behind the developer key the
      // Ontario 511 roads feeds share, ten calls a minute for the key.
      "auth": { "kind": "query-key", "param": "key", "credential": "@ca-on-511.api_key" },
      "endpoints": {
        "main": { "url": "https://511on.ca/api/v2/get/cameras?format=json", "cadenceSec": 3600 },
      },
      "snapshot": { "completeness": "complete", "recordsPath": "$" },
      "freshnessWindowSec": 7200,
      "requestLimits": { "perMinute": 10, "keyScope": "instance" },
      "coverage": { "countries": ["CA-ON"] },
      "license": "LicenseRef-OGL-ON",
      "licenseUrl": "https://www.ontario.ca/page/open-government-licence-ontario",
      "terms": {
        "url": "https://511on.ca/developers/resources",
        "reviewedAt": "2026-10-08",
        "note": "Developer's Access Agreement: the data is under the Open Government Licence – Ontario, but a key is granted case by case, and the request must name every third party that receives, redistributes or displays the data through the operator's service. The disclaimer travels with the data when it is distributed. An operator whose key does not cover public redistribution restricts the feed in its local catalogue layer.",
      },
      "attribution": "Contains information licensed under the Open Government Licence – Ontario",
      "homepage": "https://511on.ca/",
      "privacyUrl": "https://www.ontario.ca/page/privacy-statement",
      // No licence is published for the images themselves: they are neither
      // link-only nor free.
      "cameras": { "imageHosts": ["511on.ca"], "imageRedistribution": "unknown" },
    },
    {
      "subdivision": "qc",
      "operator": "mtmd",
      "product": "cameras",
      "name": "Québec MTMD camera inventory",
      "tier": "authoritative",
      "format": "quebec-cameras",
      "endpoints": {
        "main": {
          "url": "https://ws.mapserver.transports.gouv.qc.ca/swtq?service=wfs&version=2.0.0&request=getfeature&typename=ms:infos_cameras&outfile=Camera&srsname=EPSG:4326&outputformat=geojson",
          "cadenceSec": 86400,
        },
      },
      "snapshot": {
        "completeness": "complete",
        "recordsPath": "features",
        "totalCountPath": "numberMatched",
      },
      "freshnessWindowSec": 172800,
      "coverage": {
        "countries": ["CA-QC"],
      },
      "license": "CC-BY-4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "attribution": "Ministère des Transports et de la Mobilité durable — Caméra de circulation, Données Québec. Normalized data (modified). Dataset published 2023-01-13T19:37:25.323000; metadata updated 2026-11-08T13:20:07.995965; GeoJSON resource updated 2026-11-08T13:18:37.447818 (source dates, timezone unspecified); consulted 2026-11-09. https://www.donneesquebec.ca/recherche/dataset/camera-de-circulation",
      "homepage": "https://www.donneesquebec.ca/recherche/dataset/camera-de-circulation",
      "privacyUrl": "https://www.quebec.ca/politique-confidentialite",
      "terms": {
        "url": "https://www.donneesquebec.ca/licence/#cc-by",
        "reviewedAt": "2026-11-09",
        "note": "CC BY 4.0 covers exported inventory metadata and supplied external link values only. Linked Québec 511 player content and imagery are not licensed by this dataset. No imagery acquisition or redistribution. DateDebutDiffusion is publication-start metadata, not a frame clock. Dataset modification dates have unknown timezone. Inventory count agreement is not a permanent census or equipment availability guarantee.",
      },
      "cameras": {
        "imageRedistribution": "unknown",
      },
    },
  ],
}
