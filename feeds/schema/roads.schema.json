              "bcn-trams",
              "bonn",
              "datex2",
              "datex2-elaborated",
              "datex2-measured",
              "digitraffic",
              "digitraffic-traffic-measurement",
              "fdt",
              "fintraffic-tms",
              "flatjson",
              "gddkia",
              "geojson",
              "geojson-flow",
              "hk-td",
              "ibi511",
              "ibi511-conditions",
              "informo",
              "lta",
              "lta-speedbands",
              "miv",
              "nyc-dot",
              "ohgo",
              "ohgo-events",
              "open511",
              "trafikverket",
              "trafikverket-flow",
              "vic-disruptions",
              "webtris",
              "wzdx"
