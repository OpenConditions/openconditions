{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "github": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "github"
        ],
        "additionalProperties": false
      }
    },
    "feeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subdivision": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          },
          "operator": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          },
          "qualifier": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "product": {
            "type": "string",
            "pattern": "^[a-z0-9]+$",
            "enum": [
              "fuel"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "econtrol",
              "minetur",
              "overpass",
              "prix-carburants",
              "tankerkoenig"
            ]
          },
          "tier": {
            "type": "string",
            "enum": [
              "authoritative",
              "operator",
              "aggregator",
              "community"
            ]
          },
          "endpoints": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "urls": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reference": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "mobilithek"
                    },
                    "offerId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fileNamePrefix": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "offerId",
                    "fileNamePrefix"
                  ],
                  "additionalProperties": false
                },
                "expand": {
                  "type": "string",
                  "minLength": 1
                },
                "fanout": {
                  "type": "string",
                  "enum": [
                    "all",
                    "tolerant"
                  ]
                },
                "method": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "POST"
                  ]
                },
                "body": {
                  "type": "string"
                },
                "headers": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "pagination": {
                  "type": "object",
                  "properties": {
                    "skipParam": {
                      "type": "string"
                    },
                    "pageSize": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "recordsPath": {
                      "type": "string"
                    },
                    "maxPages": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "skipParam",
                    "pageSize"
                  ],
                  "additionalProperties": false
                },
                "gzip": {
                  "type": "boolean"
                },
                "decoder": {
                  "type": "string",
                  "minLength": 1,
                  "enum": []
                },
                "cadenceSec": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "cadenceSec"
              ],
              "additionalProperties": false
            }
          },
          "credentials": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "setup": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "urlLabel": {
                      "type": "string"
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "cost": {
                      "type": "string"
                    },
                    "notes": {
                      "type": "string"
                    },
                    "email": {
                      "type": "object",
                      "properties": {
                        "to": {
                          "type": "string"
                        },
                        "subject": {
                          "type": "string"
                        },
                        "body": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "to"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "optional": {
                  "type": "boolean"
                },
                "default": {
                  "type": "string"
                }
              },
              "required": [
                "title"
              ],
              "additionalProperties": false
            }
          },
          "auth": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "none"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "query-key"
                  },
                  "param": {
                    "type": "string"
                  },
                  "credential": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9]+(-[a-z0-9]+)*\\.)?[a-z][a-z0-9_]*$"
                  }
                },
                "required": [
                  "kind",
                  "param",
                  "credential"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "header-key"
                  },
                  "header": {
                    "type": "string"
                  },
                  "credential": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9]+(-[a-z0-9]+)*\\.)?[a-z][a-z0-9_]*$"
                  },
                  "valuePrefix": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "header",
                  "credential"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "basic"
                  },
                  "user": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9]+(-[a-z0-9]+)*\\.)?[a-z][a-z0-9_]*$"
                  },
                  "password": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9]+(-[a-z0-9]+)*\\.)?[a-z][a-z0-9_]*$"
                  }
                },
                "required": [
                  "kind",
                  "user",
                  "password"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "bearer"
                  },
                  "credential": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9]+(-[a-z0-9]+)*\\.)?[a-z][a-z0-9_]*$"
                  }
                },
                "required": [
                  "kind",
                  "credential"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "oauth2-client-credentials"
                  },
                  "tokenUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "clientId": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9]+(-[a-z0-9]+)*\\.)?[a-z][a-z0-9_]*$"
                  },
                  "clientSecret": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9]+(-[a-z0-9]+)*\\.)?[a-z][a-z0-9_]*$"
                  },
                  "scope": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "tokenUrl",
                  "clientId",
                  "clientSecret"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "mtls"
                  },
                  "cert": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9]+(-[a-z0-9]+)*\\.)?[a-z][a-z0-9_]*$"
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9]+(-[a-z0-9]+)*\\.)?[a-z][a-z0-9_]*$"
                  },
                  "ca": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9]+(-[a-z0-9]+)*\\.)?[a-z][a-z0-9_]*$"
                  }
                },
                "required": [
                  "kind",
                  "cert",
                  "key"
                ],
                "additionalProperties": false
              }
            ]
          },
          "catalog": {
            "type": "object",
            "properties": {
              "resolver": {
                "type": "string",
                "minLength": 1
              },
              "filter": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "approvedChildren": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "resolver"
            ],
            "additionalProperties": false
          },
          "snapshot": {
            "type": "object",
            "properties": {
              "completeness": {
                "type": "string",
                "const": "complete"
              },
              "recordsPath": {
                "type": "string",
                "minLength": 1
              },
              "rootElement": {
                "type": "string",
                "minLength": 1
              },
              "publicationElement": {
                "type": "string",
                "minLength": 1
              },
              "publicationType": {
                "type": "string",
                "minLength": 1
              },
              "recordElement": {
                "type": "string",
                "minLength": 1
              },
              "totalCountPath": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "completeness"
            ],
            "additionalProperties": false
          },
          "freshnessWindowSec": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "accessMode": {
            "type": "string",
            "enum": [
              "bulk",
              "on_demand"
            ]
          },
          "requestLimits": {
            "type": "object",
            "properties": {
              "perMinute": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "perDay": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "maxRadiusKm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "keyScope": {
                "type": "string",
                "enum": [
                  "instance",
                  "consumer"
                ]
              }
            },
            "additionalProperties": false
          },
          "onDemand": {
            "type": "object",
            "properties": {
              "cellDeg": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "ttlSec": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "maxCellsPerRead": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "probe": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "cellDeg",
              "ttlSec",
              "maxCellsPerRead",
              "probe"
            ],
            "additionalProperties": false
          },
          "extrasAllow": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "extrasFederate": {
            "type": "boolean"
          },
          "rawRetention": {
            "type": "string",
            "enum": [
              "situation",
              "observation",
              "reference"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "NOASSERTION",
              "CC0-1.0",
              "CC-BY-4.0",
              "CC-BY-SA-4.0",
              "LicenseRef-CC-BY-2.5-AR",
              "ODbL-1.0",
              "DL-DE-ZERO-2.0",
              "DL-DE-BY-2.0",
              "LicenseRef-GeoNutzV",
              "etalab-2.0",
              "NLOD-2.0",
              "OGL-UK-3.0",
              "LicenseRef-OGL-BC",
              "LicenseRef-OGL-ON",
              "LicenseRef-OD-HR",
              "LicenseRef-511NY-DAA",
              "LicenseRef-Singapore-ODL-1.0",
              "LicenseRef-HK-Gov-Open-Data",
              "LicenseRef-NYC-Open-Data",
              "LicenseRef-US-Gov-Public-Domain"
            ]
          },
          "licenseUrl": {
            "type": "string",
            "format": "uri"
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "terms": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "reviewedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  }
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "redistribution": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "derivedRedistribution": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "commercialUse": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "attributionRequired": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "retention": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "privacyUrl": {
            "type": "string",
            "format": "uri"
          },
          "homepage": {
            "type": "string",
            "format": "uri"
          },
          "coverage": {
            "type": "object",
            "properties": {
              "countries": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
                }
              },
              "bbox": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 4,
                "maxItems": 4
              }
            },
            "additionalProperties": false
          },
          "disabled": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "since": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": [
              "reason",
              "since"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "operator",
          "product",
          "name",
          "format",
          "tier",
          "endpoints",
          "freshnessWindowSec",
          "license",
          "attribution",
          "privacyUrl"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "feeds"
  ],
  "additionalProperties": false,
  "allowTrailingCommas": true
}
