      "terms": {
        "url": "https://data.gov.tw/dataset/128435",
        "reviewedAt": "2026-11-07",
        "note": "Dataset-specific OGDL 1.0 redistribution grant confirmed. Activation awaits independent geometry/time and snapshot withdrawal qualification. Heavy motorcycles retained in raw XML only; five canonical categories, reserved counts overlap vehicle totals. Cadences are operator choices, not a publisher SLA or quota.",
      },
