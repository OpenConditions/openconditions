{
  "$schema": "../schema/parking.schema.json",
  "feeds": [
    {
      "subdivision": "nsw",
      "operator": "tfnsw",
      "product": "parking",
      "name": "Transport for NSW Park&Ride",
      "tier": "authoritative",
      "format": "tfnsw",
      "auth": {
        "kind": "header-key",
        "header": "Authorization",
        "credential": "@au-nsw-tfnsw.api_key",
        "valuePrefix": "apikey ",
      },
      // Every car park with its occupancy in one call.
      "endpoints": {
        "main": {
          "url": "https://api.transport.nsw.gov.au/v1/carpark/full-list",
          "cadenceSec": 300,
        },
      },
      "freshnessWindowSec": 3600,
      "requestLimits": { "perDay": 60000 },
      "license": "CC-BY-4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "attribution": "Transport for NSW, CC BY 4.0",
      "homepage": "https://opendata.transport.nsw.gov.au/",
      "privacyUrl": "https://opendata.transport.nsw.gov.au/sites/default/files/2024-09/TfNSW-Privacy.pdf",
      "terms": {
        "url": "https://opendata.transport.nsw.gov.au/datalicence",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: CC BY 4.0. \"Unless otherwise stated, the data on the Open Data Hub is made available under the Open Data Policy and is licensed under a Creative Commons Attribution 4.0 License.\"",
      },
    },
  ],
}
