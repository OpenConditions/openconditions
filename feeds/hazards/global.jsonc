{
  "$schema": "../schema/hazards.schema.json",
  "feeds": [
    {
      "operator": "nasa",
      "qualifier": "firms-viirs",
      "product": "fires",
      "name": "NASA FIRMS VIIRS active fires",
      "tier": "authoritative",
      "format": "firms",
      // The keyless global 24-hour files of the NOAA-21 and NOAA-20 VIIRS
      // instruments (Suomi NPP ends on 2026-11-02). Each detection is one
      // fire radiative power reading at its pixel, gone 72 hours after the
      // satellite saw it.
      "endpoints": {
        "main": {
          "urls": [
            "https://firms.modaps.eosdis.nasa.gov/data/active_fire/noaa-21-viirs-c2/csv/J2_VIIRS_C2_Global_24h.csv",
            "https://firms.modaps.eosdis.nasa.gov/data/active_fire/noaa-20-viirs-c2/csv/J1_VIIRS_C2_Global_24h.csv",
          ],
          "fanout": "tolerant",
          "cadenceSec": 3600,
        },
      },
      "freshnessWindowSec": 10800,
      "extrasAllow": [
        "instrument",
        "satellite",
        "brightnessK",
        "backgroundK",
        "daynight",
        "scan",
        "track",
        "version",
      ],
      "coverage": { "bbox": [-180, -90, 180, 90] },
      "license": "CC0-1.0",
      "licenseUrl": "https://www.earthdata.nasa.gov/engage/open-data-services-software-policies/data-use-guidance",
      "attribution": "NASA FIRMS (LANCE / ESDIS)",
      "homepage": "https://www.earthdata.nasa.gov/data/tools/firms",
      "privacyUrl": "https://www.nasa.gov/privacy/",
    },
    {
      "operator": "nasa",
      "qualifier": "firms-modis",
      "product": "fires",
      "name": "NASA FIRMS MODIS active fires",
      "tier": "authoritative",
      "format": "firms",
      // The keyless global 24-hour file of the MODIS instruments (Terra and Aqua).
      "endpoints": {
        "main": {
          "url": "https://firms.modaps.eosdis.nasa.gov/data/active_fire/modis-c6.1/csv/MODIS_C6_1_Global_24h.csv",
          "cadenceSec": 3600,
        },
      },
      "freshnessWindowSec": 10800,
      "extrasAllow": [
        "instrument",
        "satellite",
        "brightnessK",
        "backgroundK",
        "daynight",
        "scan",
        "track",
        "version",
      ],
      "coverage": { "bbox": [-180, -90, 180, 90] },
      "license": "CC0-1.0",
      "licenseUrl": "https://www.earthdata.nasa.gov/engage/open-data-services-software-policies/data-use-guidance",
      "attribution": "NASA FIRMS (LANCE / ESDIS)",
      "homepage": "https://www.earthdata.nasa.gov/data/tools/firms",
      "privacyUrl": "https://www.nasa.gov/privacy/",
    },
    {
      "operator": "usgs",
      "product": "quakes",
      "name": "USGS earthquakes",
      "tier": "authoritative",
      "format": "usgs",
      // The last day, fresh, and the last month, which carries revisions and
      // whose absence of an event within its window is a deletion. An
      // earthquake is over in seconds: it is read by time window.
      "endpoints": {
        "recent": {
          "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson",
          "cadenceSec": 120,
        },
        "window": {
          "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_month.geojson",
          "cadenceSec": 900,
        },
      },
      "snapshot": { "completeness": "complete" },
      "freshnessWindowSec": 600,
      "coverage": { "bbox": [-180, -90, 180, 90] },
      "license": "LicenseRef-US-Gov-Public-Domain",
      "licenseUrl": "https://www.usgs.gov/information-policies-and-instructions/copyrights-and-credits",
      "attribution": "U.S. Geological Survey",
      "privacyUrl": "https://www.doi.gov/privacy",
    },
    {
      "operator": "nasa",
      "qualifier": "eonet",
      "product": "events",
      "name": "NASA EONET natural events",
      "tier": "authoritative",
      "format": "eonet",
      // Volcanoes, sea and lake ice, floods, landslides, dust and haze, and
      // drought. Wildfires, earthquakes and storms, and every event EONET
      // takes from GDACS, are left to the sources that report them first-hand.
      "endpoints": {
        "open": {
          "url": "https://eonet.gsfc.nasa.gov/api/v3/events?status=open&category=volcanoes,seaLakeIce,floods,landslides,dustHaze,drought",
          "cadenceSec": 900,
        },
        "closed": {
          "url": "https://eonet.gsfc.nasa.gov/api/v3/events?status=closed&days=30&category=volcanoes,seaLakeIce,floods,landslides,dustHaze,drought",
          "cadenceSec": 3600,
        },
      },
      "snapshot": { "completeness": "complete" },
      "freshnessWindowSec": 3600,
      "coverage": { "bbox": [-180, -90, 180, 90] },
      "license": "CC0-1.0",
      "licenseUrl": "https://www.earthdata.nasa.gov/engage/open-data-services-software-policies/data-use-guidance",
      "terms": {
        "url": "https://eonet.gsfc.nasa.gov/what-is-eonet",
        "reviewedAt": "2026-10-08",
        "note": "Metadata for visualisation and general information, not official extents.",
      },
      "attribution": "NASA Earth Observatory Natural Event Tracker (EONET)",
      "privacyUrl": "https://www.nasa.gov/privacy/",
    },
    {
      "operator": "gdacs",
      "product": "events",
      "name": "GDACS disaster alerts",
      "tier": "authoritative",
      "format": "gdacs",
      // Tropical cyclones, floods, volcanoes and droughts with their alert
      // level, drawn by the CAP areas of their current episode; earthquakes
      // and wildfires are taken from USGS, NIFC, EFFIS and FIRMS.
      "endpoints": {
        "events": { "url": "https://www.gdacs.org/xml/rss.xml", "cadenceSec": 600 },
        "areas": { "url": "https://www.gdacs.org/xml/gdacs_cap.xml", "cadenceSec": 1800 },
      },
      "snapshot": { "completeness": "complete" },
      "freshnessWindowSec": 1800,
      "coverage": { "bbox": [-180, -90, 180, 90] },
      "license": "CC-BY-4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "terms": {
        "url": "https://www.gdacs.org/About/termofuse.aspx",
        "reviewedAt": "2026-10-08",
        "note": "Licence stated in the RSS and CAP feeds; GDACS alerts are automatic model estimates, not official warnings.",
      },
      // OC reshapes the events (CAP areas joined, subtypes derived, severities
      // mapped), and CC BY 4.0 asks that changes be indicated.
      "attribution": "GDACS, European Union (CC BY 4.0), modified",
      "homepage": "https://www.gdacs.org/",
      "privacyUrl": "https://commission.europa.eu/privacy-policy-websites-managed-european-commission_en",
    },
  ],
}
