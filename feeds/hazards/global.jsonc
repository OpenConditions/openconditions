{
  "$schema": "../schema/hazards.schema.json",
  "feeds": [
    {
      "operator": "nasa",
      "qualifier": "firms-viirs",
      "product": "fires",
      "name": "NASA FIRMS VIIRS active fires",
      "tier": "authoritative",
      "format": "firms",
      // The keyless global 24-hour files of the NOAA-21 and NOAA-20 VIIRS
      // instruments (Suomi NPP ends on 2026-11-02). Each detection is one
      // fire radiative power reading at its pixel, gone 72 hours after the
      // satellite saw it.
      "endpoints": {
        "main": {
          "urls": [
            "https://firms.modaps.eosdis.nasa.gov/data/active_fire/noaa-21-viirs-c2/csv/J2_VIIRS_C2_Global_24h.csv",
            "https://firms.modaps.eosdis.nasa.gov/data/active_fire/noaa-20-viirs-c2/csv/J1_VIIRS_C2_Global_24h.csv",
          ],
          "fanout": "tolerant",
          "cadenceSec": 3600,
        },
      },
      "freshnessWindowSec": 10800,
      "extrasAllow": [
        "instrument",
        "satellite",
        "brightnessK",
        "backgroundK",
        "daynight",
        "scan",
        "track",
        "version",
      ],
      "coverage": { "bbox": [-180, -90, 180, 90] },
      "license": "CC0-1.0",
      "licenseUrl": "https://www.earthdata.nasa.gov/engage/open-data-services-software-policies/data-use-guidance",
      "attribution": "NASA FIRMS (LANCE / ESDIS)",
      "homepage": "https://www.earthdata.nasa.gov/data/tools/firms",
      "privacyUrl": "https://www.nasa.gov/privacy/",
      "terms": {
        "url": "https://cmr.earthdata.nasa.gov/search/concepts/C3264430167-LANCEMODIS.umm_json",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: No use constraints, free and open data (NASA CMR); ESDIS default CC0. \"\"UseConstraints\": {\"Description\": \"None. See disclaimer: https://earthdata.nasa.gov/data/near-real-time-data/about-lance/disclaimer\", \"FreeAndOpenData\": true}\"",
      },
    },
    {
      "operator": "nasa",
      "qualifier": "firms-modis",
      "product": "fires",
      "name": "NASA FIRMS MODIS active fires",
      "tier": "authoritative",
      "format": "firms",
      // The keyless global 24-hour file of the MODIS instruments (Terra and Aqua).
      "endpoints": {
        "main": {
          "url": "https://firms.modaps.eosdis.nasa.gov/data/active_fire/modis-c6.1/csv/MODIS_C6_1_Global_24h.csv",
          "cadenceSec": 3600,
        },
      },
      "freshnessWindowSec": 10800,
      "extrasAllow": [
        "instrument",
        "satellite",
        "brightnessK",
        "backgroundK",
        "daynight",
        "scan",
        "track",
        "version",
      ],
      "coverage": { "bbox": [-180, -90, 180, 90] },
      "license": "CC0-1.0",
      "licenseUrl": "https://www.earthdata.nasa.gov/engage/open-data-services-software-policies/data-use-guidance",
      "attribution": "NASA FIRMS (LANCE / ESDIS)",
      "homepage": "https://www.earthdata.nasa.gov/data/tools/firms",
      "privacyUrl": "https://www.nasa.gov/privacy/",
      "terms": {
        "url": "https://www.earthdata.nasa.gov/engage/open-data-services-software-policies/data-use-guidance",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: CC0 (ESDIS default for unmarked NASA-led mission data). \"Unless the content is marked with a use restriction or license, data provided from a NASA-led mission are licensed as Creative Commons Zero (CC0). While there are no restrictions on the use of these data, data users are very strongly urged…\"",
      },
    },
    {
      "operator": "eumetsat",
      "qualifier": "slstr",
      "product": "fires",
      "name": "EUMETSAT Sentinel-3 SLSTR active fires",
      "tier": "authoritative",
      "format": "slstr-frp",
      // The Data Store serves Copernicus products to an account that holds
      // the Copernicus licence, through the account's OAuth2 login (see
      // @eumetsat in credentials.jsonc); its API keys are refused.
      "auth": {
        "kind": "oauth2-authorization-code",
        "authorizeUrl": "https://user.eumetsat.int/cas/oidc/oidcAuthorize",
        "tokenUrl": "https://user.eumetsat.int/cas/oauth2.0/accessToken",
        "redirectUri": "https://api.eumetsat.int/cli",
        "clientId": "@eumetsat.client_id",
        "scope": "openid profile email",
        "responseMode": "fragment",
        "refreshTokenTtlSec": 2592000,
      },
      // The near-real-time Sentinel-3A and -3B granules (three minutes of the
      // swath each) in which the processor detected a fire, newest first:
      // 100 are about ten hours, and a granule is published one to three
      // hours after the satellite saw it. Each granule's fire list is fetched
      // once and kept while the listing names it; a pixel stays 72 hours,
      // like a FIRMS one. The satellites cross the equator at 10:00 and 22:00
      // local time, the hours VIIRS's 13:30 and 01:30 orbits leave open.
      "endpoints": {
        "granules": {
          "url": "https://api.eumetsat.int/data/search-products/2.0.0/os?pi=EO:EUM:DAT:0417&timeliness=NR&fire=true&set=brief&c=100&format=json",
          "cadenceSec": 900,
        },
        "fires": {
          "url": "https://api.eumetsat.int/data/download/2.0.0/collections/EO%3AEUM%3ADAT%3A0417/products/{item}/entry?name={item}%2FFRP_MWIR1km_standard.csv",
          // A granule that fails costs only its fires: the next poll asks again.
          "fanout": "tolerant",
          "cadenceSec": 900,
          "each": {
            "role": "granules",
            "records": "features",
            "field": "id",
            "pattern": "^(S3[AB]_SL_2_FRP_{4}\\w+_NR_\\d{3}\\.SEN3)$",
            "keepSec": 259200,
          },
        },
      },
      "freshnessWindowSec": 10800,
      // The Data Store allows 40 requests a second; the first poll after a
      // start fetches every listed granule.
      "requestLimits": { "perMinute": 120 },
      "extrasAllow": [
        "instrument",
        "satellite",
        "brightnessK",
        "daynight",
        "scan",
        "track",
        "channel",
        "version",
      ],
      "coverage": { "bbox": [-180, -90, 180, 90] },
      "license": "LicenseRef-Copernicus-Sentinel-Data",
      "licenseUrl": "https://sentinels.copernicus.eu/documents/247904/690755/Sentinel_Data_Legal_Notice",
      "terms": {
        "url": "https://sentinels.copernicus.eu/documents/247904/690755/Sentinel_Data_Legal_Notice",
        "reviewedAt": "2026-10-16",
        "note": "Free, full and open use under Regulation (EU) No 1159/2013.",
      },
      // The notice asks modified data to be credited "Contains modified
      // Copernicus Sentinel data [Year]": each pixel carries the UTC year of
      // its detection, /sources the current year. EUMETSAT's own Meteosat
      // terms do not apply to Sentinel data.
      "attribution": "Contains modified Copernicus Sentinel data {year}, processed by EUMETSAT",
      "homepage": "https://data.eumetsat.int/product/EO:EUM:DAT:0417",
      "privacyUrl": "https://www.eumetsat.int/privacy-policy",
    },
    {
      "operator": "usgs",
      "product": "quakes",
      "name": "USGS earthquakes",
      "tier": "authoritative",
      "format": "usgs",
      // The last day, fresh, and the last month, which carries revisions and
      // whose absence of an event within its window is a deletion. An
      // earthquake is over in seconds: it is read by time window.
      "endpoints": {
        "recent": {
          "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson",
          "cadenceSec": 120,
        },
        "window": {
          "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_month.geojson",
          "cadenceSec": 900,
        },
      },
      "snapshot": { "completeness": "complete" },
      "freshnessWindowSec": 600,
      "coverage": { "bbox": [-180, -90, 180, 90] },
      "license": "LicenseRef-US-Gov-Public-Domain",
      "licenseUrl": "https://www.usgs.gov/information-policies-and-instructions/copyrights-and-credits",
      "attribution": "U.S. Geological Survey",
      "privacyUrl": "https://www.doi.gov/privacy",
      "terms": {
        "url": "https://www.usgs.gov/information-policies-and-instructions/copyrights-and-credits",
        "reviewedAt": "2026-10-29",
        "note": "Licence review 2026-10-29: U.S. Public Domain. \"USGS-authored or produced data and information are considered to be in the U.S. Public Domain.\"",
      },
    },
    {
      "operator": "nasa",
      "qualifier": "eonet",
      "product": "events",
      "name": "NASA EONET natural events",
      "tier": "authoritative",
      "format": "eonet",
      // Volcanoes, sea and lake ice, floods, landslides, dust and haze, and
      // drought. Wildfires, earthquakes and storms, and every event EONET
      // takes from GDACS, are left to the sources that report them first-hand.
      "endpoints": {
        "open": {
          "url": "https://eonet.gsfc.nasa.gov/api/v3/events?status=open&category=volcanoes,seaLakeIce,floods,landslides,dustHaze,drought",
          "cadenceSec": 900,
        },
        "closed": {
          "url": "https://eonet.gsfc.nasa.gov/api/v3/events?status=closed&days=30&category=volcanoes,seaLakeIce,floods,landslides,dustHaze,drought",
          "cadenceSec": 3600,
        },
      },
      "snapshot": { "completeness": "complete" },
      "freshnessWindowSec": 3600,
      "coverage": { "bbox": [-180, -90, 180, 90] },
      "license": "CC0-1.0",
      "licenseUrl": "https://www.earthdata.nasa.gov/engage/open-data-services-software-policies/data-use-guidance",
      "terms": {
        "url": "https://eonet.gsfc.nasa.gov/what-is-eonet",
        "reviewedAt": "2026-10-08",
        "note": "Metadata for visualisation and general information, not official extents.",
      },
      "attribution": "NASA Earth Observatory Natural Event Tracker (EONET)",
      "privacyUrl": "https://www.nasa.gov/privacy/",
    },
    {
      "operator": "gdacs",
      "product": "events",
      "name": "GDACS disaster alerts",
      "tier": "authoritative",
      "format": "gdacs",
      // Tropical cyclones, floods, volcanoes and droughts with their alert
      // level, drawn by the CAP areas of their current episode; earthquakes
      // and wildfires are taken from USGS, NIFC, EFFIS and FIRMS.
      "endpoints": {
        "events": { "url": "https://www.gdacs.org/xml/rss.xml", "cadenceSec": 600 },
        "areas": { "url": "https://www.gdacs.org/xml/gdacs_cap.xml", "cadenceSec": 1800 },
      },
      "snapshot": { "completeness": "complete" },
      "freshnessWindowSec": 1800,
      "coverage": { "bbox": [-180, -90, 180, 90] },
      "license": "CC-BY-4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "terms": {
        "url": "https://www.gdacs.org/About/termofuse.aspx",
        "reviewedAt": "2026-10-08",
        "note": "Licence stated in the RSS and CAP feeds; GDACS alerts are automatic model estimates, not official warnings.",
      },
      // OC reshapes the events (CAP areas joined, subtypes derived, severities
      // mapped), and CC BY 4.0 asks that changes be indicated.
      "attribution": "GDACS, European Union (CC BY 4.0), modified",
      "homepage": "https://www.gdacs.org/",
      "privacyUrl": "https://commission.europa.eu/privacy-policy-websites-managed-european-commission_en",
    },
  ],
}
