{
  "name": "openconditions",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck && tsc -p scripts/tsconfig.json",
    "check:staged": "node scripts/check-staged.mjs",
    "verify:full": "pnpm lint && pnpm typecheck && pnpm check-credentials && pnpm check:feed-schemas && pnpm feeds:lint && pnpm test && pnpm check:packed-packages",
    "lint": "biome check . && prettier --check \"**/*.{md,yml,yaml}\" && pnpm check-import-boundaries",
    "format": "biome format --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "check-import-boundaries": "tsx scripts/check-import-boundaries.ts",
    "test": "pnpm build && vitest run",
    "test:watch": "pnpm build && vitest",
    "test:coverage": "pnpm build && vitest run --coverage",
    "build:domains": "turbo run build --filter=@openconditions/datex2... --filter=@openconditions/ocpi... --filter=@openconditions/roads... --filter=@openconditions/fuel... --filter=@openconditions/parking... --filter=@openconditions/charging... --filter=@openconditions/cameras... --filter=@openconditions/hazards... --filter=@openconditions/weather... --filter=@openconditions/vehicles... --filter=@openconditions/border... --output-logs=errors-only",
    "gen:credentials": "pnpm build:domains && tsx scripts/gen-credentials.ts --write",
    "check-credentials": "pnpm build:domains && tsx scripts/gen-credentials.ts",
    "gen:feed-schemas": "pnpm build:domains && tsx scripts/gen-feed-schemas.ts --write",
    "check:feed-schemas": "pnpm build:domains && tsx scripts/gen-feed-schemas.ts",
    "feeds:lint": "pnpm build:domains && tsx scripts/feeds-lint.ts",
    "feeds:check": "pnpm build:domains && tsx scripts/feeds-check.ts",
    "export:atlas": "pnpm build:domains && tsx scripts/export-atlas.ts",
    "audit:production": "tsx scripts/check-production-audits.ts",
    "gen:model": "pnpm --filter @openconditions/model-registry... build && tsx scripts/gen-model-artifacts.ts --write",
    "check:model": "pnpm --filter @openconditions/model-registry... build && tsx scripts/gen-model-artifacts.ts",
    "road-conditions:readiness": "pnpm --filter @openconditions/ingest exec tsx src/ops/road-conditions-readiness.ts",
    "prepare": "husky",
    "test:unit": "pnpm build && vitest run --project unit",
    "test:integration": "pnpm build && vitest run --project integration",
    "check:ci": "vitest run --project unit scripts/__tests__/ci-results.test.ts scripts/__tests__/main-validation-reconcile.test.ts",
    "check:packed-packages": "node scripts/check-packed-packages.mjs",
    "check:release-information": "node scripts/check-release-information.ts",
    "version:public-packages": "node scripts/version-public-packages.mjs",
    "check:canonical-package-version": "node scripts/canonical-package-version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@openconditions/core": "workspace:*",
    "@openconditions/datex2": "workspace:*",
    "@openconditions/ingest-framework": "workspace:*",
    "@openconditions/model": "workspace:*",
    "@openconditions/model-registry": "workspace:*",
    "@openconditions/roads": "workspace:*",
    "@openconditions/test-database": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "husky": "^9.1.7",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  }
}
